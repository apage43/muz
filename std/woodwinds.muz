// Woodwinds: flute, oboe, clarinet, bass clarinet and bassoon as waveguide models
// (std/physical), each calibrated across its range and voiced against recorded
// instruments, with one player and one set of playing rules for all of them.
//
//   use "std/woodwinds" as w;
//   let line = w.play(phrase("D4:q F4:e@slur A4:e@slur G4:h@niente"), w.specs.clarinet, {timing: {tempo: 72}});
//   song({tempo: 72, tracks: [track("cl", line, w.clarinet())]})
//
// An instrument is a spec record: its model, range, voicing, calibration and
// playing style. `patch(spec)` builds its voice patch and `instrument(spec)` a
// monophonic, slurring instrument from it; `flute()`, `oboe()`, `clarinet()`,
// `bass_clarinet()` and `bassoon()` are the five std ones. Another instrument is
// a spec derived from one of these (`derive`), recalibrated with
// tools/woodwinds.py: see docs/synthesis.md "Woodwinds".
//
// `play` is the player (see "The player" at the end): it plans breaths and
// phrases over the whole line and plays each note with that context.
// `perform` is the note rules alone.
use "std/signal" as s;
use "std/instrument" as i;
use "std/physical" as ph;
use "std/woodwind_calibration" as cal;
use "std/arrange" as arr;
use "std/checks" as checks;

fn curve(input, points) = s.shape(input, points, "raw");
fn clamp01(x) = s.mapping(x, "clamp", 0, 1);
fn sub(a, b) = s.add([a, s.mul([b, -1])]);

// --- How hard a note is blown ------------------------------------------------------
//
// A note's dynamic `d` (0..1: 0 no breath, about 0.1 air without tone, 0.2 ppp,
// 0.5 mf, 1 ff) becomes a mouth pressure through the instrument's measured
// speaking threshold `thr` (calibration, against log2 of the frequency) and
// `dynamics`, a curve from d to e: -1 no breath, 0 the threshold, 1
// `gamma_max` (just short of the pressure that holds the reed shut). Just above
// the threshold the tone is nearly a sine and grows as the square root of e, as
// a real reed's does; by e = 0.3 the reed beats.
//   gamma = thr * a(e) + b(e),  a = 1 + min(e, 0) - max(e, 0),  b = gamma_max * max(e, 0)
let reed_dynamics = [[0, -1], [0.05, -0.5], [0.1, -0.12], [0.14, 0], [0.2, 0.05], [0.3, 0.085], [0.4, 0.125],
    [0.5, 0.17], [0.6, 0.26], [0.7, 0.4], [0.85, 0.68], [1, 1]];
fn dynamics_a(points) = map(points, fn(p) => [p[0], 1 + min(p[1], 0) - max(p[1], 0)]);
fn dynamics_b(points, top) = map(points, fn(p) => [p[0], top * max(p[1], 0)]);
// The flute's dynamic -> blowing pressure (the jet speaks from about 0.5).
let flute_dynamics = [[0, 0], [0.08, 0.3], [0.14, 0.5], [0.2, 0.62], [0.5, 0.92], [0.75, 1.1], [1, 1.28]];

// The tuned period: 1/f corrected by the calibration (cents against log2 f), the
// player's drift and vibrato, and, where the model's pitch moves with the
// dynamic, `cents_per_dynamic` (cents per unit of dynamic from mf) or
// `dynamic_cents` ([[dynamic, cents]], 0 at mf; replaces it).
fn tuned_frequency(o, f, lf, d, wander) {
    let table = s.add([curve(lf, o.calibration.cents), wander]);
    let cents = if o.dynamic_cents != null { s.add([table, curve(d, o.dynamic_cents)]) } else {
        if o.cents_per_dynamic == 0 { table } else { s.add([table, s.mul([sub(d, 0.5), o.cents_per_dynamic])]) }
    };
    s.mul([f, s.mapping(s.mul([cents, -1 / 1200]), "exp2")])
}
fn player_of(o) = ph.wind_player({
    attack: o.attack, release: o.release, tongue_gain: o.tongue_gain, burst: o.burst, finger: o.finger,
    drift_cents: o.drift_cents, flutter_hz: o.flutter_hz, vibrato_hz: o.vibrato_hz,
    vibrato_breath: o.vibrato_breath, vibrato_cents: o.vibrato_cents,
    noise: {cutoff: o.noise_hz, brighten: o.noise_brighten, follow: o.noise_follow, slope: o.noise_slope},
    noise_dynamic: o.noise_dynamic, velocity_breath: o.velocity_breath
});
// A beating reed's level hardly follows its breath; `level_db` is the rest of a
// dynamic, from d = 0 to d = 1 around mf.
fn level_of(o, d) = s.mapping(s.mul([sub(d, 0.5), o.level_db / 6.0206]), "exp2");

// --- Reeds ------------------------------------------------------------------------------

let reed_defaults = {
    velocity_breath: 1, // 0: the dynamic is the `pressure` curve alone, velocity ignored
    family: "reed",
    kind: "cylinder", // or "cone"
    tight: 0.32, // the reed's opening at a tight embouchure ...
    loose: 0.55, // ... and a loose one (see std/physical.bernoulli)
    embouchure_dynamic: 0.5, // how far the dynamic loosens the embouchure
    loss: 0.96, // reflection at the open end, low frequencies
    lattice_hz: 1800, // above this the tone holes radiate instead of reflecting
    track: 2.2, // ... but never less than this many times the note
    track_curve: null, // or `track` against log2(Hz), where fingerings change the tube's top
    lattice_dynamic: null, // [[d, factor]]: the dynamic opens the lattice
    apex: 0.27, // cone: the reed's place along the tube
    apex_loss: 0.985,
    staple_recovery: 0, // optional double-reed staple pressure recovery
    register_blend: false, // maintain alternate register loops through a transition
    clarion: 0, // cylinder: the MIDI pitch from which the register vent is open (0: none)
    octave_key: 0, // cone: the MIDI pitch from which the octave vent is open (0: none)
    key_top: 0, // the MIDI pitch from which the vent closes again (0: never)
    vent_depth: 0.5,
    leak: 0.1, // mouthpiece pressure in the output (the body, the open holes)
    noise: 0.06, // turbulence riding on the reed's flow
    noise_hz: 3000, // ... its corner at mf (std/physical.turbulence)
    noise_brighten: 0, // close and dry: a few dB under the recordings above 4 kHz
    noise_follow: 0.25,
    noise_slope: 1, // (`far` puts back the recordings' brighter air, room included)
    noise_dynamic: 1.5,
    hiss: 0.0008, // air through the reed that never becomes tone
    tongue_gain: 0.6,
    burst: 50ms,
    finger: 0.1, // turbulence added at each change of note
    drift_cents: 2.5, // how far the pitch wanders
    flutter_hz: 24Hz,
    vibrato_hz: 5Hz, // at full `vibrato` depth: ...
    vibrato_breath: 0, // ... the breath pulse ...
    vibrato_cents: 0, // ... and the pitch swing, peak
    attack: 1ms, // the breath's own rise at a fresh note
    release: 70ms,
    cents_per_dynamic: 0,
    dynamic_cents: null,
    formants: [], // [[hz, q, gain]] after the bore (std/physical.body)
    gain_db: 0,
    level_db: 2,
    dynamics: reed_dynamics,
    gamma_max: 0.85,
    max_seconds: 40ms,
    body_eq: null, // [[hz, dB], ...]: a body response for `body` (a track chain)
    oversample: 2,
    raw: false // calibration: the dynamic is the mouth pressure itself
};

fn reed(o) {
    let pl = player_of(o);
    let f = s.frequency();
    let lf = s.mapping(f, "log2");
    let d = pl.dynamic;
    let gamma = if o.raw { s.mul([pl.envelope, d]) } else {
        s.mul([pl.envelope, s.add([
            s.mul([curve(lf, o.calibration.thr), curve(d, dynamics_a(o.dynamics))]),
            curve(d, dynamics_b(o.dynamics, o.gamma_max))
        ])])
    };
    let sounding = tuned_frequency(o, f, lf, d, pl.cents);
    let floor = if o.lattice_dynamic == null { o.lattice_hz * 1Hz } else { s.mul([curve(d, o.lattice_dynamic), o.lattice_hz * 1Hz]) };
    let end = ph.open_end(f, floor, if o.track_curve == null { o.track } else { curve(lf, o.track_curve) });
    let embouchure = clamp01(s.add([s.mul([d, o.embouchure_dynamic]), s.expression("brightness"), -0.5]));
    let turbulence = s.add([1, s.mul([pl.noise, s.add([o.noise, pl.fingers])])]);
    let common = {
        tone: end.cutoff, loss: o.loss, embouchure: embouchure, tight: o.tight, loose: o.loose,
        turbulence: turbulence, vent_depth: o.vent_depth, sounding: sounding, max_seconds: o.max_seconds
    };
    // From `clarion` up a clarinet's note is fingered a twelfth lower with the
    // register vent open (the clarion is the long tube's third mode), and from
    // `octave_key` up an oboe's an octave lower with its octave vent open. A
    // note's `vent` control opens the vent on its own fingering: a slur up a
    // register on one fingering.
    let cylinder = o.kind == "cylinder";
    let key = if cylinder { o.clarion } else { o.octave_key };
    // `key_top`: from here up the note is fingered on its own short tube again
    // (an oboe's top notes use no octave key); 0 keeps the vent open to the top.
    // On a descending clarinet slur, a slow closing vent shortens the bore
    // while the old third mode is still ringing. Seat the key quickly to
    // avoid sweeping that mode up into a chirp before the fundamental speaks.
    let vent_close = if cylinder { 0.4ms } else { 4ms };
    let register_state = if key > 0 {
        s.slew(if o.key_top > 0 { sub(ph.register(key), ph.register(o.key_top)) } else { ph.register(key) }, 4ms, vent_close)
    } else { 0 };
    // Round off the start of the closing motion so the delay tap does not
    // jump into a fast sweep. Leave opening and the oboe vent as before.
    let upper = if cylinder && key > 0 { s.slew(register_state, 0ms, vent_close) } else { register_state };
    let ratio = if cylinder { 2 } else { 1 };
    let fingered = if key > 0 { s.mul([sounding, s.mapping(s.add([1, s.mul([upper, ratio])]), "reciprocal")]) } else { sounding };
    let vent = ph.vent_control(upper);
    let bore = if cylinder && o.register_blend && key > 0 {
        // The two loops keep independent pressure histories. Only their
        // outputs blend; neither delay jumps to a different register.
        let low = ph.cylinder(gamma, sounding, merge(common, {vent: ph.vent_control(0)}));
        let high = ph.cylinder(gamma, s.mul([sounding, 1 / 3]), merge(common, {vent: ph.vent_control(1)}));
        let blend = s.slew(ph.register(key), 4ms, 4ms);
        fn mix(a, b) = s.add([s.mul([a, sub(1, blend)]), s.mul([b, blend])]);
        {inside: mix(low.inside, high.inside), radiated: mix(low.radiated, high.radiated),
         flow: mix(low.flow, high.flow), feedback: low.feedback + high.feedback}
    } else { if cylinder {
        ph.cylinder(gamma, fingered, merge(common, {vent: vent}))
    } else {
        ph.cone(gamma, fingered, merge(common, {apex: o.apex, apex_loss: o.apex_loss, staple_recovery: o.staple_recovery,
                                                   vent: if key > 0 { vent } else { 0 }}))
    } };
    // Air through the reed channel that never becomes tone.
    let air = s.lowpass1(s.mul([pl.noise, gamma, o.hiss]), 4500Hz);
    let raw = s.add([bore.radiated, s.mul([bore.inside, o.leak]), air]);
    let voiced = if len(o.formants) == 0 { raw } else { ph.body(raw, o.formants) };
    voice_patch(o.name, {
        note_controls: merge(pl.controls, {vent: 0}),
        velocity_track: 0,
        oversample: o.oversample,
        gain_db: o.gain_db,
        output: s.mul([voiced, level_of(o, d)]),
        feedback: bore.feedback,
        probes: {inside: bore.inside, mouth: gamma, flow: bore.flow, dynamic: d},
        lifetime: {envelope: pl.envelope, tail: 150ms}
    })
}

// --- The flute -------------------------------------------------------------------------
//
// std/physical's jet-drive flue pipe with the shared player: the jet's
// displacement is the pipe's flow integrated, its flow past the edge a tanh aimed
// `offset` off the edge, and the pipe is driven by that flow's rate of change.
let flute_defaults = {
    velocity_breath: 1, // 0: the dynamic is the `pressure` curve alone, velocity ignored
    family: "flue",
    headjoint: null, // optional lumped side branch at the embouchure
    tone_hz: 2500, // the tone-hole lattice: above it the tube radiates ...
    track: 1.5, // ... but the tube's top never falls under this many times the note
    reflection: 0.92,
    coupling: 0.12,
    vortex: 0.19, // loss at the mouth growing with the level (std/physical.flue)
    bias: 0.15, // ... a little more for flow out of the mouth than in
    offset: 0.4, // the jet's aim off the edge: the second partial (|offset| <= 0.7)
    register: 1.3, // the jet's deflection falls, and its drive rises, with pitch
    stiff: 0.5, // a faster (harder-blown) jet is deflected less
    flux: 1,
    pressure_rise: 0.6, // octaves of blowing pressure per octave of pitch above A4
    sharpness: 2.5,
    drive: 3.5,
    inside: 0.15, // the tube's pressure in the output (dark)
    radiated: 1, // what leaves the open end (bright)
    top: [[0, 8], [1, 16]], // a gentle output lowpass, in multiples of the note, by dynamic
    noise: 0.012, // turbulence in the breath, through the jet (close and dry)
    noise_hz: 2500,
    noise_brighten: 1,
    noise_follow: 0, // the jet carries its turbulence up with the note already
    noise_slope: 4,
    noise_dynamic: 0,
    hiss: 0.002, // air past the edge that never becomes tone
    tongue_gain: 0.25,
    burst: 35ms,
    finger: 0.02,
    drift_cents: 3,
    flutter_hz: 25Hz,
    vibrato_hz: 5Hz,
    vibrato_breath: 0.1,
    vibrato_cents: 11,
    attack: 4ms,
    release: 90ms,
    cents_per_dynamic: 0,
    dynamic_cents: null,
    gain_db: 0,
    level_db: 8,
    dynamics: flute_dynamics,
    oversample: 2,
    raw: false
};

fn flute_patch(o) {
    let pl = player_of(o);
    let f = s.frequency();
    let lf = s.mapping(f, "log2");
    let d = pl.dynamic;
    let level = if o.raw { s.mul([d, 1.4]) } else { curve(d, o.dynamics) };
    // A flutist blows a high note harder: `pressure_rise` octaves of pressure for
    // each octave of pitch above A4.
    let rise = s.mapping(s.mul([s.add([lf, -8.78136]), o.pressure_rise]), "exp2");
    let pm = s.mul([pl.envelope, curve(lf, o.calibration.thr), level, rise]);
    let mouth = s.mul([pm, s.add([1, s.mul([pl.noise, s.add([o.noise, pl.fingers])])])]);
    let tube = ph.flue(mouth, tuned_frequency(o, f, lf, d, pl.cents), {
        tone: s.mapping(s.mul([f, o.track]), "clamp", o.tone_hz * 1Hz, 16000Hz),
        // `lip` 0.5 is the jet at rest (half a period); lower sharpens and overblows.
        jet: s.slew(s.expression("lip"), 20ms, 20ms),
        // `brightness` 0.5 aims the jet at `offset`; higher aims it further off the
        // edge (a reedier tone), lower nearer (a hollow one).
        offset: o.offset, aim: s.mul([s.add([s.slew(s.expression("brightness"), 20ms, 20ms), -0.5]), 0.4]), reflection: o.reflection, coupling: o.coupling, vortex: o.vortex,
        sharpness: o.sharpness, drive: o.drive, register: o.register, bias: o.bias, stiff: o.stiff, flux: o.flux,
        headjoint: o.headjoint
    });
    let body = s.add([s.mul([tube.inside, o.inside]), s.mul([tube.radiated, o.radiated])]);
    let voiced = s.lowpass1(s.lowpass1(body, s.mul([f, curve(d, o.top)])), s.mul([f, curve(d, o.top), 2]));
    let air = s.filter(s.mul([pl.noise, pm, o.hiss]), s.mapping(s.mul([f, 2]), "clamp", 1500Hz, 5000Hz), 0.8, "bandpass");
    voice_patch(o.name, {
        note_controls: merge(pl.controls, {lip: 0.5}),
        velocity_track: 0,
        oversample: o.oversample,
        gain_db: o.gain_db,
        output: s.mul([s.add([voiced, air]), level_of(o, d)]),
        feedback: tube.feedback,
        probes: {inside: tube.inside, mouth: pm, flow: tube.flow, dynamic: d},
        lifetime: {envelope: pl.envelope, tail: 150ms}
    })
}

// --- Players ---------------------------------------------------------------------------
//
// How a player breathes, tongues and tunes, for `play`: each spec's `player`
// record over these defaults.
//
// The air budgets are estimates. Reed players blow at a few kPa through a small
// opening and the oboe's flow is the smallest of all (Fuks and Sundberg 1999,
// "Blowing pressures in bassoon, clarinet, oboe and saxophone", Acta Acustica
// 85:267-277), so an oboist ends a phrase with air to spare that has gone stale
// and must be let out before the next breath; the flute's jet spends air
// fastest (Fletcher 1975, "Acoustical correlates of flute performance
// technique", JASA 57:233-237). Reed players measured in running music end
// their breath groups at 14-52 % of vital capacity, oboists rarely below the
// resting lung volume, and take breath pauses of about 0.3 s (Fuks and Sundberg
// 1998, "Respiratory inductive plethysmography measurements on professional
// reed woodwind instrument players", KTH TMH-QPSR 39:19-42). Exhaled CO2 rises
// steadily the longer a breath is held (Fuks 1998, From Air to Music, KTH),
// which is what `stale` stands for. The oboe's full exchange (`exhale` then
// `inhale`) takes about half a second, so a 0.3 s pause renews about half.
let player_defaults = {
    air: 15, // seconds of mezzo-forte playing on a full breath
    flow: [[0, 0.5], [0.5, 1], [1, 1.6]], // air spent per second, by dynamic (1 at mf)
    stale: 1000, // seconds a breath can be held before it must be renewed
    reserve: 0.1, // the part of a breath a player does not plan to spend
    inhale: 0.4, // seconds for a full breath (filling empty lungs)
    exhale: 0, // seconds to let out air gone stale before breathing in
    relief: 0.5, // a silence that is no breath counts this much less toward stale air
    exhale_keep: 0.5, // an exhale alone (no inhale) keeps at least this part of the air
    take: 0.35, // the most of a note's length a breath in a running line takes
    rest_breath: 0.3, // seconds: a rest this long is always breathed in
    late: 15ms, // the entry after a breath in a running line is late by this ...
    late_max: 70ms, // ... and later, up to this, when the note before is too short to give the breath its time
    double: false, // double tongues fast repeated notes (tu-ku)
    tongue_fast: 5, // notes per second from which the tongue lightens
    double_rate: 6, // tongued notes per second from which a player double-tongues
    breaks: [], // pitches where the register changes: a slur across one needs support
    // Intonation, in cents over the model's calibrated pitch: a tendency by
    // pitch (`register`, [[pitch, cents]]) and by dynamic (`dynamic`, cents per
    // unit of dynamic above mf), with `scatter` cents of the player's own on each
    // note. After `correct` the lip pulls the note in over `settle`, leaving `keep`
    // of it. The reaction comes as late as an auditory correction can: about
    // 100-150 ms (Burnett et al. 1998, "Voice F0 responses to manipulations in
    // pitch feedback", JASA 103:3153-3161).
    intonation: {register: [[0, 0]], dynamic: 0, scatter: 2.5, correct: 120ms, settle: 150ms, keep: 0.3},
    vibrato_min: 0.45, // seconds: the shortest note that carries vibrato, at full intensity
    // What a player can do at all: `play` reports anything beyond these as
    // unplayable. They are pedagogical estimates for a strong professional, not
    // measurements: single tonguing holds sixteenths to about crotchet = 120-132
    // (8-9 notes a second); flutists, and many oboists and bassoonists,
    // double-tongue faster (Taffanel and Gaubert 1923); fingers manage slurred
    // runs of 16-20 notes a second; a slur across the clarinet's break is the
    // slowest motion in the family.
    limits: {
        tongue: 8, // single-tongued notes a second, kept up over `run` notes
        double: 0, // double-tongued notes a second (0: not used)
        slurred: 18, // slurred notes a second
        crossing: 12, // slurred crossings of a register break a second
        slur_leap: 24, // the widest slur, in semitones
        fast_leap: 12, // a slur wider than this ...
        leap_time: 0.08, // ... needs this many seconds on the note before it
        refill: 0.25, // the least part of a breath worth stopping for
        run: 4 // notes before a rate counts as kept up
    }
};
// The five players. Tendencies follow the usual tuning charts: a flute is flat
// low and soft and sharp high and loud (its jet's speed raises the pitch:
// Coltman 1966, "Resonance and sounding frequencies of the flute", JASA
// 40:99-107); a clarinet's throat tones (written G4-B♭4) and top notes run sharp;
// reeds pinched for soft playing go sharp and loosened for loud playing go flat.
let players = {
    flute: {air: 9, flow: [[0, 0.55], [0.5, 1], [1, 1.6]], inhale: 0.45, double: true, breaks: [74, 86],
        limits: {double: 13, slurred: 20, crossing: 14, slur_leap: 26},
        intonation: {register: [[60, -4], [67, -1], [74, 0], [86, 2], [96, 5]], dynamic: 8, scatter: 3, correct: 120ms, settle: 150ms, keep: 0.3}},
    oboe: {air: 45, flow: [[0, 0.6], [0.5, 1], [1, 1.4]], stale: 15, inhale: 0.3, exhale: 0.25, breaks: [76],
        limits: {double: 10, slurred: 16, crossing: 10, slur_leap: 19},
        intonation: {register: [[58, 2], [70, 0], [84, 2], [91, 5]], dynamic: -4, scatter: 2.5, correct: 120ms, settle: 150ms, keep: 0.3}},
    clarinet: {air: 18, inhale: 0.4, breaks: [69], limits: {slurred: 20, crossing: 7, slur_leap: 27},
        intonation: {register: [[50, 0], [64, 0], [65, 4], [68, 4], [69, 0], [84, 1], [91, 5]], dynamic: -5, scatter: 2.5, correct: 120ms, settle: 150ms, keep: 0.3}},
    bass_clarinet: {air: 13, inhale: 0.5, breaks: [57], limits: {tongue: 7, slurred: 14, crossing: 5},
        intonation: {register: [[34, 0], [52, 0], [53, 3], [56, 3], [57, 0], [79, 4]], dynamic: -4, scatter: 2.5, correct: 120ms, settle: 150ms, keep: 0.3}},
    bassoon: {air: 16, stale: 25, inhale: 0.45, exhale: 0.1, breaks: [57], limits: {double: 11, slurred: 16, crossing: 10},
        intonation: {register: [[34, -2], [50, 0], [64, 2], [75, 6]], dynamic: -4, scatter: 2.5, correct: 120ms, settle: 150ms, keep: 0.3}}
};

// --- The five ------------------------------------------------------------------------------

// Double reeds: the dynamic opens the tube's top from 0.65 to 1.4 times its cutoff.
let cone_bright = [[0, 0.65], [0.2, 0.7], [0.5, 1], [1, 1.4]];

// How each instrument is played (see `perform`): vibrato rate and depth (the
// recordings: flutes 4.7-5.5 Hz, 4-12 cents and 1-5 dB; oboes 4.3-5.4 Hz and
// 4-8 cents; bassoons about 4.1 Hz and 1-4 cents; clarinets none), how much more
// air a soft note has, how far a slur overlaps, and how long a soft tonguing
// takes to reach its level.
fn style(vibrato, air, slur, soft) = {vibrato: vibrato, air: air, slur: slur, soft: soft};

// The breath the recordings carry (distant microphones, a room): brighter air
// between the partials, for a spec to be heard far off or to match them.
let reed_far = {noise_slope: 4, noise_brighten: 2};

let specs = {
    flute: merge(flute_defaults, {
        name: "flute", player: players.flute, range: [60, 96], calibration: cal.flute, gain_db: -17,
        style: style(true, 0.5, 28ms, 95ms), far: {noise: 0.02, noise_hz: 4000, noise_follow: 0.25}
    }),
    oboe: merge(reed_defaults, {
        name: "oboe", player: players.oboe, range: [58, 91], calibration: cal.oboe, kind: "cone", apex: 0.3, lattice_hz: 2300, track: 5, track_curve: [[10, 5], [10.3, 1.6]],
        loss: 0.95, gamma_max: 0.6, lattice_dynamic: cone_bright, formants: [[1350Hz, 1.6, 3.5], [2900Hz, 3, 1.2]],
        octave_key: 76, noise: 0.16, noise_hz: 2000, gain_db: -17, level_db: 12, vibrato_hz: 5Hz, vibrato_breath: 0.07, vibrato_cents: 7,
        style: style(true, 0.6, 24ms, 65ms), far: {noise_brighten: 2}
    }),
    clarinet: merge(reed_defaults, {
        name: "clarinet", player: players.clarinet, range: [50, 91], calibration: cal.clarinet, kind: "cylinder", clarion: 69,
        lattice_hz: 2400, track: 4, loss: 0.96, leak: 0.06, gain_db: 5,
        dynamic_cents: [[0.2, -1], [0.35, -0.7], [0.5, 0], [0.65, 1.7], [0.8, 3.2], [0.9, 3.4], [1, 2.8]],
        style: style(false, 0.3, 26ms, 85ms), far: reed_far
    }),
    bass_clarinet: merge(reed_defaults, {
        name: "bass_clarinet", player: players.bass_clarinet, range: [34, 79], calibration: cal.bass_clarinet, kind: "cylinder",
        clarion: 57, lattice_hz: 3000, track: 8, loss: 0.965, leak: 0, gain_db: 12.5,
        dynamic_cents: [[0.2, -0.7], [0.35, -0.4], [0.5, 0], [0.65, 0.7], [0.8, 1.4], [1, 1.4]],
        max_seconds: 60ms, style: style(false, 0.2, 30ms, 100ms), far: reed_far
    }),
    bassoon: merge(reed_defaults, {
        name: "bassoon", player: players.bassoon, range: [34, 75], calibration: cal.bassoon, kind: "cone", apex: 0.27, lattice_hz: 1100,
        track: 4, loss: 0.95, gamma_max: 0.6, lattice_dynamic: cone_bright,
        formants: [[480Hz, 2.5, 2], [1150Hz, 3, 1.2], [2300Hz, 4, 0.4]], noise: 0.07, noise_hz: 2500, noise_slope: 2, noise_brighten: 1,
        // The recordings' body against the model's (tools/woodwinds.py body), for `body`.
        body_eq: [[250, 1.6], [315, -0.3], [397, 1.1], [500, 7.1], [630, 9.4], [794, 7.1], [1000, -1.8], [1260, -4.2],
            [1587, -4.2], [2000, 3.2], [2520, -12], [3175, -6.3], [4000, -9], [5040, -12]],
        gain_db: -14, level_db: 18, max_seconds: 60ms, vibrato_hz: 4.1Hz, vibrato_breath: 0.028, vibrato_cents: 4,
        style: style(true, 0.5, 26ms, 75ms), far: reed_far
    })
};

// A spec voiced as the recordings were heard, from a distance in a room: the
// defaults are close and dry, with the breath between the partials a few dB
// under them above 4 kHz.
fn far(spec) = merge(spec, spec.far);
// A spec changed by `changes`: a new instrument from an old one. Recalibrate it
// (tools/woodwinds.py calibrate) once its bore or range changes.
fn derive(spec, changes) = merge(spec, changes);
// The voice patch of a spec, with `overrides` merged into it.
fn patch(spec, overrides = {}) {
    let o = merge(spec, overrides);
    if o.family == "flue" { flute_patch(o) } else { reed(o) }
}
// The spec's body as a track chain: `body_eq` ([[hz, dB], ...], from
// tools/woodwinds.py body) as a convolution, or nothing. A linear-phase response:
// it delays the instrument by 127 samples.
//   track("ob", line, w.oboe(), {chain: w.body(w.specs.oboe)})
fn body(spec) = if merge({body_eq: null}, spec).body_eq == null { [] } else {
    [fx("convolve", {ir: ph.response_ir(spec.body_eq, 255)})]
};
// A monophonic instrument: an overlapping note continues the voice (a slur).
fn instrument(spec, overrides = {}, glide = 6ms) = i.mono(patch(spec, overrides), glide);
fn flute(overrides = {}) = instrument(specs.flute, overrides);
fn oboe(overrides = {}) = instrument(specs.oboe, overrides);
fn clarinet(overrides = {}) = instrument(specs.clarinet, overrides);
fn bass_clarinet(overrides = {}) = instrument(specs.bass_clarinet, overrides);
fn bassoon(overrides = {}) = instrument(specs.bassoon, overrides);
let raw = cal.raw;

// --- Playing rules ------------------------------------------------------------------------
//
// `perform(pattern, spec, options)` turns written notes into blown ones: each
// note's dynamic and articulation become curves of breath (`pressure`), tongue,
// air (`noise`), vibrato, flutter and level, the same rules for every
// instrument, with the numbers of its `style`. Play the result on
// `instrument(spec)` (monophonic: a slur continues the voice).
//
// The written dynamic is the note's velocity (0.2 ppp, 0.5 mf, 1 ff), or
// `options.dynamics`, a list of [position, dynamic] points in score time or a
// function of score position (`in_bars` makes one from points in bars), for
// hairpins that run through notes. `options.soft` (legato tonguing) is a bool
// or a function of the note, and `options.level` scales a note's `volume`: a
// record of tags to factors or a function of the note. Articulations are tags
// (names in `tags`, which a piece may rename):
//
//   slur      continues from the note before: no tongue, the breath carried over
//   staccato  half the length, a lighter, livelier tongue
//   accent    a pressure kick at the start; `hard` tongues it hardest (marcato)
//   soft      a legato tongue (du): the breath swells into the note
//   tenuto    held to the next note's tongue, no taper
//   niente    al niente: the level falls away through the note (the breath stays
//             above the speaking threshold, so the tone thins rather than cuts)
//   dal_niente  from nothing: the breath and level grow out of air
//   flutter   flutter-tongued
//   breathy   an airy tone (more turbulence, no vibrato)
//
// A phrase's last note (a rest or nothing after it) tapers. Long notes on
// instruments with vibrato (flute, oboe, bassoon) get one that starts late and
// grows, narrower when soft; the clarinets play straight. Every rule here is
// ordinary source: pass `options.rule`, a function (note, context) -> note
// patch, to replace it (see `sounding`).

let tags = {
    slur: "slur", staccato: "staccato", accent: "accent", hard: "hard", soft: "soft", tenuto: "tenuto",
    niente: "niente", dal_niente: "dal_niente", flutter: "flutter", breathy: "breathy",
    // read by `play` only
    breath: "breath", no_breath: "no_breath", phrase: "phrase", peak: "peak", superhuman: "superhuman"
};

// The value at `x` of a curve of [x, value] points in ascending x, straight
// between points and held past the ends. A binary search: a part's dynamics can
// have a point every bar.
fn interp(points, x) {
    let n = len(points);
    if n == 0 { 0 } else { if x <= points[0][0] { points[0][1] } else { if x >= points[n - 1][0] { points[n - 1][1] } else {
        // Halve [lo, hi] (points[lo] <= x < points[hi]) until it is one segment.
        let k = fold(range(floor(ln(n) / ln(2)) + 1), {lo: 0, hi: n - 1}, fn(r, step) => if r.hi - r.lo <= 1 { r } else {
            let mid = floor((r.lo + r.hi) / 2);
            if points[mid][0] <= x { {lo: mid, hi: r.hi} } else { {lo: r.lo, hi: mid} }
        }).lo;
        let a = points[k];
        let b = points[k + 1];
        a[1] + (b[1] - a[1]) * ((x - a[0]) / (b[0] - a[0]))
    } } }
}
fn callable(x) = kind(x) == "function";
fn listed(x) = kind(x) == "list";
// The song's meters as a table, one row from each change: {start, bars (the
// bars before it, numbered as std/arrange.bar_at numbers them), meter, length,
// beat}. `beat` is the counted beat in score time: the dotted note of a
// compound meter (6/8, 9/8, 12/8, ...), otherwise the meter's unit.
// `play` reads it once and finds every note's row with one lookup (`rows_at`),
// instead of searching the meter list note by note.
fn bar_row(start, bars, meter) = {start: start, bars: bars, meter: meter, length: arr.measures(1, meter),
    unit: meter[1], half: if meter[0] % 2 == 0 { meter[0] / 2 } else { 0 - 1 },
    beat: 4b / meter[1] * (if meter[1] >= 8 && meter[0] > 3 && meter[0] % 3 == 0 { 3 } else { 1 })};
fn bar_table(meters = [], meter = [4, 4]) = fold(meters, [bar_row(0b, 0, meter)], fn(rows, change) => {
    let last = rows[len(rows) - 1];
    let row = bar_row(change[0], last.bars + round((change[0] - last.start) / last.length), change[1]);
    if change[0] == last.start { slice(rows, 0, len(rows) - 1) + [row] } else { rows + [row] }
});
// A curve of [bar, value] points for `perform`'s and `play`'s `dynamics` in a
// piece with meter changes. Bars count from 1 as `song`'s bar numbers do, and
// may be fractional (4.5: halfway through bar 4); `meters` and `meter` are the
// song's (std/arrange.bar_at). Between two points the curve is straight in
// bars, so it bends in score time where a bar is shorter. It returns
// [position, value] points: the points placed in score time, and one at each
// meter change between them, so the player evaluates it as one curve.
fn in_bars(points, meters = [], meter = [4, 4]) {
    let table = bar_table(meters, meter);
    fn position(b) {
        let row = fold(table, table[0], fn(r, x) => if x.bars + 1 <= b { x } else { r });
        row.start + (b - 1 - row.bars) * row.length
    }
    let n = len(points);
    let placed = map(points, fn(p) => [position(p[0]), p[1]]);
    let bends = if n < 2 { [] } else {
        map(filter(table, fn(row) => row.bars + 1 > points[0][0] && row.bars + 1 < points[n - 1][0]
            && len(filter(points, fn(p) => p[0] == row.bars + 1)) == 0), fn(row) => [row.start, interp(points, row.bars + 1)])
    };
    sort_by(placed + bends, fn(p) => p[0])
}
fn scaled(points, by) = map(points, fn(p) => [p[0], p[1] * by]);
// `interp` at each of a list of positions. Points in strictly ascending order
// from 0 are one curve evaluation (`curve_value`) for the whole list; others
// (a step written as two points at one position, say) are searched position by
// position.
fn sampled(points, positions) {
    let n = len(points);
    if n > 0 && points[0][0] >= points[0][0] * 0 && len(filter(range(1, n), fn(i) => points[i][0] <= points[i - 1][0])) == 0 {
        curve_value({points: points, shape: "linear"}, positions)
    } else { map(positions, fn(x) => interp(points, x)) }
}
// `dynamics` (points or a function, as `perform` takes them) at each of a list
// of positions.
fn dynamics_at(dynamics, positions) = if callable(dynamics) { map(positions, fn(t) => dynamics(t)) } else { sampled(dynamics, positions) };

// The marks the rules read, as booleans: the note's tags under their rule
// names, from `has` (a context's). A note with no tags has none.
let unmarked = {slur: false, staccato: false, accent: false, hard: false, soft: false, tenuto: false,
    niente: false, dal_niente: false, flutter: false, breathy: false};
fn marks_of(n, has) = if len(n.tags) == 0 { unmarked } else {
    {slur: has(n, "slur"), staccato: has(n, "staccato"), accent: has(n, "accent"), hard: has(n, "hard"), soft: has(n, "soft"),
     tenuto: has(n, "tenuto"), niente: has(n, "niente"), dal_niente: has(n, "dal_niente"), flutter: has(n, "flutter"), breathy: has(n, "breathy")}
};
// One note's performance. `c` is its context: `next` (the following note or
// null), `seconds` (the note's length), `dynamic` (a function of score position),
// `has` (a function of a note and a rule name: does the note carry that tag),
// `marks` (the note's own marks, `marks_of(n, has)`, worked out once; made from
// `has` when a context has none), `style` (the spec's) and `soft` (the default
// tonguing is legato).
//
// `articulated` is its body: the articulation given the note's marks `mk`, the
// note after it (null when a breath ends the phrase there), whether that note
// continues this one (`slurs_on`), the dynamic at the attack, middle and end,
// and whether the style's vibrato applies. It returns {gate, expression,
// release}; `phrased` calls it with the player's worked-out dynamics.
let level_niente = [[0, 1], [0.35, 1], [0.75, 0.3], [1, 0.01]];
let level_dal_niente = [[0, 0.02], [0.5, 1], [1, 1]];
let level_falls = [[0, 1], [0.84, 1], [1, 0.4]];
fn articulated(n, c, mk, next, slurs_on, p0, p1, p2, with_vibrato) {
    let st = c.style;
    let end = n.at + n.duration;
    let slurred = mk.slur;
    let phrase_end = next == null || next.at > end;
    let staccato = mk.staccato;
    let accent = mk.accent || mk.hard;
    let soft = (c.soft || mk.soft) && !accent;
    let fading = mk.niente;
    let growing = mk.dal_niente;
    let gate = if staccato { 0.5 } else { if slurs_on || mk.tenuto { 1 } else { n.gate } };
    let seconds = c.seconds * gate;
    let lift = if staccato { 1.08 } else { 1 };
    // The end of the breath: a phrase's last note eases away, staying above the
    // speaking threshold (a reed dropped through it stops with a click); the
    // level does the rest of the fall.
    let falls = phrase_end && seconds > 0.3 && !staccato && !mk.tenuto;
    let tail = if falls && !fading { [[0.84, p2], [1, max(0.2, p2 * 0.8)]] } else { [[1, p2]] };
    // Onsets are in time and the rest by phase: on a note too short for them the
    // engine drops the points the release overtakes.
    let breath = if growing {
        [[0, 0.12], [0.4, p1 * 0.9], [0.6, p1]] + tail
    } else { if slurred {
        [[0, p0], [0.5, p1]] + tail
    } else { if accent {
        [[0ms, p0], [12ms, min(1, p0 * 1.3)], [90ms, p0], [0.5, p1]] + tail
    } else { if soft && !staccato {
        [[0ms, max(0.1, p0 * 0.35)], [st.soft * 0.4, p0 * 0.8], [st.soft, p0], [0.5, p1]] + tail
    } else {
        [[0ms, p0 * 0.85 * lift], [20ms, min(1, p0 * 1.06 * lift)], [70ms, p0], [0.5, p1]] + tail
    } } } };
    let vibrato = with_vibrato && seconds >= 0.6 && !mk.flutter && !mk.breathy && !fading && p1 > 0.18;
    let level = if fading { level_niente } else { if growing { level_dal_niente } else { if falls { level_falls } else { 1 } } };
    let base = {
        velocity_breath: 0,
        pressure: breath,
        tongue: if mk.hard { 1 } else { if accent { 0.8 } else { if slurred || growing { 0 } else {
            if staccato { if soft { 0.2 } else { 0.4 } } else { if soft { 0.15 } else { 0.4 } }
        } } },
        noise: if mk.breathy { 1 } else { if fading { 0.2 } else { min(max(0.5 + (0.45 - p1) * st.air, 0.2), 0.95) } },
        volume: level
    };
    let expression = if !mk.flutter && !vibrato { base } else { merge(base, merge(
        if mk.flutter { {flutter: [[0ms, 0], [90ms, 1]]} } else { {} },
        // The vibrato starts late and grows; it is narrower when soft.
        if vibrato {
            let delay = min(220, seconds * 1000 * 0.25);
            let fade = min(450, seconds * 1000 * 0.4);
            {vibrato: scaled([[0ms, 0], [delay * 1ms, 0], [(delay + fade) * 1ms, 1]], (0.6 + p1 * 0.8) / 1.4)}
        } else { {} }
    )) };
    // Performed length: a slur overlaps the next attack so the voice continues; a
    // tongued note next to another leaves the tongue room; a phrase's last note
    // is as written.
    let release = if slurs_on { st.slur } else { if phrase_end || staccato { 0ms } else { 0ms - min(30, seconds * 1000 * 0.12) * 1ms } };
    {gate: gate, expression: expression, release: release}
}
fn sounding(n, c) {
    let m = merge({marks: null}, c).marks;
    let end = n.at + n.duration;
    let a = articulated(n, c, if m == null { marks_of(n, c.has) } else { m }, c.next, c.next != null && c.next.at == end && c.has(c.next, "slur"),
        c.dynamic(n.at), c.dynamic(n.at + n.duration / 2), c.dynamic(end - n.duration / 64), c.style.vibrato);
    {gate: a.gate, data: merge(n.data, {expression: merge(a.expression, merge({expression: {}}, n.data).expression)}), release_offset: n.release_offset + a.release}
}

fn perform(pattern, spec, options = {}) {
    let o = merge({timing: {}, dynamics: null, tags: tags, soft: false, level: null, rule: sounding, humanize: 5ms, seed: 0}, options);
    let names = merge(tags, o.tags);
    let notes = sort_by(pattern.notes, fn(n) => n.at);
    let order = record(map(range(len(notes)), fn(k) => [notes[k].key, k]));
    fn has(n, rule) = contains(n.tags, names[rule]);
    fn seconds(n) = (seconds_at(n.at + n.duration, o.timing) - seconds_at(n.at, o.timing)) / 1s;
    let curve_of = if o.dynamics == null { null } else { if callable(o.dynamics) { o.dynamics } else { fn(t) => interp(o.dynamics, t) } };
    let soft_of = if callable(o.soft) { o.soft } else { fn(n) => o.soft };
    // `level`: a function of the note, or a record of tags (as written on the
    // notes) to factors, multiplied together; it scales the rule's `volume`.
    let level_of = if o.level == null { null } else { if callable(o.level) { o.level } else {
        fn(n) => fold(keys(o.level), 1, fn(f, t) => if contains(n.tags, t) { f * o.level[t] } else { f })
    } };
    let played = pattern.map_notes(fn(n) => {
        let k = order[n.key];
        let next = if k + 1 < len(notes) { notes[k + 1] } else { null };
        // Without a dynamics curve a note holds its velocity, moving toward the
        // next note's when it slurs into it.
        let own = if curve_of != null { curve_of } else {
            if next != null && next.at == n.at + n.duration && has(next, "slur") {
                fn(t) => n.velocity + (next.velocity - n.velocity) * max(0, (t - n.at) / n.duration - 0.5)
            } else { fn(t) => n.velocity }
        };
        let r = o.rule(n, {next: next, seconds: seconds(n), dynamic: own, has: has, marks: marks_of(n, has), style: spec.style, soft: soft_of(n)});
        let by = if level_of == null { 1 } else { level_of(n) };
        if by == 1 { r } else {
            let e = r.data.expression;
            let v = merge({volume: 1}, e).volume;
            let volume = if listed(v) { scaled(v, by) } else { v * by };
            merge(r, {data: merge(r.data, {expression: merge(e, {volume: volume})})})
        }
    });
    if o.humanize > 0ms { played.humanize(timing = o.humanize, velocity = 0, seed = o.seed) } else { played }
}

// --- The player -------------------------------------------------------------------------
//
// `play(pattern, spec, options)` is `perform` with a player behind it: a musician
// who has read the whole part before playing it. It works in two passes over the
// line, and its output is ordinary note data (timing, release, and per-note
// expression curves), so an export carries it like any other notes.
//
// 1. The phrase plan. The line is cut into breath groups. Each instrument's
//    `player` profile has an air budget: a flute spends a breath in a few
//    seconds, an oboe hardly spends it at all but has to let stale air out. The
//    player breathes at every rest long enough to, at written `breath` marks, and
//    otherwise at the best place before the air runs out, preferring phrase
//    boundaries (a `phrase` mark, a long note before shorter ones, a strong beat,
//    a leap) and never breaking a slur unless nothing else is left. A breath in a
//    running line takes its time from the note before it, and the next entry is a
//    little late. Phrases are where a listener hears them: each join of two
//    notes gets a boundary strength from rests and long notes measured in beats
//    against their neighbours, cadences on strong beats, leaps, changes of
//    dynamic, articulation, meter and tempo, four-bar groups, marks and planned
//    breaths, and the line is cut at the best set of them, phrases lasting
//    `phrasing.min` to `phrasing.max` seconds where the music allows. Each
//    phrase gets an arch of breath toward its peak (its highest, longest,
//    strongest note, or a `peak` mark) around the written dynamic, and a breath
//    nearly spent is pushed harder and wavers.
// 2. Note rules with the whole context: the previous and next notes, the
//    interval, register breaks crossed, the place in the phrase, the beat's
//    weight, how fast the notes come, and the air left. Tonguing lightens with
//    speed and repetition and firms at the start of a phrase; a flute
//    double-tongues fast repeated notes. Upward leaps get support and land a
//    little late. Each note starts at the instrument's intonation tendency and the
//    lip corrects most of it after about a tenth of a second. Vibrato grows with
//    the phrase's intensity and stays off short notes. Time drifts as a whole,
//    slowly, rather than jittering note by note; a phrase slows into its end and
//    its last note is held.
//
// Everything is keyed noise, so a part plays the same way every time for one
// `seed`, and parts that share `ensemble.seed` share one tempo drift.

fn clamp(x, lo, hi) = max(lo, min(hi, x));
// `interp` for a short curve: a linear search.
fn lookup(points, x) {
    let k = len(filter(points, fn(p) => p[0] <= x));
    if k == 0 { points[0][1] } else { if k == len(points) { points[k - 1][1] } else {
        let a = points[k - 1];
        let b = points[k];
        a[1] + (b[1] - a[1]) * (x - a[0]) / (b[0] - a[0])
    } }
}
fn smoothstep(u) = u * u * (3 - 2 * u);
// Slow noise: keyed values `scale` seconds apart, eased between, in -1..1.
fn smooth_noise(t, scale, key, seed) {
    let x = t / scale;
    let i = floor(x);
    let a = keyed_noise([key, i], seed);
    a + (keyed_noise([key, i + 1], seed) - a) * smoothstep(x - i)
}
// Drift with a 1/f-like spectrum: slow noise at `scale` seconds and twice as
// much at four times that, scaled so `amount` is about its rms.
// Timing deviations of human players are correlated this way, not white
// (Hennig et al. 2011, "The nature and perception of fluctuations in human
// musical rhythms", PLoS ONE 6(10): e26457).
fn drift_at(t, amount, scale, key, seed) = (smooth_noise(t, scale, [key, 0], seed)
    + smooth_noise(t, scale * 4, [key, 1], seed) * 2) * amount * 1.05;
// `smooth_noise` at each of a list of ascending times: its keyed values are
// the points of one smooth curve, evaluated for the whole list at once.
fn noise_at(times, scale, key, seed) {
    let n = len(times);
    if n == 0 { [] } else {
        let lo = floor(times[0] / scale);
        let hi = floor(times[n - 1] / scale) + 1;
        if lo < 0 { map(times, fn(t) => smooth_noise(t, scale, key, seed)) } else {
            curve_value({shape: "smooth", points: map(range(lo, hi + 1), fn(i) => [i * scale * 1s, keyed_noise([key, i], seed)])}, times)
        }
    }
}
// The weight of a score position's place in its bar: 1 on the downbeat, 0.6 at
// the middle of an even bar, 0.4 on other beats, 0.2 on half beats, else 0.1.
// The row of `table` holding each of `positions`, in one step curve evaluation.
fn rows_at(table, positions) = if len(table) == 1 { map(positions, fn(p) => 0) } else {
    if len(filter(range(1, len(table)), fn(i) => table[i].start <= table[i - 1].start)) > 0 {
        // Out of order (or before 0b): a search for each position.
        map(positions, fn(p) => max(0, len(filter(table, fn(row) => row.start <= p)) - 1))
    } else {
        map(curve_value({points: map(range(len(table)), fn(i) => [table[i].start, i]), shape: "step"}, positions), fn(x) => round(x))
    }
};
// The weight of a position in its bar, from its row of `bar_table`.
fn weight_in(row, at) {
    let beats = (at - row.start) * row.unit / 4b;
    let m = row.meter[0];
    let x = if beats >= 0 { beats % m } else { beats - floor(beats / m) * m };
    if x == 0 { 1 } else { if x == row.half { 0.6 } else { if x == floor(x) { 0.4 } else { if x * 2 == floor(x * 2) { 0.2 } else { 0.1 } } } }
}
fn metric_weight(at, meters = [], meter = [4, 4]) {
    let table = bar_table(meters, meter);
    weight_in(table[rows_at(table, [at])[0]], at)
}

let play_defaults = {
    timing: {}, dynamics: null, tags: {}, soft: false, level: null, seed: 0, meters: [], meter: [4, 4],
    player: {}, // changes to the spec's player
    arc: 0.1, // the phrase arch: the breath rises this part toward the peak and falls past it ...
    arc_reach: 4, // ... within this many seconds of the phrase's start, peak and end; between, the written dynamic
    // Where phrases end (see "Phrases" in the player's notes): each join of two
    // notes gets a boundary strength from what a listener hears there, with
    // these weights; rests and lengths are in beats.
    phrasing: {
        rest: 1, // a rest, by its length and how it stands out from the rests around it
        ioi: 0.5, // a long time from one attack to the next among shorter ones
        leap: 0.25, // a leap (in octaves) among smaller intervals
        cadence: 0.75, // a note of at least a beat on a strong beat, longer than the one before
        dynamics: 0.75, // a step in the written dynamic (full at 0.15)
        articulation: 0.25, // staccato to legato or back, or the end of a slur
        meter: 1, // a change of meter ...
        tempo: 1, // ... and a sudden change of tempo (5 % or more) at a bar line: a new section
        hyper: 0.6, // a bar line that starts a group of four bars (counted from the last change of meter)
        breath: 0.5, // a breath the player plans there
        mark: 1, // a written `breath` mark
        threshold: 1.25, // a boundary stronger than this is worth ending a phrase at ...
        min: 2.5, // ... unless the phrase would be shorter than this many seconds ...
        max: 16, // ... and a phrase longer than this many seconds is worth splitting at a weaker one
        rest_beats: 2 // a rest of this many beats always ends one, as does a `phrase` mark
    },
    final: 0.04, // a phrase slows into its end: its last note comes this part of `final_span` late
    final_span: 1.2, // seconds
    hold: 0.12, // and, before a rest, is held this part of its length longer ...
    hold_max: 0.3, // ... at most this many seconds, and never past the next bar line or entry
    hold_section: 0.5, // the hold before a rest into a new section (across a bar line, or the end)
    drift: 4ms, // the player's own slow drift in time (rms) ...
    drift_scale: 1.5, // ... changing over about this many seconds
    jitter: 1ms, // independent motor noise on each attack (rms)
    ensemble: {seed: 0, drift: 7ms, scale: 3}, // a tempo drift shared by every part with this seed
    lead: 0ms, // this chair plays ahead (negative) or behind the ensemble
    leap_late: 8ms, // a slurred upward leap of an octave lands this late
    leap_gap: 6ms, // and a tongued leap is separated by this much more
    support: 0.06, // breath added before and into an upward leap, and at the end of a breath
    voicing: 0.03, // `brightness` added at the start of a leap across a register break
    tongue: {phrase: 1.15, metric: 0.2, repeat: 0.9, fast: 0.07, k: 0.75, k_late: 3ms, k_dark: 0.05},
    rule: null, // (note, context) -> note patch; `phrased` by default
    part: null, // the part's name in reports (the spec's name by default)
    strict: true, // material no player could play as written is an error; false: a warning (see `playable`)
    accept: [] // codes of unplayable material to play anyway (true: all), as tagging the notes `superhuman` does
};

// --- What cannot be played as written ---------------------------------------------
//
// `play` checks the line against its player's `limits` and the spec's `range`.
// Each finding is {code, k (its first note), to (its last), message, accepted};
// codes are "range", "air" (no place to breathe in time), "slur_breath" (the
// only breath breaks a slur), "breath_time" (no time to take a useful breath),
// "tonguing", "slurred" (finger speed), "crossing" (slurs across a register
// break) and "slur_leap".
fn place_text(at, o) {
    let b = arr.bar_at(at, o.meters, o.meter);
    format("bar {} beat {}", [b.bar, round((b.position / (4b / b.meter[1]) + 1) * 1000) / 1000])
}
fn span_text(a, b, o) = if a == b { place_text(a, o) } else { place_text(a, o) + " to " + place_text(b, o) };
fn seconds_text(x) = str(round(x * 10) / 10) + " s";
// Two lengths of time to as many decimals (up to three) as tell them apart, so
// a shortfall shows: "0.18 s" against "0.21 s", not "0.2 s" against "0.2 s".
fn seconds_fine(x) = str(round(x * 100) / 100) + " s";
fn seconds_apart(a, b) {
    let d = if round(a * 10) != round(b * 10) { 10 } else { if round(a * 100) != round(b * 100) { 100 } else { 1000 } };
    [str(round(a * d) / d) + " s", str(round(b * d) / d) + " s"]
}
fn unplayable_in(notes, facts, planned, on, off, spec, pl, o, cap) {
    let count = len(notes);
    let lim = pl.limits;
    let part = if o.part == null { spec.name } else { o.part };
    fn name(k) = checks.pitch_name(notes[k].pitch);
    // The limit a breath ran into: how long it lasts at a note's dynamic, or
    // how long air can be held before it is stale.
    fn limit_text(why, k) = if why == "stale" {
        format("held air goes stale after about {}", [seconds_text(pl.stale * (1 - pl.reserve))])
    } else { format("a breath lasts about {} at this dynamic", [seconds_text(cap / lookup(pl.flow, facts[k].dynamic))]) };
    fn finding(code, k, to, message) = {code: code, k: k, to: to, message: part + ", " + span_text(notes[k].at, notes[to].at, o) + ": " + message};
    let compass = merge({range: null}, spec).range;
    let ranged = if compass == null { [] } else {
        let low = compass[0];
        let high = compass[1];
        map(filter(range(count), fn(k) => { let p = notes[k].pitch; p < low || p > high }), fn(k) => finding("range", k, k,
            format("{} is outside the {}'s range, {} to {}", [name(k), spec.name, checks.pitch_name(compass[0]), checks.pitch_name(compass[1])])))
    };
    let air = map(planned.over, fn(x) => finding("air", x.from, x.k, format(
        "{} from {} to {} with no place to breathe; {}", [seconds_text(off[x.k] - on[x.from]), name(x.from), name(x.k), limit_text(x.why, x.k)])));
    let bs = planned.breaths;
    // Breaths the plan could only take by breaking a slur (or a no-breath mark),
    // or with too little time; one finding for each stretch, however many
    // breaths it needed.
    fn joined(j) = facts[j].slur || facts[j].refuse;
    let raw = fold(range(len(bs)), [], fn(out, i) => {
        let b = bs[i];
        let since = if i == 0 { on[0] } else { on[bs[i - 1].k + 1] };
        let first = if b.slur || b.refuse { fold(range(b.k + 1), 0, fn(f, j) => if j > 0 && !joined(j - 1) { j } else { f }) } else { b.k };
        let last = if b.slur || b.refuse {
            fold(range(b.k + 1, count), {k: count - 1, done: false}, fn(r, j) => if !r.done && !joined(j) { {k: j, done: true} } else { r }).k
        } else { b.k + 1 };
        let item = {i: i, b: b, held: off[b.k] - since, first: first, last: last, n: 1};
        out + (if b.slur || b.refuse { [merge(item, {code: "slur_breath"})] } else { [] })
            + (if b.refill < lim.refill { [merge(item, {code: "breath_time"})] } else { [] })
    });
    let merged = fold(raw, [], fn(out, x) => {
        let same = filter(range(len(out)), fn(j) => out[j].code == x.code
            && (x.code == "slur_breath" && out[j].first == x.first || x.code == "breath_time" && out[j].i_last + 1 == x.i));
        if len(same) == 0 { out + [merge(x, {i_last: x.i})] } else {
            let j = same[0];
            map(range(len(out)), fn(m) => if m == j { merge(out[m], {last: max(out[m].last, x.last), n: out[m].n + 1, i_last: x.i}) } else { out[m] })
        }
    });
    let breaths = map(merged, fn(x) => {
        let b = x.b;
        let times = if x.n == 1 { "a breath" } else { str(x.n) + " breaths, the first" };
        if x.code == "slur_breath" {
            finding("slur_breath", x.first, x.last, format("{} from {} to {} lasts {} and needs {} after {}, between {} and {}; {}",
                [if b.slur { "the slur" } else { "the no-breath passage" }, name(x.first), name(x.last), seconds_text(off[x.last] - on[x.first]), times,
                 seconds_text(x.held), name(b.k), name(b.k + 1), limit_text(b.why, b.k)]))
        } else {
            // A useful breath renews `refill` of what this one had to renew.
            let pair = seconds_apart(b.time, lim.refill * b.full);
            finding("breath_time", x.first, x.last, format("{} with only {} of time, between {} and {} after {} of playing; a useful breath here needs {} ({} of a full one, which would take {})",
                [times, pair[0], name(b.k), name(b.k + 1), seconds_text(x.held), pair[1], lim.refill, seconds_fine(b.full)]))
        }
    });
    // Runs of pairs k -> k + 1 for which `fast(k)` holds, as {from, to, ioi}.
    // Only pairs faster than the slowest of the limits can be in one, so the
    // line is searched once for those.
    fn ioi(k) = on[k + 1] - on[k];
    let tongue_limit = max(lim.tongue, lim.double);
    let slowest = 1 / min(tongue_limit, min(lim.slurred, lim.crossing));
    let quick = filter(range(max(0, count - 1)), fn(k) => on[k + 1] - on[k] < slowest);
    fn runs(fast) {
        let r = fold(filter(quick, fast), {cur: null, out: []}, fn(st, k) => {
            let ioi_k = ioi(k);
            if st.cur != null && st.cur.to == k { {cur: {from: st.cur.from, to: k + 1, ioi: min(st.cur.ioi, ioi_k)}, out: st.out} } else {
                {cur: {from: k, to: k + 1, ioi: ioi_k}, out: if st.cur == null { st.out } else { st.out + [st.cur] }}
            }
        });
        if r.cur == null { r.out } else { r.out + [r.cur] }
    }
    let tongued = map(filter(runs(fn(k) => !facts[k].slur && ioi(k) < 1 / tongue_limit), fn(r) => r.to - r.from + 1 >= lim.run), fn(r) => finding("tonguing", r.from, r.to,
        format("{} tongued notes at {} a second; {} reaches about {}", [r.to - r.from + 1, round(10 / r.ioi) / 10,
            if lim.double > 0 { "double tonguing" } else { "single tonguing" }, tongue_limit])));
    let slurred = map(filter(runs(fn(k) => facts[k].slur && ioi(k) < 1 / lim.slurred), fn(r) => r.to - r.from + 1 >= lim.run), fn(r) => finding("slurred", r.from, r.to,
        format("{} slurred notes at {} a second; fingers reach about {}", [r.to - r.from + 1, round(10 / r.ioi) / 10, lim.slurred])));
    let crossing = map(filter(runs(fn(k) => facts[k].slur && facts[k].cross && ioi(k) < 1 / lim.crossing), fn(r) => r.to - r.from >= 2), fn(r) => finding("crossing", r.from, r.to,
        format("{} slurs across the register break at {} a second; about {} can be played", [r.to - r.from, round(10 / r.ioi) / 10, lim.crossing])));
    let leap_floor = min(lim.slur_leap, lim.fast_leap);
    let leaps = map(filter(range(max(0, count - 1)), fn(k) => facts[k].slur && abs(facts[k].step) > leap_floor
        && (abs(facts[k].step) > lim.slur_leap || ioi(k) < lim.leap_time)), fn(k) => {
        let wide = abs(facts[k].step);
        finding("slur_leap", k, k + 1, if wide > lim.slur_leap {
            format("a slur of {} semitones from {} to {}; about {} can be slurred", [wide, name(k), name(k + 1), lim.slur_leap])
        } else {
            format("a slur of {} semitones from {} to {} after {} s; it needs about {} s", [wide, name(k), name(k + 1), round(ioi(k) * 1000) / 1000, lim.leap_time])
        })
    });
    let all = sort_by(ranged + air + breaths + tongued + slurred + crossing + leaps, fn(x) => x.k);
    fn accepts(a, code) = a == true || kind(a) == "list" && contains(a, code);
    map(all, fn(x) => merge(x, {accepted: accepts(o.accept, x.code)
        || len(filter(range(x.k, x.to + 1), fn(k) => accepts(facts[k].accepts, x.code))) > 0}))
}

// One note's performance with the player's context: `sounding`'s articulation,
// then tonguing, intonation, voicing and vibrato. `c` has `sounding`'s fields
// (`next`, `seconds`, `dynamic`, `has`, `marks`, `style`, `soft`) and `prev`, `interval`
// (semitones to the next note, or null), `interval_in`, `crosses_break` (the
// interval to the next note crosses one of the player's breaks),
// `breaks_in`, `phrase_pos` (0..1 through the phrase, by time),
// `phrase_first`, `phrase_last`, `metric_weight`, `note_rate` (notes per second
// here), `air_left` (0..1 of the breath at the note's end), `breath_before`,
// `breath_after` (the breath taken after this note, or null), `intensity`
// (0..1, the phrase arch here and the dynamic), `run` (the note's place in a
// run of fast tongued notes), `tuning` (cents), `slurs_on` (the next note
// continues this one under a slur, with no breath between), `player` and
// `options`.
let own_play = {tongue: 1, tuning: null, vibrato: 1};
let unvibrated = [0ms, 0];
fn phrased(n, c) {
    let o = c.options;
    let pl = c.player;
    let tg = o.tongue;
    let own = if contains(keys(n.data), "play") { merge(own_play, n.data.play) } else { own_play };
    // A breath after the note ends its phrase for the articulation rules; the
    // vibrato is the player's own.
    let next = if c.breath_after == null { c.next } else { null };
    let a = articulated(n, c, c.marks, next, c.slurs_on, c.attack, c.middle, c.ending, false);
    let e = a.expression;
    let seconds = c.seconds * a.gate;
    let p1 = c.middle;
    let tongued = e.tongue > 0;
    // Tonguing: firmer at a phrase's start and on strong beats, lighter on a
    // repeated note and as the notes come faster; in a run of fast tongued notes
    // a flute alternates tu and ku, the ku a little weaker, darker and later
    // (Taffanel and Gaubert, Méthode complète de flûte, 1923).
    let ku = pl.double && tongued && c.run % 2 == 1;
    let tongue = if tongued {
        min(1, e.tongue * (if c.phrase_first { tg.phrase } else { 1 }) * (1 - tg.metric / 2 + tg.metric * c.metric_weight)
            * (if c.repeat { tg.repeat } else { 1 }) * max(0.55, 1 - max(0, c.note_rate - pl.tongue_fast) * tg.fast)
            * (if ku { tg.k } else { 1 }) * own.tongue)
    } else { 0 };
    // Intonation: the tendency at the attack, then the lip's correction.
    let into = pl.intonation;
    let cents = (if own.tuning != null { own.tuning } else { c.tuning }) / 100;
    let tuning = if abs(cents) < 0.002 { {} } else {
        {tuning: if seconds * 1s > into.correct + into.settle / 2 {
            [[0ms, cents], [into.correct, cents], [into.correct + into.settle, cents * into.keep]]
        } else { cents }}
    };
    // Voicing: a leap up across a register break, or of more than a fifth, is
    // supported at its start; a ku is darker.
    let up = c.interval_in;
    let brightness = if ku { {brightness: 0.5 - tg.k_dark} } else {
        if up != null && up > 0 && (c.breaks_in || up > 7) && seconds > 0.1 { {brightness: [[0ms, 0.5 + o.voicing], [150ms, 0.5]]} } else { {} }
    };
    // Vibrato grows with the phrase's intensity: deeper, sooner and a little
    // faster toward its peak, and faster through a long note (Gärtner 1981, The
    // Vibrato, with particular consideration given to the situation of the
    // flutist; Prame 1994, "Measurements of the vibrato rate of ten singers",
    // JASA 96:1979-1984). It needs time to show, so a short note has none, and it
    // dies with a phrase's last note.
    let i = c.intensity;
    let mk = c.marks;
    let vibrato = if c.style.vibrato && p1 > 0.18 && own.vibrato > 0 && seconds >= pl.vibrato_min + (1 - i) * 0.25
        && !(mk.flutter || mk.breathy || mk.niente) {
        let depth = min(1, (0.6 + p1 * 0.8) / 1.4 * (0.7 + 0.6 * i) * own.vibrato);
        let delay = min(220ms, seconds * 250ms) * (1.25 - 0.5 * i);
        let rate = 0.35 + 0.3 * i;
        {vibrato: [unvibrated, [delay, 0], [delay + min(450ms, seconds * 400ms), depth]]
            + if c.phrase_last && seconds > 0.6 { [[0.8, depth], [1, depth * 0.35]] } else { [] },
         vibrato_rate: [[0, rate], [1, rate + 0.05]]}
    } else { {} };
    // A breath nearly spent: more air in the tone.
    let tired = if c.air_left >= 0.25 { 0 } else { min(1, (0.25 - c.air_left) * 4) };
    let air = if tired > 0 { {noise: min(0.95, e.noise + 0.12 * tired)} } else { {} };
    {gate: a.gate, release_offset: n.release_offset + a.release, data: merge(n.data, {expression: merge(e, {tongue: tongue}, air, tuning, brightness, vibrato,
        merge({expression: {}}, n.data).expression)})}
}

fn play(pattern, spec, options = {}) {
    let o = merge(play_defaults, options, {
        tongue: merge(play_defaults.tongue, merge({tongue: {}}, options).tongue),
        ensemble: merge(play_defaults.ensemble, merge({ensemble: {}}, options).ensemble),
        phrasing: merge(play_defaults.phrasing, merge({phrasing: {}}, options).phrasing)
    });
    let rule = if o.rule == null { phrased } else { o.rule };
    let mine = merge({player: {}}, spec).player;
    let pl = merge(player_defaults, mine, o.player, {
        intonation: merge(player_defaults.intonation, merge({intonation: {}}, mine).intonation, merge({intonation: {}}, o.player).intonation),
        limits: merge(player_defaults.limits, merge({limits: {}}, mine).limits, merge({limits: {}}, o.player).limits)
    });
    let names = merge(tags, o.tags);
    let notes = sort_by(pattern.notes, fn(n) => n.at);
    let count = len(notes);
    let order = record(map(range(count), fn(k) => [notes[k].key, k]));
    // Every per-note quantity below is worked out once, and where a search or a
    // noise lookup applies to the whole line it is one curve evaluation
    // (`sampled`, `rows_at`, `noise_at`, the arches): evaluation steps grow with
    // the notes, not with the meters, dynamics points or phrases.
    // Each note's noise key: std/performance.note_identity's, made directly when
    // no two notes share a position and none pins its identity.
    let shared = len(filter(range(count), fn(k) => k > 0 && notes[k].at == notes[k - 1].at || contains(keys(notes[k].data), "identity"))) > 0;
    let identity = if shared { note_identity(pattern) } else { null };
    let ids = map(notes, fn(n) => if identity == null { [n.voice, n.at, n.pitch, 0] } else { identity(n) });
    fn sec(t) = seconds_at(t, o.timing) / 1s;
    let on = map(notes, fn(n) => sec(n.at));
    let off = map(notes, fn(n) => sec(n.at + n.duration));
    // --- the written line --------------------------------------------------------
    // A breath taken after a slurred-to note breaks the slur: the next note is
    // tongued. `has` is the player's view of the marks.
    fn marked(n, rule) = contains(n.tags, names[rule]);
    let slur_tag = names.slur;
    let late_ms = pl.late / 1s;
    let late_more = (pl.late_max - pl.late) / 1s;
    let curve_of = if o.dynamics == null { null } else { if callable(o.dynamics) { o.dynamics } else { fn(t) => interp(o.dynamics, t) } };
    let soft_of = if callable(o.soft) { o.soft } else { fn(n) => o.soft };
    // Each note's marks, read from its tags once for the plan and the rules (a
    // note without tags shares one record).
    let none_marked = merge(unmarked, {breath: false, no_breath: false, phrase: false, peak: false, superhuman: false});
    let rule_names = keys(none_marked);
    let tag_names = map(rule_names, fn(r) => names[r]);
    let distinct = len(group_by(tag_names, fn(t) => t)) == len(tag_names);
    let rule_of = if distinct { record(map(rule_names, fn(r) => [names[r], r])) } else { {} };
    let marks = map(notes, fn(n) => if len(n.tags) == 0 { none_marked } else { if distinct {
        fold(n.tags, none_marked, fn(m, t) => if contains(tag_names, t) { merge(m, record([[rule_of[t], true]])) } else { m })
    } else {
        record(map(rule_names, fn(r) => [r, contains(n.tags, names[r])]))
    } });
    fn written(k) {
        let n = notes[k];
        let next = if k + 1 < count { notes[k + 1] } else { null };
        if curve_of != null { curve_of } else {
            if next != null && next.at == n.at + n.duration && marked(next, "slur") {
                fn(t) => n.velocity + (next.velocity - n.velocity) * max(0, (t - n.at) / n.duration - 0.5)
            } else { fn(t) => n.velocity }
        }
    }
    // The written dynamic at each note's attack, middle and end (where the rules
    // ask), and each note's row of the meter table.
    let mids = map(notes, fn(n) => n.at + n.duration / 2);
    let tails = map(notes, fn(n) => n.at + n.duration * 63 / 64);
    let written_at = if curve_of == null {
        // `written` at the attack and middle is the velocity; at the end it has
        // moved 31/64 of the way to a slurred next note's.
        let velocities = map(notes, fn(n) => n.velocity);
        {d0: velocities, d1: velocities, d2: map(range(count), fn(k) => {
            let n = notes[k];
            if k + 1 < count && marks[k + 1].slur && notes[k + 1].at == n.at + n.duration { n.velocity + (notes[k + 1].velocity - n.velocity) * 31 / 64 } else { n.velocity }
        })}
    } else {
        {d0: dynamics_at(o.dynamics, map(notes, fn(n) => n.at)), d1: dynamics_at(o.dynamics, mids), d2: dynamics_at(o.dynamics, tails)}
    };
    let table = bar_table(o.meters, o.meter);
    let rows = rows_at(table, map(notes, fn(n) => n.at));
    let flows = sampled(pl.flow, written_at.d1);
    let cap = pl.air * (1 - pl.reserve);
    let stale_cap = pl.stale * (1 - pl.reserve);
    let need = pl.exhale + pl.inhale;
    // Each note's register: how many of the player's breaks lie at or below it.
    // A step between two registers crosses a break.
    let registers = if len(pl.breaks) == 0 { map(notes, fn(n) => 0) } else {
        let breaks = sort_by(pl.breaks, fn(x) => x);
        curve_value({shape: "step", points: [[0, 0]] + map(range(len(breaks)), fn(i) => [breaks[i], i + 1])}, map(notes, fn(n) => n.pitch))
    };
    let unplanned = {breath: null, shift: 0ms, accept: []};
    let facts = map(range(count), fn(k) => {
        let n = notes[k];
        let next = if k + 1 < count { notes[k + 1] } else { null };
        let s = off[k] - on[k];
        let g = if next == null { 1000 } else { on[k + 1] - off[k] };
        let joined = next != null && g < 0.001;
        let d = written_at.d1[k];
        let own = if contains(keys(n.data), "play") { merge(unplanned, n.data.play) } else { unplanned };
        // Most notes carry no marks: they skip the searches.
        let m = marks[k];
        let slurred_next = joined && marks[k + 1].slur;
        let refuse = own.breath == false || m.no_breath;
        let row = table[rows[k]];
        let weight = weight_in(row, n.at);
        let step = if next == null { 0 } else { next.pitch - n.pitch };
        // The performed length, as `sounding` gates it: a player spends air only
        // while the note sounds, and the silence a staccato leaves is time to
        // breathe in.
        let gate = if m.staccato { 0.5 } else { if slurred_next || m.tenuto { 1 } else { n.gate } };
        let sounded = s * min(1, gate);
        let mark = own.breath == true || m.breath;
        // A place to breathe, ranked as a listener groups a line: after a long
        // note before shorter ones, at a rest, at a register leap (Lerdahl and
        // Jackendoff 1983, A Generative Theory of Tonal Music, grouping
        // preference rules 2 and 3), at a phrase mark or after a note on a
        // strong beat; never inside a slur unless nothing else is left.
        let score = if next == null { 0 } else {
            (if m.phrase { 2.5 } else { 0 })
            + (if s >= 1.4 * (off[k + 1] - on[k + 1]) { 1 } else { 0 })
            + (if weight >= 0.6 && n.duration >= 1b && s >= 0.4 { 0.8 } else { 0 })
            + min(0.5, abs(step) / 14)
            + (if g > 0 { 1.5 } else { 0 })
            - (if joined && s < 0.25 { 1.5 } else { 0 })
            - (if slurred_next { 6 } else { 0 })
            - (if refuse { 20 } else { 0 })
        };
        {
            k: k, seconds: s, gap: g, joined: joined, dynamic: d, weight: weight, step: step,
            // In beats, for the phrase boundaries: the time to the next attack
            // (the last note's own length) and the rest before it.
            ioi: (if next == null { n.duration } else { next.at - n.at }) / row.beat,
            rest: if g < 0.0001 || next == null { 0 } else { max(0, (next.at - n.at - n.duration) / row.beat) }, staccato: m.staccato,
            four: weight == 1 && round((n.at - row.start) / row.length) % 4 == 0,
            sounded: sounded, quiet: s - sounded + (if next == null { 0 } else { g }), cost: sounded * flows[k],
            forced: next != null && !refuse && (mark || g >= pl.rest_breath), mark: mark,
            score: score, slur: slurred_next, slurred: m.slur, phrase_mark: m.phrase,
            shift: own.shift / 1s, peak_mark: m.peak, refuse: refuse,
            accepts: if m.superhuman { true } else { own.accept },
            cross: next != null && registers[k + 1] != registers[k],
            // How the phrase picks its peak: the highest, loudest, longest note on a strong beat, or a mark.
            prominence: n.pitch + 12 * d + 3 * min(s, 1) + 2 * weight + if m.peak { 1000 } else { 0 }
        }
    });
    // --- pass 1: where to breathe -------------------------------------------------
    // Walk the line spending air. A rest or a mark is breathed at once. Other
    // places wait on a stack, best first (`rank` grows with the air already
    // spent, so a later place wins a tie); when a note would overdraw the breath
    // (or hold it past `stale`), the best place before it is taken. `a` is the
    // air spent and `t` the seconds of air held since the line began; a breath
    // sets the bases `a0` and `t0` they count from, so a breath taken back at an
    // earlier place needs no replay of the notes since.
    //
    // Air is spent only while a note sounds. The time held counts the silences
    // that are no breath (an articulation gap, a rest too short to breathe in)
    // at `1 - relief`: they give no air, but the player lets a little stale air
    // out.
    //
    // A breath has `time` (the silence after the note, `take` of the note and
    // the next entry's lateness). A full breath lets out what has gone stale and
    // fills what is spent: it needs `exhale * stale + inhale * room`, `stale`
    // and `spent` being the parts of their limits used and `room` the part of
    // the lungs then empty. A shorter one is the same breath scaled down, an
    // exhale and a quick sip, and renews that part of both: its `refill`.
    // Oboists usually exhale before they inhale, and mark places to exhale and
    // inhale, only inhale, or only exhale (Carr 2012, "Exercises for oboists",
    // The Instrumentalist). Their breath pauses in running music are about 0.3 s
    // (Fuks and Sundberg 1998, "Respiratory inductive plethysmography
    // measurements on professional reed woodwind instrument players", KTH
    // TMH-QPSR 39). So when a breath is for stale air and an exhale alone would
    // renew more of it, the player only exhales (`kind` "exhale"), keeping
    // `exhale_keep` of the air.
    fn breath_at(st, c, reason) {
        let quiet = c.quiet;
        let take = if quiet >= need { 0 } else { min(c.sounded * pl.take, need - quiet) };
        let late = (if c.joined { late_ms } else { 0 }) + max(0, min(late_more, need - quiet - take));
        let time = quiet + take + late;
        let used = min(cap, max(0, c.a - st.a0));
        let held = max(0, c.t - st.t0);
        let stale = min(1, held / stale_cap);
        let spent = used / cap;
        let full = pl.exhale * stale + pl.inhale * (spent + stale * (1 - spent));
        let q = if full <= 0 { 1 } else { min(1, time / full) };
        // An exhale alone lets out `x` of the stale air, which is `stale` of what
        // is still in the lungs, and only as much as leaves `exhale_keep`.
        let vent = pl.exhale * stale;
        let most = if stale <= 0 || used >= cap { 0 } else { max(0, (cap * (1 - pl.exhale_keep) - used) / (stale * (cap - used))) };
        let x = if vent <= 0 { 0 } else { min(1, min(most, time / vent)) };
        let exhale = reason == "stale" && x > q;
        merge(c, {take: take, late: late, time: time, why: reason, exhale: exhale,
            refill: if exhale { x } else { q }, full: if exhale { vent } else { full },
            a0: c.a - (if exhale { used + x * stale * (cap - used) } else { used * (1 - q) }), t0: c.t - held * (1 - if exhale { x } else { q })})
    }
    fn breathe(st, c, reason) {
        let b = breath_at(st, c, reason);
        merge(st, {a0: b.a0, t0: b.t0, breaths: st.breaths + [b], stack: filter(st.stack, fn(x) => x.k > c.k), from: c.k + 1, flagged: false})
    }
    fn short(s) = s.a - s.a0 > cap || s.t - s.t0 > stale_cap;
    let unrelieved = 1 - pl.relief;
    // The limit that is reached: the air, or the time it may be held.
    fn binding(s) = if (s.a - s.a0) / cap >= (s.t - s.t0) / stale_cap { "air" } else { "stale" };
    let planned = fold(range(count), {a: 0, t: 0, a0: 0, t0: 0, stack: [], breaths: [], from: 0, flagged: false, over: [], spent: []}, fn(st0, k) => {
        let f = facts[k];
        let st1 = merge(st0, {a: st0.a + f.cost, t: st0.t + f.sounded});
        let st2 = if st1.a - st1.a0 <= cap && st1.t - st1.t0 <= stale_cap { st1 } else {
            let relieved = fold(range(4), st1, fn(s, i) => if short(s) && len(s.stack) > 0 { breathe(s, s.stack[0], binding(s)) } else { s });
            if !relieved.flagged && short(relieved) {
                merge(relieved, {flagged: true, over: relieved.over + [{from: relieved.from, k: k, why: binding(relieved)}]})
            } else { relieved }
        };
        let t = st2.t + f.quiet * unrelieved;
        let spent = st2.spent + [[st2.a, st2.t]];
        if k + 1 >= count { merge(st2, {spent: spent}) } else {
            let c = merge(f, {a: st2.a, t: t, rank: f.score + 1.5 * st2.a / cap});
            if f.forced { merge(breathe(st2, c, if f.mark { "mark" } else { "rest" }), {stack: [], t: t, spent: spent}) } else {
                merge(st2, {stack: filter(st2.stack, fn(x) => x.rank > c.rank) + [c], t: t, spent: spent})
            }
        }
    });
    let none = record(map(range(count), fn(k) => [str(k), null]));
    let by_k = merge(none, index_by(planned.breaths, fn(b) => str(b.k)));
    let after = map(range(count), fn(k) => by_k[str(k)]);
    let issues = unplayable_in(notes, facts, planned, on, off, spec, pl, o, cap);
    let open = filter(issues, fn(x) => !x.accepted);
    let checked = assert(!o.strict || len(open) == 0, "unplayable as written; pass `accept` (or tag the notes `superhuman`) to play it anyway, or `strict: false` to warn:\n"
        + join(map(open, fn(x) => "  " + x.message), "\n"));
    let found = if len(issues) == 0 { {} } else { merge(none, record(map(group_by(issues, fn(x) => x.k), fn(g) => [str(g[0].k), g]))) };
    // --- phrases ------------------------------------------------------------------
    // Where a listener hears one phrase end and the next begin. Each join of
    // two notes gets a boundary strength, and the line is cut at the best set
    // of joins. The cues are the grouping preference rules of Lerdahl and
    // Jackendoff (1983, A Generative Theory of Tonal Music): a rest or the end
    // of a slur (GPR 2a), a long time between attacks (2b), a leap (3a), a
    // change of dynamic (3b) or articulation (3c), a cadence, a long note
    // arriving on a strong beat (GPR 7), and groups of four bars (GPR 5,
    // symmetry; Temperley's metrical parallelism, below). Rests, inter-onset
    // times and leaps count as in Cambouropoulos's Local Boundary Detection
    // Model (2001, "The Local Boundary Detection Model (LBDM) and its
    // application in the study of expressive timing", ICMC): each by its size
    // times how far it differs from its neighbours, so an ostinato's regular
    // rests are no boundary. Sizes are in beats of the meter (a dotted quarter
    // in 6/8), not seconds, so a cadence rest is one at any tempo. A change of
    // meter or tempo marks a new section. A slur is never cut unless a
    // `phrase` mark says so. A planned breath is a weak boundary: it helps
    // choose among others but alone ends nothing (a player breathes where the
    // air runs out as well as where phrases end). Phrases last `min` to `max`
    // seconds where the music allows (GPR 1, no tiny groups; the KTH
    // Phrase-arch rule shapes phrases and subphrases of a few seconds: Friberg
    // 1995, "Matching the rule parameters of Phrase arch to performances of
    // Träumerei", KTH STL-QPSR 36(2-3)).
    let ph = o.phrasing;
    fn change(x, y) = if x + y <= 0 { 0 } else { abs(x - y) / (x + y) };
    let joins = max(0, count - 1);
    let decisive = ph.rest_beats;
    let d0 = written_at.d0;
    let d1 = written_at.d1;
    // A join's strength: 1000 if decisive, -10 inside a slur, else the cues.
    // `e`, `f` and `g` are the notes before, at and after the join. A rest,
    // a time between attacks no longer than its neighbours' or a leap under a
    // fourth adds nothing (each counts in LBDM by its size times its change,
    // |a - b| / (a + b), from each neighbour).
    let w_rest = ph.rest;
    let w_ioi = ph.ioi;
    let w_leap = ph.leap;
    let w_cadence = ph.cadence;
    let w_dynamics = ph.dynamics;
    let w_articulation = ph.articulation;
    let w_hyper = ph.hyper;
    let w_meter = ph.meter;
    let w_tempo = ph.tempo;
    let w_mark = ph.mark;
    let w_breath = ph.breath;
    let strength = map(range(joins), fn(k) => {
        let f = facts[k];
        if f.slur { if f.phrase_mark { 1000 } else { 0 - 10 } } else { if f.phrase_mark || f.rest >= decisive { 1000 } else {
            let g = facts[k + 1];
            let e = if k == 0 { f } else { facts[k - 1] };
            let x = f.ioi;
            let r = f.rest;
            let leap = abs(f.step);
            let dd = abs(d0[k + 1] - d1[k]);
            (if r == 0 { 0 } else { w_rest * min(4, r * (change(e.rest, r) + change(r, g.rest))) })
                + (if x <= e.ioi && x <= g.ioi { 0 } else { w_ioi * min(4, x * (abs(e.ioi - x) / (e.ioi + x) + abs(x - g.ioi) / (x + g.ioi))) })
                + (if leap < 5 { 0 } else { w_leap * leap / 12 * (abs(abs(e.step) - leap) / (abs(e.step) + leap) + abs(leap - abs(g.step)) / (leap + abs(g.step))) })
                + (if x < 1 || x < 1.5 * e.ioi || f.weight < 0.6 { 0 } else { w_cadence })
                + (if dd < 0.01 { 0 } else { w_dynamics * min(1, dd / 0.15) })
                + (if f.slurred || f.staccato != g.staccato { w_articulation } else { 0 })
                // At a bar line: four bars, a new meter, a new tempo.
                + (if g.weight < 1 { 0 } else { (if g.four { w_hyper } else { 0 })
                    + (if rows[k + 1] == rows[k] { 0 } else { if table[rows[k + 1]].meter != table[rows[k]].meter { w_meter } else { 0 } })
                    + (if abs(f.seconds * notes[k + 1].duration - g.seconds * notes[k].duration) > 0.05 * f.seconds * notes[k + 1].duration { w_tempo } else { 0 }) })
                + (if f.mark { w_mark } else { 0 }) + (if after[k] == null { 0 } else { w_breath })
        } }
    });
    // The cuts are the best set over the whole line, found by dynamic
    // programming as Temperley's Grouper finds phrases (Temperley 2001, The
    // Cognition of Basic Musical Structures, ch. 3): each cut earns its
    // strength less `threshold`, and a phrase costs nothing from `min` to
    // `max` seconds and more the further it falls outside. Only joins of at
    // least 0.5 that are stronger than both neighbours are candidates (as
    // LBDM picks its peaks), and a decisive one is always cut.
    let boundaries = strength + [null];
    let candidates = filter(filter(range(joins), fn(k) => strength[k] >= 0.5), fn(k) => {
        let b = strength[k];
        b >= 1000 || (k == 0 || b >= strength[k - 1]) && (k + 1 >= joins || b >= strength[k + 1])
    });
    // Nodes: the line's start, the candidates, its end. A phrase runs from the
    // start after one node to the end of the next.
    let nodes = if count == 0 { [] } else { [0 - 1] + candidates + [count - 1] };
    let last_node = len(nodes) - 1;
    let starts = map(range(last_node), fn(i) => on[nodes[i] + 1]);
    let ends = map(nodes, fn(k) => if k < 0 { 0 } else { off[k] });
    // For each node, the first node whose phrase to it would last at most
    // `max`, and the first that would last under `min`.
    // (Curve positions start at 0: all are moved `max` + 1 on.)
    let lift = ph.max + 1;
    let index_of = {shape: "step", points: [[0, 0]] + map(range(last_node), fn(i) => [starts[i] + lift, i + 1])};
    let longest = curve_value(index_of, map(ends, fn(e) => e + 0.999999));
    let shortest = curve_value(index_of, map(ends, fn(e) => e - ph.min + lift));
    // A phrase lasts from `min` to `max` at no cost, so the best place for the
    // phrase ending at a node to start is the best score in a window of nodes
    // that only moves forward: a queue of nodes in falling order of score
    // (`entered`: the next node to join it). With none in the window, the
    // phrase runs just past `max` at a cost, or, after a decisive cut that
    // leaves no room, falls short of `min` at a cost.
    let best = fold(range(1, last_node + 1), {score: [0], back: [0], wall: 0, queue: [], entered: 0}, fn(st, j) => {
        let e = ends[j];
        let a = max(st.wall, round(longest[j]));
        let b = max(a, round(shortest[j]));
        let score = st.score;
        let kept = if len(st.queue) == 0 || st.queue[0] >= a { st.queue } else { filter(st.queue, fn(q) => q >= a) };
        let queue = fold(range(max(st.entered, a), b), kept, fn(d, i) => filter(d, fn(q) => score[q] >= score[i]) + [i]);
        let from = if len(queue) > 0 { {s: score[queue[0]], i: queue[0]} } else { if a > st.wall {
            {s: score[a - 1] + 2 - 2 * (e - starts[a - 1]) / ph.max, i: a - 1}
        } else { {s: score[a] - 6 + 6 * (e - starts[a]) / ph.min, i: a} } };
        let gain = if j == last_node { 0 } else { strength[nodes[j]] - ph.threshold };
        {score: score + [from.s + gain], back: st.back + [from.i], wall: if gain >= 900 { j } else { st.wall }, queue: queue, entered: max(st.entered, b)}
    });
    let cuts = if count == 0 { [] } else {
        fold(range(last_node), {at: last_node, cuts: []}, fn(st, x) => if st.at == 0 { st } else {
            let i = best.back[st.at];
            {at: i, cuts: if i == 0 { st.cuts } else { [nodes[i]] + st.cuts }}
        }).cuts
    };
    // Each note's phrase: how many cuts come before it.
    let phrase_of = if len(cuts) == 0 { map(range(count), fn(k) => 0) } else {
        map(curve_value({shape: "step", points: [[0, 0]] + map(range(len(cuts)), fn(i) => [cuts[i] + 1, i + 1])}, range(count)), fn(x) => round(x))
    };
    // Phrases: their span in seconds, their peak, and how they end.
    let groups = group_by(range(count), fn(k) => phrase_of[k]);
    let phrases = map(range(len(groups)), fn(j) => {
        let g = groups[j];
        let first = g[0];
        let last = g[len(g) - 1];
        let t0 = on[first];
        let t1 = off[last];
        let peak = fold(g, [first, 0 - 1000000], fn(best, k) => { let q = facts[k].prominence; if q >= best[1] { [k, q] } else { best } })[0];
        let length = max(t1 - t0, 0.001);
        // A phrase that ends in a running line (at a breath, or split there)
        // slows less than one that ends at a rest.
        let ending = if facts[last].joined { 0.5 } else { 1 };
        let span = min(o.final_span, on[last] - t0);
        {
            j: j, first: first, last: last, peak_k: peak, t0: t0, t1: t1, length: length, ending: ending, span: span, from: on[last] - span,
            slowing: o.final * span * ending,
            peak: clamp((on[peak] + facts[peak].seconds / 2 - t0) / length, 0.15, 0.85),
            depth: if last == first { 0 } else { o.arc * min(1, length / 1.5) }
        }
    });
    // The arch (Todd 1992, "The dynamics of dynamics: a model of musical
    // expression", JASA 91:3540-3550; the KTH Phrase-arch rule): the breath
    // starts `arc` under the written dynamic, rises to `arc` over it at the
    // peak and falls to 1.3 times `arc` under it at the end. The written
    // dynamic stays the reference, as in the KTH rules, whose arches are
    // deviations from the nominal level: each slope stays within `arc_reach`
    // seconds of the phrase's start, peak or end, so a long phrase plays at its
    // written dynamic in between instead of sinking along one slow fall.
    // The phrases' arches are one smooth curve, each phrase in a stretch of its
    // own (`window` seconds), evaluated at each note's attack, middle and end.
    let window = 100000;
    let reach = o.arc_reach;
    let arches = {shape: "smooth", points: fold(phrases, [], fn(out, p) => {
        let x = p.j * window;
        let top = p.peak * p.length;
        out + (if p.depth == 0 { [[x * 1s, 0], [(x + p.length) * 1s, 0]] } else {
            [[x * 1s, 0 - p.depth]] + (if top > 2 * reach { [[(x + reach) * 1s, 0], [(x + top - reach) * 1s, 0]] } else { [] })
                + [[(x + top) * 1s, p.depth]]
                + (if p.length - top > 2 * reach { [[(x + top + reach) * 1s, 0], [(x + p.length - reach) * 1s, 0]] } else { [] })
                + [[(x + p.length) * 1s, p.depth * (1 - 2.3)]]
        })
    })};
    fn arc_at(p, t) = if p.depth == 0 { 0 } else { curve_value(arches, p.j * window + max(0, min(p.length, t - p.t0))) };
    let placed = map(range(count), fn(k) => phrase_of[k] * window + on[k] - phrases[phrase_of[k]].t0);
    let arc0 = curve_value(arches, placed);
    let arc1 = curve_value(arches, map(range(count), fn(k) => placed[k] + facts[k].seconds / 2));
    let arc2 = curve_value(arches, map(range(count), fn(k) => placed[k] + facts[k].seconds * 63 / 64));
    // --- timing -------------------------------------------------------------------
    // Shared drift (the ensemble's), the chair's own, a little motor noise, the
    // chair's lead; then a late entry after a breath (caught up over half a second),
    // lateness on a slurred leap, a late ku, and the phrase's final slowing
    // (Friberg and Sundberg 1999, "Does music performance allude to locomotion? A
    // model of final ritardandi derived from measurements of stopping runners",
    // JASA 105:1469-1484). A player's timing is a slow timekeeper plus motor
    // noise (Wing and Kristofferson 1973, "Response delays and the timing of
    // discrete motor responses", Perception & Psychophysics 14:5-12), and
    // ensemble leads and asynchronies of a few tens of milliseconds are normal
    // (Rasch 1979, "Synchronization in performed ensemble music", Acustica
    // 43:121-131).
    let ens = o.ensemble;
    let ens_drift = ens.drift / 1s * 1.05;
    let chair_drift = o.drift / 1s * 1.6;
    let jitter = o.jitter / 1s * 1.7;
    let leap_late = o.leap_late / 1s;
    let leap_gap = o.leap_gap / 1s;
    let ku_late = o.tongue.k_late / 1s;
    let lead = o.lead / 1s;
    // drift_at's two layers and the chair's slow noise, for every attack at once.
    let ens_slow = noise_at(on, ens.scale, ["ensemble", 0], ens.seed);
    let ens_slower = noise_at(on, ens.scale * 4, ["ensemble", 1], ens.seed);
    let chair = noise_at(on, o.drift_scale, "chair", o.seed);
    let double = pl.double;
    let double_rate = pl.double_rate;
    let full_air = pl.air;
    let full_stale = pl.stale;
    // --- the plan, note by note ---------------------------------------------------
    // Each note keeps the breath before it (and where the line went on after
    // it), its place in a run of fast tongued notes, the air left at its end,
    // and its attack's shift in time.
    let walked = fold(range(count), {breath: null, run: -1, out: []}, fn(st, k) => {
        let f = facts[k];
        let pf = if k == 0 { null } else { facts[k - 1] };
        let b = if k == 0 { null } else { after[k - 1] };
        let cut = b != null || pf != null && pf.phrase_mark;
        let breath = if b == null { st.breath } else { b };
        let t = on[k];
        let rate = 1 / max(0.02, if k + 1 < count { f.seconds + f.gap } else { if k > 0 { t - on[k - 1] } else { f.seconds } });
        let run = if rate >= double_rate && (k == 0 || cut || !f.slurred) { if cut { 0 } else { st.run + 1 } } else { -1 };
        let spent = planned.spent[k];
        let air = if breath == null { min(1 - spent[0] / full_air, 1 - spent[1] / full_stale) } else {
            min(1 - (spent[0] - breath.a0) / full_air, 1 - (spent[1] - breath.t0) / full_stale)
        };
        let phrase = phrase_of[k];
        let p = phrases[phrase];
        let step = if pf == null || !pf.joined { 0 } else { abs(pf.step) };
        let shift = (ens_slow[k] + ens_slower[k] * 2) * ens_drift + chair[k] * chair_drift + keyed_noise(ids[k], o.seed, "attack") * jitter + lead + f.shift
            + (if breath == null { 0 } else { breath.late * pow(0.25, (t - on[breath.k + 1]) * 2) })
            + (if step <= 4 { 0 } else {
                min(1, (step - 4) / 8) * leap_late * (if pf.step > 0 { 1 } else { 0.5 })
                    * (if pf.cross { 1.5 } else { 1 }) * (if f.slurred { 1 } else { 0.5 })
            })
            + (if double && run % 2 == 1 { ku_late } else { 0 })
            + (if t <= p.from { 0 } else { p.slowing * pow((t - p.from) / p.span, 2) });
        {breath: breath, run: run, out: st.out + [{air: air, rate: rate, run: run, phrase: phrase, before: breath, shift: shift}]}
    }).out;
    let shift = map(walked, fn(w) => w.shift);
    // --- pass 2: each note ------------------------------------------------------------
    let level_of = if o.level == null { null } else { if callable(o.level) { o.level } else {
        let tagged = keys(o.level);
        fn(n) => if len(n.tags) == 0 { 1 } else { fold(tagged, 1, fn(f, t) => if contains(n.tags, t) { f * o.level[t] } else { f }) }
    } };
    let into = pl.intonation;
    let arc_scale = 0.35 / max(o.arc, 0.001);
    let tendency = sampled(into.register, map(notes, fn(n) => n.pitch));
    let tune_dynamic = into.dynamic;
    let tune_scatter = into.scatter;
    let style = spec.style;
    let soft_all = if callable(o.soft) { null } else { o.soft };
    let own_rule = o.rule == null;
    let clean = len(issues) == 0;
    let patches = map(range(count), fn(k) => {
        let n = notes[k];
        let f = facts[k];
        let w = walked[k];
        let p = phrases[w.phrase];
        let prev = if k > 0 { notes[k - 1] } else { null };
        let next = if k + 1 < count { notes[k + 1] } else { null };
        let before = if k > 0 { after[k - 1] } else { null };
        // The note after a breath is tongued even if marked slurred.
        let has = if before == null { marked } else { fn(x, rule) => if rule == "slur" && x.key == n.key { false } else { marked(x, rule) } };
        let step_in = if prev == null || !facts[k - 1].joined { null } else { facts[k - 1].step };
        // Breath added into an upward leap (toward the note's end) and on its
        // landing (at the start), and a breath nearly spent pushed and wavering.
        let rise = if f.joined && f.step >= 5 { o.support * min(1, f.step / 12) } else { 0 };
        let land = if step_in != null && step_in >= 5 { o.support * min(1, step_in / 12) } else { 0 };
        let tired = if w.air >= 0.25 { 0 } else { min(1, (0.25 - w.air) * 4) };
        fn worn(ts) = tired * o.support * 0.5 + tired * 0.025 * smooth_noise(ts, 0.3, "wobble", o.seed);
        fn shaped(t, written_here) {
            let x = max(0, min(1, (t - n.at) / n.duration));
            // Seconds within the note are taken as straight in score time.
            let ts = on[k] + (t - n.at) / n.duration * f.seconds;
            max(0.1, min(1, written_here * (1 + arc_at(p, ts)) + rise * max(0, x - 0.6) * 2.5 + land * max(0, 1 - x * 3.333) + if tired > 0 { worn(ts) } else { 0 }))
        }
        // The rules ask at the attack, the middle and just before the end: those
        // are worked out once (`shaped` at x = 0, 1/2 and 63/64).
        let t1 = mids[k];
        let t2 = tails[k];
        let fresh = tired == 0;
        let d0 = max(0.1, min(1, written_at.d0[k] * (1 + arc0[k]) + land + if fresh { 0 } else { worn(on[k]) }));
        let mid = max(0.1, min(1, written_at.d1[k] * (1 + arc1[k]) + if fresh { 0 } else { worn(on[k] + f.seconds / 2) }));
        let d2 = max(0.1, min(1, written_at.d2[k] * (1 + arc2[k]) + rise * 0.9609375 + if fresh { 0 } else { worn(on[k] + f.seconds * 63 / 64) }));
        fn dynamic(t) = if t == n.at { d0 } else { if t == t1 { mid } else { if t == t2 { d2 } else { shaped(t, written(k)(t)) } } };
        let c = {
            next: next, prev: prev, seconds: f.seconds, dynamic: dynamic, attack: d0, middle: mid, ending: d2, has: has, marks: if before != null && marks[k].slur { merge(marks[k], {slur: false}) } else { marks[k] }, style: style, soft: if soft_all == null { o.soft(n) } else { soft_all },
            interval: if f.joined { f.step } else { null }, interval_in: step_in,
            crosses_break: f.cross, breaks_in: step_in != null && facts[k - 1].cross,
            phrase_pos: max(0, min(1, (on[k] - p.t0) / p.length)), phrase_first: k == p.first, phrase_last: k == p.last,
            metric_weight: f.weight, note_rate: w.rate, air_left: w.air, breath_before: before, breath_after: after[k], slurs_on: f.slur && after[k] == null,
            intensity: max(0, min(1, 0.25 + arc1[k] * arc_scale + mid * 0.5)),
            run: w.run, repeat: prev != null && prev.pitch == n.pitch && (!f.slurred || before != null),
            tuning: tendency[k] + tune_dynamic * (mid - 0.5) + tune_scatter * keyed_noise(ids[k], o.seed, "tuning"),
            player: pl, options: o
        };
        let r = rule(n, c);
        // Release: in a running line it follows the next note's attack (a slur
        // keeps its overlap, a tongued note its gap); a breath takes its time
        // from the note; a phrase's last note is held a little longer.
        // `phrased` returns every field; another rule may leave some out.
        let gate = if own_rule { r.gate } else { merge({gate: n.gate}, r).gate };
        let held = sec(n.at + n.duration * gate);
        let end = held + (if own_rule { r.release_offset } else { merge({release_offset: n.release_offset}, r).release_offset }) / 1s;
        let b = after[k];
        // A phrase's last note before a rest is held a little into it: `hold` of
        // its length, at most `hold_max`. Never past the next bar line or the
        // part's next entry, nor more than half the rest, and `hold_section` as
        // long before a rest that leads into a new section (the part rests
        // across the bar line, or stops). The phrase's lengthening is mostly in
        // its timing (the final slowing); a note before a rest touches the rest
        // rather than overlapping what follows (KTH Final-ritard and Punctuation
        // rules, Friberg, Bresin and Sundberg 2006; Penel and Drake 1998, "Sources
        // of timing variations in music performance", Psychological Research 61).
        let hold = if k == p.last && gate > 0.6 && !f.joined {
            let written_end = n.at + n.duration;
            let row_k = if rows[k] + 1 < len(table) && written_end >= table[rows[k] + 1].start { rows[k] + 1 } else { rows[k] };
            let row = table[row_k];
            let bar = min(row.start + ceil((written_end - row.start) / row.length) * row.length,
                if row_k + 1 < len(table) { table[row_k + 1].start } else { written_end + row.length });
            let section = next == null || next.at > bar;
            let limit = min(sec(bar), if next == null { 1000 } else { on[k + 1] }) - (end + shift[k]);
            max(0, min(min(o.hold * f.seconds * gate, o.hold_max) * (if section { o.hold_section } else { 1 }),
                min(limit, if next == null { 1000 } else { f.gap * 0.5 })))
        } else { 0 };
        let target = if b != null {
            if f.joined { min(end, off[k] - b.take) + shift[k + 1] - b.late } else {
                end + shift[k] + min(hold, max(0, (f.gap - need) * 0.5))
            }
        } else { if f.joined {
            end + shift[k + 1] - (if abs(f.step) >= 5 && !f.slur { leap_gap } else { 0 })
        } else { end + shift[k] + hold } };
        let release = max(target - held - shift[k], 0.02 - (held - on[k]));
        let data = if own_rule { r.data } else { merge(n.data, merge({data: {}}, r).data) };
        let ex = if own_rule { data.expression } else { merge({expression: {}}, data).expression };
        let by = if level_of == null { 1 } else { level_of(n) };
        let expression = if by == 1 { ex } else {
            let v = merge({volume: 1}, ex).volume;
            merge(ex, {volume: if listed(v) { scaled(v, by) } else { v * by }})
        };
        let issues_here = if clean { null } else { found[str(k)] };
        let plan = {phrase: w.phrase, boundary: boundaries[k], air: w.air, peak: k == p.peak_k, issues: if issues_here == null { [] } else { issues_here }, breath: if b == null { null } else {
            // The inhale: it ends at the next performed attack.
            {kind: if f.forced { if f.mark { "mark" } else { "rest" } } else { if b.exhale { "exhale" } else { if f.slur { "slur" } else { "planned" } } },
             why: b.why, refill: b.refill, seconds: min(b.full, b.time), at: next.at / 1b, offset: shift[k + 1]}
        }};
        merge(r, {
            gate: gate, offset: n.offset + shift[k] * 1s, release_offset: release * 1s,
            data: merge(data, {expression: expression, plan: plan})
        })
    });
    pattern.map_notes(fn(n) => patches[order[n.key]])
}

// The unplayable material `play` found in a part, as its records (see
// `unplayable_in`), accepted ones included: `unplayable(played)`.
fn unplayable(played) = fold(sort_by(played.notes, fn(n) => n.at), [], fn(out, n) =>
    out + merge({plan: {issues: []}}, n.data).plan.issues);
// A track check reporting what `play` (with `strict: false`) found unplayable
// and was not accepted: `track("fl", line, w.flute(), {checks: [w.playable()]})`.
// `level` "error" fails compilation.
fn playable(level = "warning") {
    fn playable(notes) = fold(sort_by(notes, fn(n) => n.at), [], fn(out, n) => {
        let found = filter(merge({plan: {issues: []}}, n.data).plan.issues, fn(x) => !x.accepted);
        out + map(found, fn(x) => {code: "woodwinds." + x.code, message: x.message, at: n.at, severity: level})
    });
    playable
}
