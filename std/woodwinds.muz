    firm: {burst: 85ms, release: 3ms, back: 0},
    light: {burst: 20ms, release: 3ms, back: 0},
    da: {burst: 60ms, release: 12ms, back: 0},
    ku: {burst: 25ms, release: 4ms, back: 1}
};
// A tone's loudness against its length, in dB under a long one's, as a
