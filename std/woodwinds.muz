// The weight of a score position's place in its bar: 1 on the downbeat, 0.6 at
// the middle of an even bar, 0.4 on other beats, 0.2 on half beats, else 0.1.
// The row of `table` holding each of `positions`, in one step curve evaluation.
fn rows_at(table, positions) = if len(table) == 1 { map(positions, fn(p) => 0) } else {
    if len(filter(range(1, len(table)), fn(i) => table[i].start <= table[i - 1].start)) > 0 {
        // Out of order (or before 0b): a search for each position.
        map(positions, fn(p) => max(0, len(filter(table, fn(row) => row.start <= p)) - 1))
    } else {
        map(curve_value({points: map(range(len(table)), fn(i) => [table[i].start, i]), shape: "step"}, positions), fn(x) => round(x))
    }
};
// The weight of a position in its bar, from its row of `bar_table`.
fn weight_in(row, at) {
    let beats = (at - row.start) * row.unit / 4b;
    let m = row.meter[0];
    let x = if beats >= 0 { beats % m } else { beats - floor(beats / m) * m };
    if x == 0 { 1 } else { if x == row.half { 0.6 } else { if x == floor(x) { 0.4 } else { if x * 2 == floor(x * 2) { 0.2 } else { 0.1 } } } }
}
fn metric_weight(at, meters = [], meter = [4, 4]) {
    let table = bar_table(meters, meter);
    weight_in(table[rows_at(table, [at])[0]], at)
}

let play_defaults = {
    timing: {}, dynamics: null, tags: {}, soft: false, level: null, seed: 0, meters: [], meter: [4, 4],
    player: {}, // changes to the spec's player
    arc: 0.1, // the phrase arch: the breath rises this part toward the peak and falls past it ...
    arc_reach: 4, // ... within this many seconds of the phrase's start, peak and end; between, the written dynamic
    // Where phrases end (see "Phrases" in the player's notes): each join of two
    // notes gets a boundary strength from what a listener hears there, with
    // these weights; rests and lengths are in beats.
    phrasing: {
        rest: 1, // a rest, by its length and how it stands out from the rests around it
        ioi: 0.5, // a long time from one attack to the next among shorter ones
        leap: 0.25, // a leap (in octaves) among smaller intervals
        cadence: 0.75, // a note of at least a beat on a strong beat, longer than the one before
        dynamics: 0.75, // a step in the written dynamic (full at 0.15)
        articulation: 0.25, // staccato to legato or back, or the end of a slur
        meter: 1, // a change of meter ...
        tempo: 1, // ... and a sudden change of tempo (5 % or more) at a bar line: a new section
        hyper: 0.6, // a bar line that starts a group of four bars (counted from the last change of meter)
        breath: 0.5, // a breath the player plans there
        mark: 1, // a written `breath` mark
        threshold: 1.25, // a boundary stronger than this is worth ending a phrase at ...
        min: 2.5, // ... unless the phrase would be shorter than this many seconds ...
        max: 16, // ... and a phrase longer than this many seconds is worth splitting at a weaker one
        rest_beats: 2 // a rest of this many beats always ends one, as does a `phrase` mark
    },
    final: 0.04, // a phrase slows into its end: its last note comes this part of `final_span` late (at a beat of 1 s; less at a faster one)
    final_span: 1.2, // seconds
    hold: 0.12, // and, before a rest, is held this part of its length longer ...
    hold_max: 0.3, // ... at most this many seconds, and never past the next bar line or entry
    hold_section: 0.5, // the hold before a rest into a new section (across a bar line, or the end)
    drift: 4ms, // the player's own slow drift in time (rms) ...
    drift_scale: 1.5, // ... changing over about this many seconds
    jitter: 1ms, // independent motor noise on each attack (rms)
    // A tempo drift shared by every part with this seed. In `ensemble`: a
    // cadence's slowing eases back over `recover` beats; an entry takes `cue`
    // of the way to the ensemble's drift; two players' planned attacks differ
    // by `asynchrony` (standard deviation, at crotchet = 88; less at a faster
    // beat), which with the models' own variation in speaking makes Rasch's
    // audible 32 ms (tools/woodwinds.py asynchrony); a part playing the tune
    // (`role` over 1) leads by `melody`.
    ensemble: {seed: 0, drift: 7ms, scale: 3, recover: 1, cue: 0.75, asynchrony: 25ms, melody: 7ms},
    lead: 0ms, // this chair plays ahead (negative) or behind the ensemble
    anticipate: true, // a tongued attack starts early by the instrument's speaking time (the profile's `speak`)
    role: 1, // in `ensemble`, the part's say in the shared timing: a number, [[position, role], ...] or a function of the note (a melody or lead 2, a part that only follows 0)
    leap_late: 8ms, // a slurred upward leap of an octave lands this late
    leap_gap: 6ms, // and a tongued leap is separated by this much more
    support: 0.06, // breath added before and into an upward leap, and at the end of a breath
    // The vocal tract (the note controls `voicing` and `tract`, 0.5 the
    // instrument's resting tract; see std/physical.wind_player). A leap up
    // across a register break, or of more than a fifth, starts with the
    // tongue raised, an "ee" (`up`: eight times the resting impedance, about
    // 10 MPa s/m^3 on a clarinet) and the tract tuned `tune` times the new
    // note; a slur down across a break starts with it lowered (`down`, half
    // the impedance); both relax over `hold`. From the profile's `altissimo`
    // pitch up the tract is tuned to the note throughout and `high` (eleven
    // times, about 14 MPa s/m^3) as strong. A "ku" starts with the back of the
    // tongue high: `ku` (twice) at `ku_tract` times the resting resonance,
    // relaxing over `ku_hold`. Clarinettists measured: an "ee" up to 18 MPa
    // s/m^3 at 560-1000 Hz, the altissimo up to 40 near the note (Fritz and
    // Wolfe 2005; Chen, Smith and Wolfe 2008, a resonance a little above the
    // note).
    voicing: {up: 0.875, down: 0.375, high: 0.9375, tune: 1.05, hold: 150ms, ku: 0.625, ku_tract: 0.7, ku_hold: 40ms},
    syllables: syllables, // the tongue's shapes, by name (see `syllables`)
    // Tonguing: firmer at a phrase's start (`phrase`) and on strong beats
    // (`metric`), lighter on a repeated note (`repeat`) and as the notes come
    // faster (`fast` per note a second over the profile's `tongue_fast`), and
    // there `light` per note a second toward the light syllable; a ku is `k`
    // as strong, and `k_late` later than written.
    tongue: {phrase: 1.15, metric: 0.2, repeat: 0.9, fast: 0.07, light: 0.25, k: 0.75, k_late: 0ms},
    // A short tongued note (under 0.3 s as it sounds) is blown harder by the
    // loudness it loses while it speaks (`short_loudness`, `integration` its
    // time constant): `breath` more dynamic for each dB, and tongued firmer,
    // `firm` dB making the stroke an accent's and adding `tongue` to its burst.
    // Players tongue short notes above the threshold so they speak sooner (Li,
    // Almeida, Smith and Wolfe 2016).
    short: {integration: 100ms, breath: 0.08, firm: 3, tongue: 0.3},
    rule: null, // (note, context) -> note patch; `phrased` by default
    part: null, // the part's name in reports (the spec's name by default)
    strict: true, // material no player could play as written is an error; false: a warning (see `playable`)
    accept: [] // codes of unplayable material to play anyway (true: all), as tagging the notes `superhuman` does
};

// --- What cannot be played as written ---------------------------------------------
//
// `play` checks the line against its player's `limits` and the spec's `range`.
// Each finding is {code, k (its first note), to (its last), message, accepted};
// codes are "range", "air" (no place to breathe in time), "slur_breath" (the
// only breath breaks a slur), "breath_time" (no time to take a useful breath),
// "tonguing", "slurred" (finger speed), "crossing" (slurs across a register
// break) and "slur_leap".
fn place_text(at, o) {
    let b = arr.bar_at(at, o.meters, o.meter);
    format("bar {} beat {}", [b.bar, round((b.position / (4b / b.meter[1]) + 1) * 1000) / 1000])
}
fn span_text(a, b, o) = if a == b { place_text(a, o) } else { place_text(a, o) + " to " + place_text(b, o) };
fn seconds_text(x) = str(round(x * 10) / 10) + " s";
// Two lengths of time to as many decimals (up to three) as tell them apart, so
// a shortfall shows: "0.18 s" against "0.21 s", not "0.2 s" against "0.2 s".
fn seconds_fine(x) = str(round(x * 100) / 100) + " s";
fn seconds_apart(a, b) {
    let d = if round(a * 10) != round(b * 10) { 10 } else { if round(a * 100) != round(b * 100) { 100 } else { 1000 } };
    [str(round(a * d) / d) + " s", str(round(b * d) / d) + " s"]
}
fn unplayable_in(notes, facts, planned, on, off, spec, pl, o, cap, dynamics, accepts_of, iois = null) {
    let count = len(notes);
    let lim = pl.limits;
    let part = if o.part == null { spec.name } else { o.part };
    fn name(k) = checks.pitch_name(notes[k].pitch);
    // The limit a breath ran into: how long it lasts at a note's dynamic, or
    // how long air can be held before it is stale.
    fn limit_text(why, k) = if why == "stale" {
        format("held air goes stale after about {}", [seconds_text(pl.stale * (1 - pl.reserve))])
    } else { format("a breath lasts about {} at this dynamic", [seconds_text(cap / lookup(pl.flow, dynamics[k]))]) };
    fn finding(code, k, to, message) = {code: code, k: k, to: to, message: part + ", " + span_text(notes[k].at, notes[to].at, o) + ": " + message};
    let compass = merge({range: null}, spec).range;
    let pitches = sort_by(map(notes, fn(n) => n.pitch), fn(x) => x);
    let ranged = if compass == null || count == 0 || pitches[0] >= compass[0] && pitches[count - 1] <= compass[1] { [] } else {
        let low = compass[0];
        let high = compass[1];
        map(filter(range(count), fn(k) => { let p = notes[k].pitch; p < low || p > high }), fn(k) => finding("range", k, k,
            format("{} is outside the {}'s range, {} to {}", [name(k), spec.name, checks.pitch_name(compass[0]), checks.pitch_name(compass[1])])))
    };
    let air = map(planned.over, fn(x) => finding("air", x.from, x.k, format(
        "{} from {} to {} with no place to breathe; {}", [seconds_text(off[x.k] - on[x.from]), name(x.from), name(x.k), limit_text(x.why, x.k)])));
    let bs = planned.breaths;
    // Breaths the plan could only take by breaking a slur (or a no-breath mark),
    // or with too little time; one finding for each stretch, however many
    // breaths it needed.
    fn joined(j) = facts[j].slur || facts[j].refuse;
    let raw = fold(range(len(bs)), [], fn(out, i) => {
        let b = bs[i];
        let since = if i == 0 { on[0] } else { on[bs[i - 1].k + 1] };
        let first = if b.slur || b.refuse { fold(range(b.k + 1), 0, fn(f, j) => if j > 0 && !joined(j - 1) { j } else { f }) } else { b.k };
        let last = if b.slur || b.refuse {
            fold(range(b.k + 1, count), {k: count - 1, done: false}, fn(r, j) => if !r.done && !joined(j) { {k: j, done: true} } else { r }).k
        } else { b.k + 1 };
        let item = {i: i, b: b, held: off[b.k] - since, first: first, last: last, n: 1};
        out + (if b.slur || b.refuse { [merge(item, {code: "slur_breath"})] } else { [] })
            + (if b.refill < lim.refill { [merge(item, {code: "breath_time"})] } else { [] })
    });
    let merged = fold(raw, [], fn(out, x) => {
        let same = filter(range(len(out)), fn(j) => out[j].code == x.code
            && (x.code == "slur_breath" && out[j].first == x.first || x.code == "breath_time" && out[j].i_last + 1 == x.i));
        if len(same) == 0 { out + [merge(x, {i_last: x.i})] } else {
            let j = same[0];
            map(range(len(out)), fn(m) => if m == j { merge(out[m], {last: max(out[m].last, x.last), n: out[m].n + 1, i_last: x.i}) } else { out[m] })
        }
    });
    let breaths = map(merged, fn(x) => {
        let b = x.b;
        let times = if x.n == 1 { "a breath" } else { str(x.n) + " breaths, the first" };
        if x.code == "slur_breath" {
            finding("slur_breath", x.first, x.last, format("{} from {} to {} lasts {} and needs {} after {}, between {} and {}; {}",
                [if b.slur { "the slur" } else { "the no-breath passage" }, name(x.first), name(x.last), seconds_text(off[x.last] - on[x.first]), times,
                 seconds_text(x.held), name(b.k), name(b.k + 1), limit_text(b.why, b.k)]))
        } else {
            // A useful breath renews `refill` of what this one had to renew.
            let pair = seconds_apart(b.time, lim.refill * b.full);
            finding("breath_time", x.first, x.last, format("{} with only {} of time, between {} and {} after {} of playing; a useful breath here needs {} ({} of a full one, which would take {})",
                [times, pair[0], name(b.k), name(b.k + 1), seconds_text(x.held), pair[1], lim.refill, seconds_fine(b.full)]))
        }
    });
    // Runs of pairs k -> k + 1 for which `fast(k)` holds, as {from, to, ioi}.
    // Only pairs faster than the slowest of the limits can be in one, so the
    // line is searched once for those.
    let gaps = if iois == null { map(range(max(0, count - 1)), fn(k) => on[k + 1] - on[k]) } else { iois };
    fn ioi(k) = gaps[k];
    let tongue_limit = max(lim.tongue, lim.double);
    let slowest = 1 / min(tongue_limit, min(lim.slurred, lim.crossing));
    let quick = filter(range(max(0, count - 1)), fn(k) => gaps[k] < slowest);
    fn runs(fast) {
        let r = fold(filter(quick, fast), {cur: null, out: []}, fn(st, k) => {
            let ioi_k = ioi(k);
            if st.cur != null && st.cur.to == k { {cur: {from: st.cur.from, to: k + 1, ioi: min(st.cur.ioi, ioi_k)}, out: st.out} } else {
                {cur: {from: k, to: k + 1, ioi: ioi_k}, out: if st.cur == null { st.out } else { st.out + [st.cur] }}
            }
        });
        if r.cur == null { r.out } else { r.out + [r.cur] }
    }
    let tongued = map(filter(runs(fn(k) => !facts[k].slur && ioi(k) < 1 / tongue_limit), fn(r) => r.to - r.from + 1 >= lim.run), fn(r) => finding("tonguing", r.from, r.to,
        format("{} tongued notes at {} a second; {} reaches about {}", [r.to - r.from + 1, round(10 / r.ioi) / 10,
            if lim.double > 0 { "double tonguing" } else { "single tonguing" }, tongue_limit])));
    let slurred = map(filter(runs(fn(k) => facts[k].slur && ioi(k) < 1 / lim.slurred), fn(r) => r.to - r.from + 1 >= lim.run), fn(r) => finding("slurred", r.from, r.to,
        format("{} slurred notes at {} a second; fingers reach about {}", [r.to - r.from + 1, round(10 / r.ioi) / 10, lim.slurred])));
    let crossing = map(filter(runs(fn(k) => facts[k].slur && facts[k].cross && ioi(k) < 1 / lim.crossing), fn(r) => r.to - r.from >= 2), fn(r) => finding("crossing", r.from, r.to,
        format("{} slurs across the register break at {} a second; about {} can be played", [r.to - r.from, round(10 / r.ioi) / 10, lim.crossing])));
    let leap_floor = min(lim.slur_leap, lim.fast_leap);
    let leaps = map(filter(range(max(0, count - 1)), fn(k) => facts[k].slur && abs(facts[k].step) > leap_floor
        && (abs(facts[k].step) > lim.slur_leap || ioi(k) < lim.leap_time)), fn(k) => {
        let wide = abs(facts[k].step);
        finding("slur_leap", k, k + 1, if wide > lim.slur_leap {
            format("a slur of {} semitones from {} to {}; about {} can be slurred", [wide, name(k), name(k + 1), lim.slur_leap])
        } else {
            format("a slur of {} semitones from {} to {} after {} s; it needs about {} s", [wide, name(k), name(k + 1), round(ioi(k) * 1000) / 1000, lim.leap_time])
        })
    });
    let all = sort_by(ranged + air + breaths + tongued + slurred + crossing + leaps, fn(x) => x.k);
    fn accepts(a, code) = a == true || kind(a) == "list" && contains(a, code);
    map(all, fn(x) => merge(x, {accepted: accepts(o.accept, x.code)
        || len(filter(range(x.k, x.to + 1), fn(k) => accepts(accepts_of(k), x.code))) > 0}))
}

// One note's performance with the player's context: `sounding`'s articulation,
// then tonguing, intonation, voicing and vibrato. `c` has `sounding`'s fields
// (`next`, `seconds`, `dynamic`, `has`, `marks`, `style`, `soft`) and `prev`, `interval`
// (semitones to the next note, or null), `interval_in`, `crosses_break` (the
// interval to the next note crosses one of the player's breaks),
// `breaks_in`, `phrase_pos` (0..1 through the phrase, by time),
// `phrase_first`, `phrase_last`, `metric_weight`, `note_rate` (notes per second
// here), `air_left` (0..1 of the breath at the note's end), `breath_before`,
// `breath_after` (the breath taken after this note, or null), `intensity`
// (0..1, the phrase arch here and the dynamic), `run` (the note's place in a
// run of fast tongued notes), `tuning` (cents), `slurs_on` (the next note
// continues this one under a slur, with no breath between), `player` and
// `options`.
// The player's tongue and vocal tract for a line (`o` the play options, `pl`
// the profile), worked out once: `shape(tongued, ku, accent, softly, rate)`
// is the tongue's shape as note controls (`rate` notes a second), and
// `tract(pitch, step_in, breaks_in, slurred, ku, seconds)` the tract's curves
// (`step_in` the interval into the note, or null). `play`'s own rule reads
// the parts directly.
fn voiced(o, pl) {
    let v = o.voicing;
    let sy = o.syllables;
    let rest = pl.tract_hz;
    fn tuned(pitch) = max(0, min(1, 0.5 + ln(ph.pitch_hz(pitch) * v.tune / rest) / ln(2) / 4));
    let r = {
        ta: syllable(sy.ta), firm: syllable(sy.firm), da: syllable(sy.da), ku: syllable(sy.ku), light: syllable(sy.light),
        fast: pl.tongue_fast, toward_light: o.tongue.light,
        // No pitch reaches 1000: a profile without an altissimo.
        high_from: if pl.altissimo > 0 { pl.altissimo } else { 1000 },
        high: fn(pitch) => {voicing: v.high, tract: tuned(pitch)},
        up: fn(pitch) => {voicing: [[0ms, v.up], [v.hold, 0.5]], tract: [[0ms, tuned(pitch)], [v.hold, 0.5]]},
        down: {voicing: [[0ms, v.down], [v.hold, 0.5]]},
        ku_tract: {voicing: [[0ms, v.ku], [v.ku_hold, 0.5]], tract: [[0ms, max(0, min(1, 0.5 + ln(v.ku_tract) / ln(2) / 4))], [v.ku_hold, 0.5]]}
    };
    // A syllable firmed a part of the way to the accent's, in eighths.
    let ta_firm = map(range(9), fn(i) => toward(r.ta, r.firm, i / 8));
    merge(r, {
        firmed: fn(s, firmer) => if s == r.ta { ta_firm[round(firmer * 8)] } else { toward(s, r.firm, round(firmer * 8) / 8) },
        shape: fn(tongued, is_ku, accent, softly, rate) => if !tongued { {} } else { if is_ku { r.ku } else {
            if accent { r.firm } else { if softly { r.da } else { if rate <= r.fast { r.ta } else {
                toward(r.ta, r.light, min(1, (rate - r.fast) * r.toward_light))
            } } }
        } },
        tract: fn(pitch, step_in, breaks_in, slurred, is_ku, seconds) => if pitch >= r.high_from { r.high(pitch) } else {
            if is_ku { r.ku_tract } else { if step_in == null || seconds <= 0.1 { {} } else {
                if step_in > 0 { if breaks_in || step_in > 7 { r.up(pitch) } else { {} } } else {
                    if slurred && breaks_in { r.down } else { {} }
                }
            } }
        }
    })
}
let own_play = {tongue: 1, tuning: null, vibrato: 1, expression: {}};
let unvibrated = [0ms, 0];
// `phrased`'s body for a line: `noted(options, player, style)` works out what
// every note shares once, and returns the rule for one note given its
// context's values (`next` is null when a breath ends the phrase there) and
// its `data.play` merged over `own_play`. It returns {gate, release (added to
// the note's release offset), expression}. `play` calls it directly.
fn noted(o, pl, st) {
    let tg = o.tongue;
    let tongue_phrase = tg.phrase;
    let metric_base = 1 - tg.metric / 2;
    let metric = tg.metric;
    let tongue_repeat = tg.repeat;
    let tongue_fast = pl.tongue_fast;
    let fast = tg.fast;
    let paced = pace_curve(tongue_fast, fast);
    let k_tongue = tg.k;
    let double = pl.double;
    let into = pl.intonation;
    let correct = into.correct;
    let settled = into.correct + into.settle;
    let settling = into.correct + into.settle / 2;
    let keep = into.keep;
    let voice = voiced(o, pl);
    let firm_per = o.short.breath * o.short.firm;
    let short_tongue = o.short.tongue;
    let vibrated = st.vibrato;
    let vibrato_min = pl.vibrato_min;
    fn rule(n, mk, next, slurs_on, secs, soft, p0, p1, p2, run, first, last, weight, repeat, note_rate, cents_in, up, breaks_in, i, air_left, own, blow = 1) {
        let a = articulated(n, st, soft, secs, mk, next, slurs_on, p0, p1, p2, false, up != null, blow);
        // A short note, blown harder (`blow`), is tongued firmer.
        let firmer = if blow == 1 { 0 } else { min(1, (blow - 1) / firm_per) };
        let firm_tongue = if blow == 1 { 1 } else { 1 + firmer * short_tongue };
        let e = a.expression;
        let seconds = secs * a.gate;
        let tongued = e.tongue > 0;
        // Tonguing: firmer at a phrase's start and on strong beats, lighter on a
        // repeated note and as the notes come faster; in a run of fast tongued
        // notes a flute alternates tu and ku, the ku a little weaker and from
        // the back of the tongue, so it speaks later and its tract differs
        // (Taffanel and Gaubert, Méthode complète de flûte, 1923).
        let ku = double && tongued && run % 2 == 1;
        let rate = if tongued { note_rate() } else { 0 };
        let tongue = if tongued {
            min(1, e.tongue * (if first { tongue_phrase } else { 1 }) * (metric_base + metric * weight)
                * (if repeat { tongue_repeat } else { 1 }) * curve_value(paced, rate)
                * (if ku { k_tongue } else { 1 }) * own.tongue * firm_tongue)
        } else { 0 };
        // The tongue's shape: a ku from the back of the tongue; a plain
        // tongue lighter as the notes come faster, and firmer when short.
        let syllable = voice.shape(tongued, ku, mk.accent || mk.hard, (soft || mk.soft) && !(mk.accent || mk.hard), rate);
        let shape = if blow == 1 { syllable } else { if ku || mk.accent || mk.hard { syllable } else { voice.firmed(syllable, firmer) } };
        // Intonation: the tendency at the attack, then the lip's correction.
        let cents = (if own.tuning != null { own.tuning } else { cents_in }) / 100;
        let tuning = if abs(cents) < 0.002 { {} } else {
            {tuning: if seconds * 1s > settling { [[0ms, cents], [correct, cents], [settled, cents * keep]] } else { cents }}
        };
        // Voicing: the vocal tract for a leap across a register break, the
        // altissimo and a ku.
        let tract = voice.tract(n.pitch, up, breaks_in, mk.slur, ku, seconds);
        // Vibrato grows with the phrase's intensity: deeper, sooner and a little
        // faster toward its peak, and faster through a long note (Gärtner 1981, The
        // Vibrato, with particular consideration given to the situation of the
        // flutist; Prame 1994, "Measurements of the vibrato rate of ten singers",
        // JASA 96:1979-1984). It needs time to show, so a short note has none, and it
        // dies with a phrase's last note.
        let vibrato = if vibrated && p1 > 0.18 && own.vibrato > 0 && seconds >= vibrato_min + (1 - i) * 0.25
            && !(mk.flutter || mk.breathy || mk.niente) {
            let depth = min(1, curve_value(vibrato_depth, p1) * (0.7 + 0.6 * i) * own.vibrato);
            let delay = min(220ms, seconds * 250ms) * (1.25 - 0.5 * i);
            let rate = 0.35 + 0.3 * i;
            {vibrato: [unvibrated, [delay, 0], [delay + min(450ms, seconds * 400ms), depth]]
                + if last && seconds > 0.6 { [[0.8, depth], [1, depth * 0.35]] } else { [] },
             vibrato_rate: [[0, rate], [1, rate + 0.05]]}
        } else { {} };
        // A breath nearly spent: more air in the tone.
        let air = if air_left >= 0.25 { {} } else { {noise: min(0.95, e.noise + 0.12 * min(1, (0.25 - air_left) * 4))} };
        {gate: a.gate, release: a.release, expression: merge(e, {tongue: tongue}, shape, air, tuning, tract, vibrato,
            own.expression)}
    }
    rule
}
fn phrased(n, c) {
    let own = merge(own_play, {expression: merge({expression: {}}, n.data).expression}, merge({play: {}}, n.data).play);
    // A breath after the note ends its phrase for the articulation rules.
    let r = noted(c.options, c.player, c.style)(n, c.marks, if c.breath_after == null { c.next } else { null }, c.slurs_on,
        c.seconds, c.soft, c.attack, c.middle, c.ending, c.run, c.phrase_first, c.phrase_last, c.metric_weight, c.repeat,
        fn() => c.note_rate, c.tuning, c.interval_in, c.breaks_in, c.intensity, c.air_left, own, merge({blow: 1}, c).blow);
    {gate: r.gate, release_offset: n.release_offset + r.release, data: merge(n.data, {expression: r.expression})}
}

// The player reads a line: `reading(pattern, spec, options)` makes every plan
// (breaths, phrases, timing), and returns {on (each attack in seconds),
// slowing (each attack's own phrase-final slowing, in seconds), heard (a
// function: what the other parts of an ensemble hear of this one, see
// `ensemble`), finish (a function of the slowing each attack plays, which
// plays the line)}. `play` finishes a line with its own slowing.
fn reading(pattern, spec, options) {
    let o = merge(play_defaults, options, {
        tongue: merge(play_defaults.tongue, merge({tongue: {}}, options).tongue),
        short: merge(play_defaults.short, merge({short: {}}, options).short),
        voicing: merge(play_defaults.voicing, merge({voicing: {}}, options).voicing),
        syllables: merge(play_defaults.syllables, merge({syllables: {}}, options).syllables),
        ensemble: merge(play_defaults.ensemble, merge({ensemble: {}}, options).ensemble),
        phrasing: merge(play_defaults.phrasing, merge({phrasing: {}}, options).phrasing)
    });
    let own_rule = o.rule == null;
    let mine = merge({player: {}}, spec).player;
    let pl = merge(player_defaults, mine, o.player, {
        intonation: merge(player_defaults.intonation, merge({intonation: {}}, mine).intonation, merge({intonation: {}}, o.player).intonation),
        limits: merge(player_defaults.limits, merge({limits: {}}, mine).limits, merge({limits: {}}, o.player).limits),
        tract_hz: merge({tract: 1200Hz}, spec).tract / 1Hz
    });
    let names = merge(tags, o.tags);
    let notes = sort_by(pattern.notes, fn(n) => n.at);
    let count = len(notes);
    let order = record(map(range(count), fn(k) => [notes[k].key, k]));
    // Every per-note quantity below is worked out once, and where a search or a
    // noise lookup applies to the whole line it is one curve evaluation
    // (`sampled`, `rows_at`, `noise_at`, the arches): evaluation steps grow with
    // the notes, not with the meters, dynamics points or phrases.
    // Each note's noise key: std/performance.note_identity's, made directly when
    // no two notes share a position and none pins its identity.
    let ats = map(notes, fn(n) => n.at);
    // The notes that carry data (most carry none).
    let datas = filter(range(count), fn(k) => len(notes[k].data) > 0);
    let shared = len(filter(range(1, max(1, count)), fn(k) => ats[k] == ats[k - 1])) > 0
        || len(filter(datas, fn(k) => contains(keys(notes[k].data), "identity"))) > 0;
    let identity = if shared { note_identity(pattern) } else { null };
    let ids = if identity == null { map(notes, fn(n) => [n.voice, n.at, n.pitch, 0]) } else { map(notes, fn(n) => identity(n)) };
    let timing = o.timing;
    fn sec(t) = seconds_at(t, timing) / 1s;
    let on = map(ats, fn(t) => seconds_at(t, timing) / 1s);
    let off = map(notes, fn(n) => seconds_at(n.at + n.duration, timing) / 1s);
    // --- the written line --------------------------------------------------------
    // A breath taken after a slurred-to note breaks the slur: the next note is
    // tongued. `has` is the player's view of the marks.
    fn marked(n, rule) = contains(n.tags, names[rule]);
    let late_ms = pl.late / 1s;
    let late_more = (pl.late_max - pl.late) / 1s;
    let curve_of = if o.dynamics == null { null } else { if callable(o.dynamics) { o.dynamics } else { fn(t) => interp(o.dynamics, t) } };
    // Each note's marks, read from its tags once for the plan and the rules (a
    // note without tags shares one record).
    let none_marked = merge(unmarked, {breath: false, no_breath: false, phrase: false, peak: false, superhuman: false});
    let rule_names = keys(none_marked);
    let tag_names = map(rule_names, fn(r) => names[r]);
    let distinct = len(group_by(tag_names, fn(t) => t)) == len(tag_names);
    let rule_of = if distinct { record(map(rule_names, fn(r) => [names[r], r])) } else { {} };
    let marks = map(notes, fn(n) => if len(n.tags) == 0 { none_marked } else { if distinct {
        fold(n.tags, none_marked, fn(m, t) => if contains(tag_names, t) { merge(m, record([[rule_of[t], true]])) } else { m })
    } else {
        record(map(rule_names, fn(r) => [r, contains(n.tags, names[r])]))
    } });
    fn written(k) {
        let n = notes[k];
        let next = if k + 1 < count { notes[k + 1] } else { null };
        if curve_of != null { curve_of } else {
            if next != null && next.at == n.at + n.duration && marked(next, "slur") {
                fn(t) => n.velocity + (next.velocity - n.velocity) * max(0, (t - n.at) / n.duration - 0.5)
            } else { fn(t) => n.velocity }
        }
    }
    // The written dynamic at each note's attack, middle and end (where the rules
    // ask), and each note's row of the meter table.
    let mids = map(notes, fn(n) => n.at + n.duration / 2);
    let tails = map(notes, fn(n) => n.at + n.duration * 63 / 64);
    let written_at = if curve_of == null {
        // `written` at the attack and middle is the velocity; at the end it has
        // moved 31/64 of the way to a slurred next note's.
        let velocities = map(notes, fn(n) => n.velocity);
        {d0: velocities, d1: velocities, d2: map(range(count), fn(k) => {
            let n = notes[k];
            if k + 1 < count && marks[k + 1].slur && notes[k + 1].at == n.at + n.duration { n.velocity + (notes[k + 1].velocity - n.velocity) * 31 / 64 } else { n.velocity }
        })}
    } else {
        {d0: dynamics_at(o.dynamics, ats), d1: dynamics_at(o.dynamics, mids), d2: dynamics_at(o.dynamics, tails)}
    };
    let table = bar_table(o.meters, o.meter);
    let rows = rows_at(table, ats);
    let flows = sampled(pl.flow, written_at.d1);
    let cap = pl.air * (1 - pl.reserve);
    let stale_cap = pl.stale * (1 - pl.reserve);
    let need = pl.exhale + pl.inhale;
    // Each note's register: how many of the player's breaks lie at or below it.
    // A step between two registers crosses a break.
    let registers = if len(pl.breaks) == 0 { map(notes, fn(n) => 0) } else {
        let breaks = sort_by(pl.breaks, fn(x) => x);
        curve_value({shape: "step", points: [[0, 0]] + map(range(len(breaks)), fn(i) => [breaks[i], i + 1])}, map(notes, fn(n) => n.pitch))
    };
    // A note's `data.play`, over what the plan and the rules assume.
    // Note data holds plain numbers: `shift` arrives in seconds (4ms as 0.004).
    let unplanned = merge(own_play, {breath: null, shift: 0, accept: []});
    let owns = if len(datas) == 0 { map(notes, fn(n) => unplanned) } else {
        map(notes, fn(n) => if len(n.data) == 0 { unplanned } else {
            merge(unplanned, {expression: merge({expression: {}}, n.data).expression}, merge({play: {}}, n.data).play)
        })
    };
    let nexts = if count == 0 { [] } else { slice(notes, 1, count) + [null] };
    let rest_breath = pl.rest_breath;
    let middles = written_at.d1;
    // Each note's facts. The last note's, with no note after it, are below.
    let no_data = len(datas) == 0;
    // A leap's part of a place's score: its size over 14, at most 0.5.
    let leap_score = {shape: "linear", points: [[0, 0.5], [121, 0.5], [128, 0], [135, 0.5], [256, 0.5]]};
    let facts = map(range(max(0, count - 1)), fn(k) => {
        let n = notes[k];
        let next = notes[k + 1];
        let s = off[k] - on[k];
        let g = on[k + 1] - off[k];
        let joined = g < 0.001;
        // Most notes carry no marks: they skip the searches.
        let m = marks[k];
        let slurred_next = joined && marks[k + 1].slur;
        let refuse = if no_data { m.no_breath } else { owns[k].breath == false || m.no_breath };
        let row = table[rows[k]];
        // The weight of its place in the bar (`weight_in`).
        let beats = (n.at - row.start) * row.unit / 4b;
        let x = if beats >= 0 { beats % row.count } else { beats - floor(beats / row.count) * row.count };
        let weight = if x == 0 { 1 } else { if x == row.half { 0.6 } else { if x == floor(x) { 0.4 } else { if x * 2 == floor(x * 2) { 0.2 } else { 0.1 } } } };
        let step = next.pitch - n.pitch;
        // The performed length, as `sounding` gates it: a player spends air only
        // while the note sounds, and the silence a staccato leaves is time to
        // breathe in.
        let sounded = if m.staccato { s * 0.5 } else { if slurred_next || m.tenuto { s } else { s * min(1, n.gate) } };
        let mark = if no_data { m.breath } else { owns[k].breath == true || m.breath };
        {
            k: k, seconds: s, gap: g, joined: joined, weight: weight, step: step,
            // In beats, for the phrase boundaries: the time to the next attack
            // (the last note's own length) and the rest before it.
            ioi: (next.at - n.at) / row.beat,
            rest: if g < 0.0001 { 0 } else { max(0, (next.at - n.at - n.duration) / row.beat) }, staccato: m.staccato,
            four: weight == 1 && round((n.at - row.start) / row.length) % 4 == 0,
            sounded: sounded, quiet: s - sounded + g, cost: sounded * flows[k],
            forced: !refuse && (mark || g >= rest_breath), mark: mark,
            // A place to breathe, ranked as a listener groups a line: after a long
            // note before shorter ones, at a rest, at a register leap (Lerdahl and
            // Jackendoff 1983, A Generative Theory of Tonal Music, grouping
            // preference rules 2 and 3), at a phrase mark or after a note on a
            // strong beat; never inside a slur unless nothing else is left.
            score: (if m.phrase { 2.5 } else { 0 })
                + (if s >= 1.4 * (off[k + 1] - on[k + 1]) { 1 } else { 0 })
                + (if weight >= 0.6 && n.duration >= 1b && s >= 0.4 { 0.8 } else { 0 })
                + curve_value(leap_score, step + 128)
                + (if g > 0 { 1.5 } else { 0 })
                - (if joined && s < 0.25 { 1.5 } else { 0 })
                - (if slurred_next { 6 } else { 0 })
                - (if refuse { 20 } else { 0 }),
            slur: slurred_next, slurred: m.slur, phrase_mark: m.phrase, refuse: refuse,
            cross: registers[k + 1] != registers[k],
            // How the phrase picks its peak: the highest, loudest, longest note on a strong beat, or a mark.
            prominence: n.pitch + 12 * middles[k] + 3 * min(s, 1) + 2 * weight + if m.peak { 1000 } else { 0 }
        }
    }) + (if count == 0 { [] } else {
        let k = count - 1;
        let n = notes[k];
        let s = off[k] - on[k];
        let m = marks[k];
        let row = table[rows[k]];
        let weight = weight_in(row, n.at);
        let sounded = if m.staccato { s * 0.5 } else { if m.tenuto { s } else { s * min(1, n.gate) } };
        [{
            k: k, seconds: s, gap: 1000, joined: false, weight: weight, step: 0, ioi: n.duration / row.beat, rest: 0, staccato: m.staccato,
            four: weight == 1 && round((n.at - row.start) / row.length) % 4 == 0,
            sounded: sounded, quiet: s - sounded + 0, cost: sounded * flows[k], forced: false, mark: owns[k].breath == true || m.breath,
            score: 0, slur: false, slurred: m.slur, phrase_mark: m.phrase, refuse: owns[k].breath == false || m.no_breath, cross: false,
            prominence: n.pitch + 12 * middles[k] + 3 * min(s, 1) + 2 * weight + if m.peak { 1000 } else { 0 }
        }]
    });
    // --- pass 1: where to breathe -------------------------------------------------
    // Walk the line spending air. A rest or a mark is breathed at once. Other
    // places wait on a stack, best first (`rank` grows with the air already
    // spent, so a later place wins a tie); when a note would overdraw the breath
    // (or hold it past `stale`), the best place before it is taken. `a` is the
    // air spent and `t` the seconds of air held since the line began; a breath
    // sets the bases `a0` and `t0` they count from, so a breath taken back at an
    // earlier place needs no replay of the notes since.
    //
    // Air is spent only while a note sounds. The time held counts the silences
    // that are no breath (an articulation gap, a rest too short to breathe in)
    // at `1 - relief`: they give no air, but the player lets a little stale air
    // out.
    //
    // A breath has `time` (the silence after the note, what it needs of the
    // note up to `take` of it, and the next entry's lateness when that is
    // not `enough`). A full breath lets out what has gone stale and
    // fills what is spent: it needs `exhale * stale + inhale * room`, `stale`
    // and `spent` being the parts of their limits used and `room` the part of
    // the lungs then empty. A shorter one is the same breath scaled down, an
    // exhale and a quick sip, and renews that part of both: its `refill`.
    // Oboists usually exhale before they inhale, and mark places to exhale and
    // inhale, only inhale, or only exhale (Carr 2012, "Exercises for oboists",
    // The Instrumentalist). Their breath pauses in running music are about 0.3 s
    // (Fuks and Sundberg 1998, "Respiratory inductive plethysmography
    // measurements on professional reed woodwind instrument players", KTH
    // TMH-QPSR 39). So when a breath is for stale air and an exhale alone would
    // renew more of it, the player only exhales (`kind` "exhale"), keeping
    // `exhale_keep` of the air.
    fn breath_at(st, c, reason) {
        let quiet = c.quiet;
        let used = min(cap, max(0, c.a - st.a0));
        let held = max(0, c.t - st.t0);
        let stale = min(1, held / stale_cap);
        let spent = used / cap;
        let full = pl.exhale * stale + pl.inhale * (spent + stale * (1 - spent));
        // The breath's time comes out of the note before it first, up to
        // `take` of it; the next entry is late only when that leaves less
        // than `enough` of the breath, as after a staccato or a quick note.
        let take = if quiet >= full { 0 } else { min(c.sounded * pl.take, full - quiet) };
        let short = full * pl.enough - quiet - take;
        let late = if short <= 0 { 0 } else { (if c.joined { late_ms } else { 0 }) + min(late_more, short) };
        let time = quiet + take + late;
        let q = if full <= 0 { 1 } else { min(1, time / full) };
        // An exhale alone lets out `x` of the stale air, which is `stale` of what
        // is still in the lungs, and only as much as leaves `exhale_keep`.
        let vent = pl.exhale * stale;
        let most = if stale <= 0 || used >= cap { 0 } else { max(0, (cap * (1 - pl.exhale_keep) - used) / (stale * (cap - used))) };
        let x = if vent <= 0 { 0 } else { min(1, min(most, time / vent)) };
        let exhale = reason == "stale" && x > q;
        merge(c, {take: take, late: late, time: time, why: reason, exhale: exhale,
            refill: if exhale { x } else { q }, full: if exhale { vent } else { full },
            a0: c.a - (if exhale { used + x * stale * (cap - used) } else { used * (1 - q) }), t0: c.t - held * (1 - if exhale { x } else { q })})
    }
    fn breathe(st, c, reason) {
        let b = breath_at(st, c, reason);
        merge(st, {a0: b.a0, t0: b.t0, breaths: st.breaths + [b], stack: filter(st.stack, fn(x) => x.k > c.k), from: c.k + 1, flagged: false})
    }
    fn short(s) = s.a - s.a0 > cap || s.t - s.t0 > stale_cap;
    let unrelieved = 1 - pl.relief;
    // The limit that is reached: the air, or the time it may be held.
    fn binding(s) = if (s.a - s.a0) / cap >= (s.t - s.t0) / stale_cap { "air" } else { "stale" };
    let planned = fold(range(count), {a: 0, t: 0, a0: 0, t0: 0, stack: [], breaths: [], from: 0, flagged: false, over: [], spent: []}, fn(st0, k) => {
        let f = facts[k];
        let a = st0.a + f.cost;
        let held = st0.t + f.sounded;
        let st2 = if a - st0.a0 <= cap && held - st0.t0 <= stale_cap { st0 } else {
            let relieved = fold(range(4), merge(st0, {a: a, t: held}), fn(s, i) => if short(s) && len(s.stack) > 0 { breathe(s, s.stack[0], binding(s)) } else { s });
            if !relieved.flagged && short(relieved) {
                merge(relieved, {flagged: true, over: relieved.over + [{from: relieved.from, k: k, why: binding(relieved)}]})
            } else { relieved }
        };
        let t = held + f.quiet * unrelieved;
        // (The last note's place, never taken, is harmless on the stack.)
        let c = merge(f, {a: a, t: t, rank: f.score + 1.5 * a / cap});
        if f.forced { merge(breathe(st2, c, if f.mark { "mark" } else { "rest" }), {a: a, stack: [], t: t, spent: st2.spent + [[a, held]]}) } else {
            merge(st2, {a: a, stack: filter(st2.stack, fn(x) => x.rank > c.rank) + [c], t: t, spent: st2.spent + [[a, held]]})
        }
    });
    // The breath after each note (or null), and the last one before it.
    let bs = planned.breaths;
    let carry = if len(bs) == 0 { null } else {
        map(curve_value({shape: "step", points: [[0, 0]] + map(range(len(bs)), fn(i) => [bs[i].k + 1, i + 1])}, range(count + 1)), fn(x) => round(x))
    };
    let after = if carry == null { map(notes, fn(n) => null) } else { map(range(count), fn(k) => if carry[k + 1] > carry[k] { bs[carry[k]] } else { null }) };
    let befores = if count == 0 { [] } else { [null] + slice(after, 0, count - 1) };
    let iois = map(range(max(0, count - 1)), fn(k) => on[k + 1] - on[k]);
    let issues = unplayable_in(notes, facts, planned, on, off, spec, pl, o, cap, written_at.d1, fn(k) => if marks[k].superhuman { true } else { owns[k].accept }, iois);
    let open = filter(issues, fn(x) => !x.accepted);
    let checked = assert(!o.strict || len(open) == 0, "unplayable as written; pass `accept` (or tag the notes `superhuman`) to play it anyway, or `strict: false` to warn:\n"
        + join(map(open, fn(x) => "  " + x.message), "\n"));
    let found = if len(issues) == 0 { {} } else {
        merge(record(map(range(count), fn(k) => [str(k), null])), record(map(group_by(issues, fn(x) => x.k), fn(g) => [str(g[0].k), g])))
    };
    // --- phrases ------------------------------------------------------------------
    // Where a listener hears one phrase end and the next begin. Each join of
    // two notes gets a boundary strength, and the line is cut at the best set
    // of joins. The cues are the grouping preference rules of Lerdahl and
    // Jackendoff (1983, A Generative Theory of Tonal Music): a rest or the end
    // of a slur (GPR 2a), a long time between attacks (2b), a leap (3a), a
    // change of dynamic (3b) or articulation (3c), a cadence, a long note
    // arriving on a strong beat (GPR 7), and groups of four bars (GPR 5,
    // symmetry; Temperley's metrical parallelism, below). Rests, inter-onset
    // times and leaps count as in Cambouropoulos's Local Boundary Detection
    // Model (2001, "The Local Boundary Detection Model (LBDM) and its
    // application in the study of expressive timing", ICMC): each by its size
    // times how far it differs from its neighbours, so an ostinato's regular
    // rests are no boundary. Sizes are in beats of the meter (a dotted quarter
    // in 6/8), not seconds, so a cadence rest is one at any tempo. A change of
    // meter or tempo marks a new section. A slur is never cut unless a
    // `phrase` mark says so. A planned breath is a weak boundary: it helps
    // choose among others but alone ends nothing (a player breathes where the
    // air runs out as well as where phrases end). Phrases last `min` to `max`
    // seconds where the music allows (GPR 1, no tiny groups; the KTH
    // Phrase-arch rule shapes phrases and subphrases of a few seconds: Friberg
    // 1995, "Matching the rule parameters of Phrase arch to performances of
    // Träumerei", KTH STL-QPSR 36(2-3)).
    let ph = o.phrasing;
    fn change(x, y) = if x + y <= 0 { 0 } else { abs(x - y) / (x + y) };
    let joins = max(0, count - 1);
    let decisive = ph.rest_beats;
    let d0 = written_at.d0;
    let d1 = written_at.d1;
    // A join's strength: 1000 if decisive, -10 inside a slur, else the cues.
    // `e`, `f` and `g` are the notes before, at and after the join. A rest,
    // a time between attacks no longer than its neighbours' or a leap under a
    // fourth adds nothing (each counts in LBDM by its size times its change,
    // |a - b| / (a + b), from each neighbour).
    let w_rest = ph.rest;
    let w_ioi = ph.ioi;
    let w_leap = ph.leap;
    let w_cadence = ph.cadence;
    let w_dynamics = ph.dynamics;
    let w_articulation = ph.articulation;
    let w_hyper = ph.hyper;
    let w_meter = ph.meter;
    let w_tempo = ph.tempo;
    let w_mark = ph.mark;
    let w_breath = ph.breath;
    let after_facts = if count == 0 { [] } else { slice(facts, 1, count) };
    let before_facts = if count == 0 { [] } else { [facts[0]] + slice(facts, 0, count - 1) };
    let strength = map(range(joins), fn(k) => {
        let f = facts[k];
        if f.slur { if f.phrase_mark { 1000 } else { 0 - 10 } } else { if f.phrase_mark || f.rest >= decisive { 1000 } else {
            let g = after_facts[k];
            let e = before_facts[k];
            let x = f.ioi;
            let r = f.rest;
            let leap = abs(f.step);
            let dd = abs(d0[k + 1] - d1[k]);
            (if r == 0 { 0 } else { w_rest * min(4, r * (change(e.rest, r) + change(r, g.rest))) })
                + (if x <= e.ioi && x <= g.ioi { 0 } else { w_ioi * min(4, x * (abs(e.ioi - x) / (e.ioi + x) + abs(x - g.ioi) / (x + g.ioi))) })
                + (if leap < 5 { 0 } else { w_leap * leap / 12 * (abs(abs(e.step) - leap) / (abs(e.step) + leap) + abs(leap - abs(g.step)) / (leap + abs(g.step))) })
                + (if x < 1 || x < 1.5 * e.ioi || f.weight < 0.6 { 0 } else { w_cadence })
                + (if dd < 0.01 { 0 } else { w_dynamics * min(1, dd / 0.15) })
                + (if f.slurred || f.staccato != g.staccato { w_articulation } else { 0 })
                // At a bar line: four bars, a new meter, a new tempo.
                + (if g.weight < 1 { 0 } else { (if g.four { w_hyper } else { 0 })
                    + (if rows[k + 1] == rows[k] { 0 } else { if table[rows[k + 1]].meter != table[rows[k]].meter { w_meter } else { 0 } })
                    + (if abs(f.seconds * notes[k + 1].duration - g.seconds * notes[k].duration) > 0.05 * f.seconds * notes[k + 1].duration { w_tempo } else { 0 }) })
                + (if f.mark { w_mark } else { 0 }) + (if after[k] == null { 0 } else { w_breath })
        } }
    });
    // The cuts are the best set over the whole line, found by dynamic
    // programming as Temperley's Grouper finds phrases (Temperley 2001, The
    // Cognition of Basic Musical Structures, ch. 3): each cut earns its
    // strength less `threshold`, and a phrase costs nothing from `min` to
    // `max` seconds and more the further it falls outside. Only joins of at
    // least 0.5 that are stronger than both neighbours are candidates (as
    // LBDM picks its peaks), and a decisive one is always cut.
    let boundaries = strength + [null];
    let candidates = filter(filter(range(joins), fn(k) => strength[k] >= 0.5), fn(k) => {
        let b = strength[k];
        b >= 1000 || (k == 0 || b >= strength[k - 1]) && (k + 1 >= joins || b >= strength[k + 1])
    });
    // Nodes: the line's start, the candidates, its end. A phrase runs from the
    // start after one node to the end of the next.
    let nodes = if count == 0 { [] } else { [0 - 1] + candidates + [count - 1] };
    let last_node = len(nodes) - 1;
    let starts = map(range(last_node), fn(i) => on[nodes[i] + 1]);
    let ends = map(nodes, fn(k) => if k < 0 { 0 } else { off[k] });
    // For each node, the first node whose phrase to it would last at most
    // `max`, and the first that would last under `min`.
    // (Curve positions start at 0: all are moved `max` + 1 on.)
    let lift = ph.max + 1;
    let index_of = {shape: "step", points: [[0, 0]] + map(range(last_node), fn(i) => [starts[i] + lift, i + 1])};
    let longest = curve_value(index_of, map(ends, fn(e) => e + 0.999999));
    let shortest = curve_value(index_of, map(ends, fn(e) => e - ph.min + lift));
    // A phrase lasts from `min` to `max` at no cost, so the best place for the
    // phrase ending at a node to start is the best score in a window of nodes
    // that only moves forward: a queue of nodes in falling order of score
    // (`entered`: the next node to join it). With none in the window, the
    // phrase runs just past `max` at a cost, or, after a decisive cut that
    // leaves no room, falls short of `min` at a cost.
    let best = fold(range(1, last_node + 1), {score: [0], back: [0], wall: 0, queue: [], entered: 0}, fn(st, j) => {
        let e = ends[j];
        let a = max(st.wall, round(longest[j]));
        let b = max(a, round(shortest[j]));
        let score = st.score;
        let kept = if len(st.queue) == 0 || st.queue[0] >= a { st.queue } else { filter(st.queue, fn(q) => q >= a) };
        let queue = fold(range(max(st.entered, a), b), kept, fn(d, i) => filter(d, fn(q) => score[q] >= score[i]) + [i]);
        let from = if len(queue) > 0 { {s: score[queue[0]], i: queue[0]} } else { if a > st.wall {
            {s: score[a - 1] + 2 - 2 * (e - starts[a - 1]) / ph.max, i: a - 1}
        } else { {s: score[a] - 6 + 6 * (e - starts[a]) / ph.min, i: a} } };
        let gain = if j == last_node { 0 } else { strength[nodes[j]] - ph.threshold };
        {score: score + [from.s + gain], back: st.back + [from.i], wall: if gain >= 900 { j } else { st.wall }, queue: queue, entered: max(st.entered, b)}
    });
    let cuts = if count == 0 { [] } else {
        fold(range(last_node), {at: last_node, cuts: []}, fn(st, x) => if st.at == 0 { st } else {
            let i = best.back[st.at];
            {at: i, cuts: if i == 0 { st.cuts } else { [nodes[i]] + st.cuts }}
        }).cuts
    };
    // Each note's phrase: how many cuts come before it.
    let phrase_of = if len(cuts) == 0 { map(range(count), fn(k) => 0) } else {
        map(curve_value({shape: "step", points: [[0, 0]] + map(range(len(cuts)), fn(i) => [cuts[i] + 1, i + 1])}, range(count)), fn(x) => round(x))
    };
    // Phrases: their span in seconds, their peak, and how they end.
    let groups = group_by(range(count), fn(k) => phrase_of[k]);
    let phrases = map(range(len(groups)), fn(j) => {
        let g = groups[j];
        let first = g[0];
        let last = g[len(g) - 1];
        let t0 = on[first];
        let t1 = off[last];
        let peak = fold(g, [first, 0 - 1000000], fn(best, k) => { let q = facts[k].prominence; if q >= best[1] { [k, q] } else { best } })[0];
        let length = max(t1 - t0, 0.001);
        // A phrase broken off by a breath in a running line slows less than
        // one that ends at a rest, and one that the line runs straight on from
        // (no breath, no rest) not at all: its next phrase starts on time, so
        // a slowing would only shorten the note before it. The slowing is a
        // part of the beat (Friberg and Sundberg's ritard is a change of tempo
        // over a stretch of the score): `final` of `final_span` at a beat of a
        // second or longer, and less in proportion at a faster beat, so a
        // dance's inner cadences do not drag against the parts running on.
        let f_last = facts[last];
        let ending = if f_last.joined { if after[last] == null { 0 } else { 0.5 } } else { 1 };
        let beat_s = f_last.seconds * table[rows[last]].beat / notes[last].duration;
        let span = min(o.final_span, on[last] - t0);
        {
            j: j, first: first, last: last, peak_k: peak, t0: t0, t1: t1, length: length, span: span, from: on[last] - span,
            slowing: o.final * span * ending * min(1, beat_s), beat_s: beat_s,
            peak: clamp((on[peak] + facts[peak].seconds / 2 - t0) / length, 0.15, 0.85),
            depth: if last == first { 0 } else { o.arc * min(1, length / 1.5) }
        }
    });
    // The arch (Todd 1992, "The dynamics of dynamics: a model of musical
    // expression", JASA 91:3540-3550; the KTH Phrase-arch rule): the breath
    // starts `arc` under the written dynamic, rises to `arc` over it at the
    // peak and falls to 1.3 times `arc` under it at the end. The written
    // dynamic stays the reference, as in the KTH rules, whose arches are
    // deviations from the nominal level: each slope stays within `arc_reach`
    // seconds of the phrase's start, peak or end, so a long phrase plays at its
    // written dynamic in between instead of sinking along one slow fall.
    // The phrases follow one another in time, so their arches are one smooth
    // curve in seconds (each ending a microsecond early, where the next may
    // begin), evaluated at each note's attack, middle and end.
    let reach = o.arc_reach;
    let arches = {shape: "smooth", points: fold(phrases, [], fn(out, p) => {
        let x = p.t0;
        let top = p.peak * p.length;
        let end = x + p.length - 0.000001;
        out + (if p.depth == 0 { [[x * 1s, 0], [end * 1s, 0]] } else {
            [[x * 1s, 0 - p.depth]] + (if top > 2 * reach { [[(x + reach) * 1s, 0], [(x + top - reach) * 1s, 0]] } else { [] })
                + [[(x + top) * 1s, p.depth]]
                + (if p.length - top > 2 * reach { [[(x + top + reach) * 1s, 0], [(x + p.length - reach) * 1s, 0]] } else { [] })
                + [[end * 1s, p.depth * (1 - 2.3)]]
        })
    })};
    fn arc_at(p, t) = if p.depth == 0 { 0 } else { curve_value(arches, p.t0 + max(0, min(p.length - 0.000001, t - p.t0))) };
    let arc0 = curve_value(arches, on);
    let arc1 = curve_value(arches, map(range(count), fn(k) => (on[k] + off[k]) / 2));
    let arc2 = curve_value(arches, map(range(count), fn(k) => off[k] - (off[k] - on[k]) / 64));
    // --- timing -------------------------------------------------------------------
    // Shared drift (the ensemble's), the chair's own, a little motor noise, the
    // chair's lead; then a late entry after a breath (caught up over half a second),
    // lateness on a slurred leap, a late ku, and the phrase's final slowing
    // (Friberg and Sundberg 1999, "Does music performance allude to locomotion? A
    // model of final ritardandi derived from measurements of stopping runners",
    // JASA 105:1469-1484). A player's timing is a slow timekeeper plus motor
    // noise (Wing and Kristofferson 1973, "Response delays and the timing of
    // discrete motor responses", Perception & Psychophysics 14:5-12), and
    // ensemble leads and asynchronies of a few tens of milliseconds are normal
    // (Rasch 1979, "Synchronization in performed ensemble music", Acustica
    // 43:121-131).
    let ens = o.ensemble;
    let ens_drift = ens.drift / 1s * 1.05;
    let chair_drift = o.drift / 1s * 1.6;
    let jitter = o.jitter / 1s * 1.7;
    let leap_late = o.leap_late / 1s;
    let leap_gap = o.leap_gap / 1s;
    let ku_late = o.tongue.k_late / 1s;
    let lead = o.lead / 1s;
    // drift_at's two layers and the chair's slow noise, for every attack at once.
    let ens_slow = noise_at(on, ens.scale, ["ensemble", 0], ens.seed, ens_drift);
    let ens_slower = noise_at(on, ens.scale * 4, ["ensemble", 1], ens.seed, ens_drift * 2);
    let chair_curve = noise_curve(on, o.drift_scale, "chair", o.seed);
    let chair = if chair_curve == null { noise_at(on, o.drift_scale, "chair", o.seed) } else { curve_value(chair_curve, on) };
    let double = pl.double;
    let double_rate = pl.double_rate;
    let full_air = pl.air;
    let full_stale = pl.stale;
    // --- the plan, note by note ---------------------------------------------------
    // Each note keeps the breath before it, how fast the notes come, the air
    // left at its end, the interval into it, and its attack's shift in time
    // (`shift`) without the phrase's final slowing (`slowing`), which an
    // ensemble may share.
    // Before the first breath, the line's start stands for one (no air
    // spent, no lateness).
    let start = {a0: 0, t0: 0, late: 0, k: 0 - 1};
    let carried = if carry == null { map(notes, fn(n) => start) } else { map(carry, fn(c) => if c == 0 { start } else { bs[c - 1] }) };
    let spents = planned.spent;
    let previous = if count == 0 { [] } else { [null] + slice(facts, 0, count - 1) };
    // Each note's place in a run of fast tongued notes (-1 outside one), which
    // only a double-tonguing player and a rule of the composer's read.
    let unrun = 0 - 1;
    // How fast the notes come at each: notes a second.
    // How fast the notes come at each: notes a second (the last at the pace before it).
    let rates = curve_value(per_second, iois + [if count > 1 { on[count - 1] - on[count - 2] } else { if count == 1 { facts[0].seconds } else { 1 } }]);
    let runs = if !double && own_rule { map(notes, fn(n) => unrun) } else { fold(range(count), {run: -1, out: []}, fn(st, k) => {
        let pf = previous[k];
        let cut = befores[k] != null || pf != null && pf.phrase_mark;
        let run = if rates[k] >= double_rate && (k == 0 || cut || !facts[k].slurred) { if cut { 0 } else { st.run + 1 } } else { -1 };
        {run: run, out: st.out + [run]}
    }).out };
    // A tongued attack starts early by the instrument's speaking time at its
    // dynamic: a soft (legato) tongue, which swells into the note, speaks
    // latest, an accent soonest. A note slurred to the one before it starts
    // no new attack.
    let speak = pl.speak;
    let anticipate = o.anticipate;
    let pitch_list = map(notes, fn(n) => n.pitch);
    // How late each attack speaks, from the profile's grids (a row for each
    // pitch, a column for each dynamic): one for each syllable from silence
    // (a rest, a breath, the line's start) and inside a phrase (`joined`; a
    // profile without it times both alike). Every distinct grid is laid end
    // to end as one curve, each column a curve by pitch at its own place, so
    // each note is one reading: at its pitch (held within the measured ones)
    // in the column nearest its dynamic.
    let ds = speak.dynamics;
    let ps = speak.pitches;
    let columns = len(ds);
    let inside = merge({plain: speak.plain, soft: speak.soft, accent: speak.accent}, merge({joined: {}}, speak).joined);
    let joined_plain = inside.plain;
    let joined_fast = merge({fast: joined_plain}, inside).fast;
    let named = [speak.plain, speak.soft, speak.accent, joined_plain, inside.soft, inside.accent,
        merge({staccato: joined_fast}, inside).staccato, joined_fast, merge({ku: joined_fast}, inside).ku];
    // Each syllable's place among the distinct grids (one laid out once).
    let places = fold(range(len(named)), {grids: [], at: []}, fn(st, g) => {
        let same = filter(range(len(st.grids)), fn(i) => st.grids[i] == named[g]);
        if len(same) > 0 { {grids: st.grids, at: st.at + [same[0]]} } else { {grids: st.grids + [named[g]], at: st.at + [len(st.grids)]} }
    });
    let grids = places.grids;
    let grid_at = places.at;
    let speak_curve = {shape: "linear", points: fold(range(len(grids) * columns), [], fn(xs, c) => {
        let g = grids[floor(c / columns)];
        let j = c % columns;
        let at = c * 256;
        xs + map(range(len(ps)), fn(i) => [at + ps[i], g[i][j]])
    })};
    // Each note's nearest column (a staircase by the dynamic, stepping
    // halfway between columns).
    let column_at = if columns == 1 { map(notes, fn(n) => 0) } else {
        curve_value({shape: "step", points: [[0, 0]] + map(range(columns - 1), fn(j) => [(ds[j] + ds[j + 1]) / 2, j + 1])}, written_at.d0)
    };
    // Inside a phrase a note under 0.3 s from the next is timed as a fast
    // one: its tone has had no time to die.
    let fast_at = 1 / 0.3;
    let speak_pitch = if len(ps) == 1 { map(notes, fn(n) => ps[0]) } else {
        curve_value({shape: "linear", points: [[0, ps[0]], [ps[0], ps[0]], [ps[len(ps) - 1], ps[len(ps) - 1]], [1000, ps[len(ps) - 1]]]}, pitch_list)
    };
    let softs = if callable(o.soft) { map(notes, fn(n) => o.soft(n)) } else { null };
    let soft_always = if callable(o.soft) { false } else { o.soft };
    let anticipated = if anticipate { 1 } else { 0 };
    let timed = map(range(count), fn(k) => {
        let pf = previous[k];
        let breath = carried[k];
        let spent = spents[k];
        let step_in = if pf == null || !pf.joined { null } else { pf.step };
        // How late its attack speaks: its syllable's grid, read at its column
        // and pitch; out of silence (a rest, a breath) or inside a phrase. A
        // note slurred to the one before starts nothing.
        let m = marks[k];
        let fresh = step_in == null || befores[k] != null;
        let spoken = if m.slur && !fresh { 0 } else {
            let soft = if softs == null { soft_always } else { softs[k] };
            let g = if m == none_marked {
                if fresh { if soft { 1 } else { 0 } } else { if soft { 4 } else { if rates[k] < fast_at { 3 } else { if double && runs[k] % 2 == 1 { 8 } else { 7 } } } }
            } else { if m.accent || m.hard { if fresh { 2 } else { 5 } } else {
                if m.staccato { if fresh { 0 } else { if rates[k] < fast_at { 3 } else { 6 } } } else { if m.soft || soft { if fresh { 1 } else { 4 } } else {
                    if fresh { 0 } else { if rates[k] < fast_at { 3 } else { if double && runs[k] % 2 == 1 { 8 } else { 7 } } } } }
            } };
            curve_value(speak_curve, (grid_at[g] * columns + column_at[k]) * 256 + speak_pitch[k])
        };
        {
            air: min(1 - (spent[0] - breath.a0) / full_air, 1 - (spent[1] - breath.t0) / full_stale),
            step_in: step_in, breaks_in: step_in != null && pf.cross,
            // The attack's own shift: drift, motor noise, lead, the speaking
            // time anticipated, a leap's lateness and a ku's.
            base: ens_slow[k] + ens_slower[k] + chair[k] * chair_drift + keyed_noise(ids[k], o.seed, "attack") * jitter + (if no_data { lead } else { lead + owns[k].shift })
                - spoken * anticipated
                + (if step_in == null || step_in <= 4 && step_in >= 0 - 4 { 0 } else {
                    min(1, (abs(step_in) - 4) / 8) * leap_late * (if pf.step > 0 { 1 } else { 0.5 })
                        * (if pf.cross { 1.5 } else { 1 }) * (if m.slur { 1 } else { 0.5 })
                }) + (if double && runs[k] % 2 == 1 { ku_late } else { 0 }),
            speak: spoken,
            // The entry after a breath is late, caught up over half a second.
            late: if breath.late == 0 { 0 } else { breath.late * pow(0.25, (on[k] - on[breath.k + 1]) * 2) }
        }
    });
    // The phrase's final slowing (Friberg and Sundberg 1999).
    let slowing = map(range(count), fn(k) => {
        let p = phrases[phrase_of[k]];
        let t = on[k];
        if t <= p.from { 0 } else { p.slowing * pow((t - p.from) / p.span, 2) }
    });
    // --- pass 2: each note ------------------------------------------------------------
    let level_of = if o.level == null { null } else { if callable(o.level) { o.level } else {
        let tagged = keys(o.level);
        fn(n) => if len(n.tags) == 0 { 1 } else { fold(tagged, 1, fn(f, t) => if contains(n.tags, t) { f * o.level[t] } else { f }) }
    } };
    let into = pl.intonation;
    let arc_scale = 0.35 / max(o.arc, 0.001);
    let tendency = sampled(into.register, pitch_list);
    let tune_dynamic = into.dynamic;
    let tune_scatter = into.scatter;
    let style = spec.style;
    let soft_all = if callable(o.soft) { null } else { o.soft };
    let clean = len(issues) == 0;
    // `noted`'s shared values, for the default rule played inline below.
    let tg = o.tongue;
    let tongue_phrase = tg.phrase;
    let metric_base = 1 - tg.metric / 2;
    let metric = tg.metric;
    let tongue_repeat = tg.repeat;
    let tongue_fast = pl.tongue_fast;
    let tongue_fade = tg.fast;
    let k_tongue = tg.k;
    let correct = into.correct;
    let settled = into.correct + into.settle;
    let settling = into.correct + into.settle / 2;
    let keep = into.keep;
    let settling_s = settling / 1s;
    let voice = voiced(o, pl);
    let loudness = if o.short.integration == 100ms { short_loudness_100 } else { short_loudness(o.short.integration / 1s) };
    let short_breath = o.short.breath;
    let firm_per = o.short.breath * o.short.firm;
    let short_tongue = o.short.tongue;
    let sy_ta = voice.ta;
    let sy_firm = voice.firm;
    let sy_da = voice.da;
    let sy_ku = voice.ku;
    let sy_light = voice.light;
    let toward_light = voice.toward_light;
    let high_from = voice.high_from;
    let ku_tract = voice.ku_tract;
    let voice_down = voice.down;
    let vibrated = style.vibrato;
    let vibrato_min = pl.vibrato_min;
    let airy = air_curve(style.air);
    let paced = curve_value(pace_curve(tongue_fast, tongue_fade), rates);
    let dynamic_range = {shape: "linear", points: [[0, 0.1], [0.1, 0.1], [1, 1], [10, 1]]};
    let w0 = written_at.d0;
    let w1 = written_at.d1;
    let w2 = written_at.d2;
    // `slow`: each attack's final slowing; `lates`: each attack's lateness
    // after a breath (null: its own); `own`: further deviations (null: none).
    fn finish(slow, lates, own) {
        let shift = if own != null { map(range(count), fn(k) => timed[k].base + lates[k] + own[k] + slow[k]) } else {
            if lates == null { map(range(count), fn(k) => { let x = timed[k]; x.base + x.late + slow[k] }) } else {
                map(range(count), fn(k) => timed[k].base + lates[k] + slow[k])
            }
        };
        // A breath nearly spent (`tired` of the way), pushed and wavering.
        fn worn(tired, ts) = tired * o.support * 0.5 + tired * 0.025 * smooth_noise(ts, 0.3, "wobble", o.seed);
        let patches = map(range(count), fn(k) => {
            let n = notes[k];
            let f = facts[k];
            let x = timed[k];
            let p = phrases[phrase_of[k]];
            let next = nexts[k];
            let before = befores[k];
            let b = after[k];
            let step_in = x.step_in;
            // Breath added into an upward leap (toward the note's end) and on its
            // landing (at the start), and a breath nearly spent pushed and wavering.
            let rise = if f.step < 5 || !f.joined { 0 } else { o.support * min(1, f.step / 12) };
            let land = if step_in == null || step_in < 5 { 0 } else { o.support * min(1, step_in / 12) };
            let air = x.air;
            let fresh = air >= 0.25;
            let tired = if fresh { 0 } else { min(1, (0.25 - air) * 4) };
            // The rules ask at the attack, the middle and just before the end: those
            // are worked out once (`shaped` at x = 0, 1/2 and 63/64).
            let marks_k = if before == null { marks[k] } else { if marks[k].slur { merge(marks[k], {slur: false}) } else { marks[k] } };
            let slurs_on = f.slur && b == null;
            let d0 = curve_value(dynamic_range, if fresh { w0[k] * (1 + arc0[k]) + land } else { w0[k] * (1 + arc0[k]) + land + worn(tired, on[k]) });
            let mid = curve_value(dynamic_range, if fresh { w1[k] * (1 + arc1[k]) } else { w1[k] * (1 + arc1[k]) + worn(tired, on[k] + f.seconds / 2) });
            let d2 = curve_value(dynamic_range, if fresh { w2[k] * (1 + arc2[k]) + rise * 0.9609375 } else { w2[k] * (1 + arc2[k]) + rise * 0.9609375 + worn(tired, on[k] + f.seconds * 63 / 64) });
            let run = runs[k];
            let tuning = tendency[k] + tune_dynamic * (mid - 0.5) + tune_scatter * keyed_noise(ids[k], o.seed, "tuning");
            // The release and the plan, given the rule's gate, release offset,
            // data and expression (and the rule's whole result, for a rule of
            // the composer's).
            fn finished(gate, release_offset, data, ex, rest) {
                // Release: in a running line it follows the next note's attack (a slur
                // keeps its overlap, a tongued note its gap); a breath takes its time
                // from the note; a phrase's last note is held a little longer.
                let held = if gate == 1 { off[k] } else { sec(n.at + n.duration * gate) };
                let end = held + release_offset / 1s;
                // A phrase's last note before a rest is held a little into it: `hold` of
                // its length, at most `hold_max`. Never past the next bar line or the
                // part's next entry, nor more than half the rest, and `hold_section` as
                // long before a rest that leads into a new section (the part rests
                // across the bar line, or stops). The phrase's lengthening is mostly in
                // its timing (the final slowing); a note before a rest touches the rest
                // rather than overlapping what follows (KTH Final-ritard and Punctuation
                // rules, Friberg, Bresin and Sundberg 2006; Penel and Drake 1998, "Sources
                // of timing variations in music performance", Psychological Research 61).
                let hold = if k == p.last && gate > 0.6 && !f.joined {
                    let written_end = n.at + n.duration;
                    let row_k = if rows[k] + 1 < len(table) && written_end >= table[rows[k] + 1].start { rows[k] + 1 } else { rows[k] };
                    let row = table[row_k];
                    let bar = min(row.start + ceil((written_end - row.start) / row.length) * row.length,
                        if row_k + 1 < len(table) { table[row_k + 1].start } else { written_end + row.length });
                    let section = next == null || next.at > bar;
                    let limit = min(sec(bar), if next == null { 1000 } else { on[k + 1] }) - (end + shift[k]);
                    max(0, min(min(o.hold * f.seconds * gate, o.hold_max) * (if section { o.hold_section } else { 1 }),
                        min(limit, if next == null { 1000 } else { f.gap * 0.5 })))
                } else { 0 };
                let target = if b != null {
                    if f.joined { min(end, off[k] - b.take) + shift[k + 1] - b.late } else {
                        end + shift[k] + min(hold, max(0, (f.gap - need) * 0.5))
                    }
                } else { if f.joined {
                    end + shift[k + 1] - (if f.slur || abs(f.step) < 5 { 0 } else { leap_gap })
                } else { end + shift[k] + hold } };
                let release = max(target - held - shift[k], 0.02 - (held - on[k]));
                let by = if level_of == null { 1 } else { level_of(n) };
                let expression = if by == 1 { ex } else {
                    let v = merge({volume: 1}, ex).volume;
                    merge(ex, {volume: if listed(v) { scaled(v, by) } else { v * by }})
                };
                let plan = {phrase: phrase_of[k], boundary: boundaries[k], air: air, peak: k == p.peak_k, issues: if clean { [] } else { let h = found[str(k)]; if h == null { [] } else { h } }, breath: if b == null { null } else {
                    // The inhale: it ends at the next performed attack.
                    {kind: if f.forced { if f.mark { "mark" } else { "rest" } } else { if b.exhale { "exhale" } else { if f.slur { "slur" } else { "planned" } } },
                     why: b.why, refill: b.refill, seconds: min(b.full, b.time), at: next.at / 1b, offset: shift[k + 1]}
                }};
                let played = {gate: gate, offset: n.offset + shift[k] * 1s, release_offset: release * 1s, data: merge(data, {expression: expression, plan: plan})};
                if rest == null { played } else { merge(rest, played) }
            }
            if own_rule {
                // `phrased`, played inline with `articulated` (`noted`'s rule:
                // keep the three the same).
                let own = owns[k];
                let mk = marks_k;
                let phrase_end = b != null || !f.joined;
                let staccato = mk.staccato;
                let accent = mk.accent || mk.hard;
                let softly = !accent && (mk.soft || (if softs == null { soft_all } else { softs[k] }));
                let fading = mk.niente;
                let growing = mk.dal_niente;
                let gate = if staccato { 0.5 } else { if slurs_on || mk.tenuto { 1 } else { n.gate } };
                let seconds = f.seconds * gate;
                // A short note blown harder (`short`).
                let blow = if seconds >= 0.3 || x.speak == 0 { 1 } else {
                    1 + (curve_value(loudness, seconds) - curve_value(loudness, max(0.002, seconds - x.speak))) * short_breath
                };
                let firm_tongue = if blow == 1 { 1 } else { 1 + min(1, (blow - 1) / firm_per) * short_tongue };
                let falls = phrase_end && seconds > 0.3 && !staccato && !mk.tenuto;
                let tail = if falls && !fading { [[0.84, d2], [1, max(0.2, d2 * 0.8)]] } else { [[1, d2]] };
                let breath = if growing {
                    [[0, 0.12], [0.4, mid * 0.9], [0.6, mid]] + tail
                } else { if mk.slur {
                    [[0, d0], [0.5, mid]] + tail
                } else { if accent {
                    [[0ms, d0], [12ms, min(1, d0 * 1.3)], [90ms, d0], [0.5, mid]] + tail
                } else { if softly && !staccato {
                    (if step_in != null { [[0ms, d0 * 0.7], [style.soft * 0.4, d0 * 0.9]] } else { [[0ms, max(0.1, d0 * 0.35)], [style.soft * 0.4, d0 * 0.8]] })
                        + [[style.soft, d0], [0.5, mid]] + tail
                } else { if blow == 1 {
                    let lift = if staccato { 1.08 } else { 1 };
                    [[0ms, d0 * 0.85 * lift], [20ms, min(1, d0 * 1.06 * lift)], [70ms, d0], [0.5, mid]] + tail
                } else {
                    // A short note blown harder (`short`).
                    let lift = (if staccato { 1.08 } else { 1 }) * blow;
                    [[0ms, min(1, d0 * 0.85 * lift)], [20ms, min(1, d0 * 1.06 * lift)], [70ms, min(1, d0 * blow)], [0.5, min(1, mid * blow)], [1, min(1, d2 * blow)]]
                } } } } };
                let base_tongue = if mk.hard { 1 } else { if accent { 0.8 } else { if mk.slur || growing { 0 } else {
                    if staccato { if softly { 0.2 } else { 0.4 } } else { if softly { 0.15 } else { 0.4 } }
                } } };
                let noise = if mk.breathy { 1 } else { if fading { 0.2 } else { curve_value(airy, mid) } };
                let tongued = base_tongue > 0;
                let ku = double && tongued && run % 2 == 1;
                let tongue = if tongued {
                    min(1, base_tongue * (if k == p.first { tongue_phrase } else { 1 }) * (metric_base + metric * f.weight)
                        * (if k > 0 && notes[k - 1].pitch == n.pitch && (!f.slurred || before != null) { tongue_repeat } else { 1 })
                        * paced[k]
                        * (if ku { k_tongue } else { 1 }) * own.tongue * firm_tongue)
                } else { 0 };
                // `voice.shape` and `voice.tract`, inline.
                let syllable = if !tongued { {} } else { if ku { sy_ku } else { if accent { sy_firm } else { if softly { sy_da } else {
                    if rates[k] <= tongue_fast { sy_ta } else { toward(sy_ta, sy_light, min(1, (rates[k] - tongue_fast) * toward_light)) }
                } } } };
                let shape = if blow == 1 { syllable } else { if ku || accent { syllable } else { voice.firmed(syllable, min(1, (blow - 1) / firm_per)) } };
                let cents = (if own.tuning != null { own.tuning } else { tuning }) / 100;
                let tuned = if abs(cents) < 0.002 { {} } else {
                    {tuning: if seconds > settling_s { [[0ms, cents], [correct, cents], [settled, cents * keep]] } else { cents }}
                };
                let tract = if n.pitch >= high_from { voice.high(n.pitch) } else { if ku { ku_tract } else {
                    if step_in == null || seconds <= 0.1 { {} } else { if step_in > 0 { if x.breaks_in || step_in > 7 { voice.up(n.pitch) } else { {} } } else {
                        if mk.slur && x.breaks_in { voice_down } else { {} }
                    } }
                } };
                let i = if vibrated && seconds >= vibrato_min && mid > 0.18 { max(0, min(1, 0.25 + arc1[k] * arc_scale + mid * 0.5)) } else { 0 - 1 };
                let vibrato = if i >= 0 && own.vibrato > 0 && seconds >= vibrato_min + (1 - i) * 0.25
                    && (mk == none_marked || !(mk.flutter || mk.breathy || mk.niente)) {
                    let depth = min(1, curve_value(vibrato_depth, mid) * (0.7 + 0.6 * i) * own.vibrato);
                    let delay = min(220ms, seconds * 250ms) * (1.25 - 0.5 * i);
                    let rate = 0.35 + 0.3 * i;
                    {vibrato: [unvibrated, [delay, 0], [delay + min(450ms, seconds * 400ms), depth]]
                        + if k == p.last && seconds > 0.6 { [[0.8, depth], [1, depth * 0.35]] } else { [] },
                     vibrato_rate: [[0, rate], [1, rate + 0.05]]}
                } else { {} };
                let release = if slurs_on { style.slur } else { if phrase_end || staccato { 0ms } else { 0ms - min(30, seconds * 1000 * 0.12) * 1ms } };
                finished(gate, n.release_offset + release, n.data, merge({velocity_breath: 0, pressure: breath, tongue: tongue,
                    noise: if air >= 0.25 { noise } else { min(0.95, noise + 0.12 * min(1, (0.25 - air) * 4)) },
                    volume: if fading { level_niente } else { if growing { level_dal_niente } else { if falls { level_falls } else { 1 } } }},
                    if mk.flutter { fluttered } else { {} }, shape, tuned, tract, vibrato, own.expression), null)
            } else {
                // The note after a breath is tongued even if marked slurred.
                let has = if before == null { marked } else { fn(y, name) => if name == "slur" && y.key == n.key { false } else { marked(y, name) } };
                let t1 = mids[k];
                let t2 = tails[k];
                fn shaped(t, written_here) {
                    let u = max(0, min(1, (t - n.at) / n.duration));
                    // Seconds within the note are taken as straight in score time.
                    let ts = on[k] + (t - n.at) / n.duration * f.seconds;
                    max(0.1, min(1, written_here * (1 + arc_at(p, ts)) + rise * max(0, u - 0.6) * 2.5 + land * max(0, 1 - u * 3.333) + if tired > 0 { worn(tired, ts) } else { 0 }))
                }
                fn dynamic(t) = if t == n.at { d0 } else { if t == t1 { mid } else { if t == t2 { d2 } else { shaped(t, written(k)(t)) } } };
                let r = o.rule(n, {
                    next: next, prev: if k > 0 { notes[k - 1] } else { null }, seconds: f.seconds, dynamic: dynamic, attack: d0, middle: mid, ending: d2,
                    has: has, marks: marks_k, style: style, soft: if softs == null { soft_all } else { softs[k] },
                    interval: if f.joined { f.step } else { null }, interval_in: step_in,
                    crosses_break: f.cross, breaks_in: x.breaks_in,
                    phrase_pos: max(0, min(1, (on[k] - p.t0) / p.length)), phrase_first: k == p.first, phrase_last: k == p.last,
                    metric_weight: f.weight, note_rate: rates[k], air_left: air, breath_before: before, breath_after: b, slurs_on: slurs_on,
                    intensity: max(0, min(1, 0.25 + arc1[k] * arc_scale + mid * 0.5)), run: run,
                    repeat: k > 0 && notes[k - 1].pitch == n.pitch && (!f.slurred || before != null), tuning: tuning, player: pl, options: o,
                    // A short tongued note is blown harder by the loudness it
                    // loses while it speaks (`short`).
                    blow: if f.seconds >= 0.6 || x.speak == 0 { 1 } else {
                        let sounding = f.seconds * (if marks_k.staccato { 0.5 } else { if slurs_on || marks_k.tenuto { 1 } else { n.gate } });
                        if sounding >= 0.3 { 1 } else {
                            1 + (curve_value(loudness, sounding) - curve_value(loudness, max(0.002, sounding - x.speak))) * short_breath
                        }
                    }
                });
                // `phrased` returns every field; another rule may leave some out.
                let data = merge(n.data, merge({data: {}}, r).data);
                finished(merge({gate: n.gate}, r).gate, merge({release_offset: n.release_offset}, r).release_offset, data,
                    merge({expression: {}}, data).expression, r)
            }
        });
        pattern.map_notes(fn(n) => patches[order[n.key]])
    }
    // What the other parts of an ensemble hear of this one (see `ensemble`):
    // {say (a step curve, in seconds, of the part's say in the shared time:
    // in each phrase, its role at the phrase's last note times its attacks a
    // beat, at most one, and nothing between phrases), slowings and lates (its
    // final slowings and its late entries after breaths: {from, to, at (the
    // arrival or entry), points}, in seconds), entries ({k, at, late, chair}
    // for its first note and each note after a breath, with its own drift
    // there), chair (its own drift: {curve, scale}, or null), cue
    // (`ensemble.cue`), own (each attack's own asynchrony and lead, or null)}.
    // A slowing eases back from its arrival over `ensemble.recover` beats, or
    // by the part's next attack.
    fn heard() {
        let role = o.role;
        let roles = map(phrases, fn(p) => if callable(role) { role(notes[p.last]) } else { if listed(role) { interp(role, notes[p.last].at) } else { role } });
        let say = fold(phrases, [], fn(ps, p) => {
            let r = roles[p.j];
            let beats = (notes[p.last].at + notes[p.last].duration - notes[p.first].at) / table[rows[p.first]].beat;
            let n = len(ps);
            (if n > 0 && ps[n - 1][0] >= p.t0 * 1s { slice(ps, 0, n - 1) } else { if n == 0 && p.t0 > 0 { [[0s, 0]] } else { ps } })
                + [[p.t0 * 1s, r * min(1, (p.last - p.first + 1) / beats)], [p.t1 * 1s, 0]]
        });
        let recover = o.ensemble.recover;
        // A final slowing rises as the square of the way into its span: at a
        // third, a ninth of it; at two thirds, four ninths.
        let slowings = map(filter(phrases, fn(p) => p.slowing > 0), fn(p) => {
            let arrive = on[p.last];
            let back = arrive + p.beat_s * recover;
            let to = if p.last + 1 < count { min(on[p.last + 1], back) } else { back };
            let s = p.slowing;
            {from: p.from, to: to, at: arrive, points: [[p.from * 1s, 0], [(p.from + p.span / 3) * 1s, s / 9], [(p.from + p.span * 2 / 3) * 1s, s * 4 / 9], [arrive * 1s, s], [to * 1s, 0]]}
        });
        // The entries: the line's first note and the note after each breath,
        // with the chair's own drift there. A late entry is caught up as
        // 0.25 to the power of twice the seconds since it.
        let entries = if count == 0 { [] } else { [{k: 0, at: on[0], late: 0}] + map(bs, fn(b) => {k: b.k + 1, at: on[b.k + 1], late: b.late}) };
        let ne = len(entries);
        let lates = map(filter(range(1, ne), fn(q) => entries[q].late > 0), fn(q) => {
            let e = entries[q].at;
            let l = entries[q].late;
            let to = if q + 1 < ne { min(e + 2, entries[q + 1].at - 0.002) } else { e + 2 };
            {from: e - 0.001, to: to, at: e, points: [[(e - 0.001) * 1s, 0], [e * 1s, l]] + map(filter([[e + 0.25, l / 2], [e + 0.5, l / 4], [e + 1, l / 16]], fn(x) => x[0] < to), fn(x) => [x[0] * 1s, x[1]]) + [[to * 1s, 0]]}
        });
        // The part's own asynchrony with the others: `asynchrony` over the
        // square root of two (as its standard deviation), a new value every
        // fourth attack and eased between (players correct an asynchrony over
        // the next few attacks), smaller at a faster beat (as its square root,
        // down to 0.7 times its size at crotchet = 88); and the tune's lead.
        // Each value is early or late by 0.6 to 1 of a bound, 1.43 times the
        // deviation, so no two parts are further apart than about twice it.
        let sync = o.ensemble;
        let per = sync.asynchrony / 1s / pow(2, 0.5) / 0.697;
        let melody = sync.melody / 1s;
        let led = melody != 0 && len(filter(roles, fn(r) => r > 1)) > 0;
        let own = if count == 0 || per <= 0 && !led { null } else {
            // Per phrase: the noise's size, and the lead.
            let size = map(phrases, fn(p) => per * clamp(pow(p.beat_s / 0.682, 0.5), 0.7, 1));
            let lead = map(roles, fn(r) => if led && r > 1 { 0 - melody } else { 0 });
            let seed = o.seed;
            curve_value({shape: "smooth", points: map(range(floor((count - 1) / 4) + 2), fn(i) => {
                let j = phrase_of[min(i * 4, count - 1)];
                let x = keyed_noise(["asynchrony", i], seed);
                [i * 4, if led { (if x < 0 { x * 0.4 - 0.6 } else { x * 0.4 + 0.6 }) * size[j] + lead[j] } else { (if x < 0 { x * 0.4 - 0.6 } else { x * 0.4 + 0.6 }) * size[j] }]
            })}, range(count))
        };
        {say: {shape: "step", points: if len(say) == 0 { [[0s, 0]] } else { say }}, slowings: slowings, lates: lates, own: own,
         entries: map(entries, fn(x) => merge(x, {chair: chair[x.k] * chair_drift})),
         chair: if chair_curve == null { null } else { {curve: chair_curve, scale: chair_drift} }, cue: o.ensemble.cue}
    }
    {on: on, slowing: slowing, heard: heard, finish: finish}
}

fn play(pattern, spec, options = {}) {
    let line = reading(pattern, spec, options);
    line.finish(line.slowing, null, null)
}

// --- The ensemble ----------------------------------------------------------------
//
// `ensemble(parts, options)` plays several parts as one ensemble with one
// pulse. `parts` is a record of names to `[pattern, spec, options]` (as
// `play` takes them; the part's options win over the shared `options`, and
// its name is its `part`); it returns a record of the same names to the
// played patterns.
//
// Each part's player reads its own line, as `play` does, and plans where its
// phrases end and how much each slows into its end. Ensembles share one
// timekeeper: the players correct toward one another's timing at every attack
// (the linear phase correction of Wing et al. 2014, "Optimal feedback
// correction in string quartet synchronization", J. R. Soc. Interface 11:
// 20131125), so a ritard is played only as far as the ensemble agrees to it.
// Each attack's final slowing is the mean of every part's own slowing at that
// moment, weighted by each part's say: its `role` (1 by default; a melody or
// lead 2, a part that only follows 0), times how many attacks it plays in a
// beat (at most one), and nothing while it rests or before it enters. A part
// holding a long note hardly drives the time; a part that keeps running holds
// the pulse. When every part cadences together they slow together; when the
// lead cadences over an accompaniment that runs on, the accompaniment follows
// part of the way, and the lead slows less. Leaders are corrected less than
// followers (Wing et al.'s first violinists; Goebl and Palmer 2009,
// "Synchronization of timing and motion among performing musicians", Music
// Perception 26(5):427-438, on leader and follower roles), and an ensemble's
// cohesion rests on a shared plan of the expressive timing (Keller 2008,
// "Joint action in music performance", in Morganti et al., Enacting
// Intersubjectivity, IOS Press). Entries are shared the same way: a part's
// lateness entering after a breath counts by its say there, so a lone
// breather among parts running on is mostly absorbed and parts breathing
// together enter together; and a part entering takes `ensemble.cue` of the
// way from its own drift to the ensemble's (players cue one another's
// entries). Each part keeps its motor noise, lead, leap timing and, between
// entries, its own drift, and an asynchrony of its own calibrated to Rasch's
// measurements: two wind players' attacks differ by about 32 ms at crotchet =
// 88 (1979, "Synchronization in performed ensemble music", Acustica
// 43:121-131; 1998), less at faster tempi, and the melody leads by 5-10 ms
// (1988, "Timing and synchronization in ensemble performance", in Sloboda,
// Generative Processes in Music).
fn ensemble(parts, options = {}) {
    let names = keys(parts);
    let lines = map(names, fn(name) => {
        let x = parts[name];
        reading(x[0], x[1], merge({part: name}, options, if len(x) > 2 { x[2] } else { {} }))
    });
    let count = len(lines);
    let heard = if count < 2 { [] } else { map(lines, fn(l) => l.heard()) };
    // Each part's slowings and late entries, scaled by its part of the say at
    // the cadence or entry: its own say over every part's there. Every part
    // plays on their sum. (Curves in seconds: curves of beats would round them.)
    let curves = fold(range(len(heard)), [], fn(out, i) => {
        let h = heard[i];
        let at = map(h.slowings + h.lates, fn(z) => z.at);
        let says = map(heard, fn(g) => curve_value(g.say, at));
        let part = map(range(len(at)), fn(q) => { let all = fold(says, 0, fn(a, s) => a + s[q]); if all == 0 { 1 } else { says[i][q] / all } });
        fn curve(zs, from) = if len(zs) == 0 { [] } else { [{shape: "linear", points: fold(range(len(zs)), [], fn(ps, q) => {
            let s = part[from + q];
            let pts = map(zs[q].points, fn(x) => [x[0], x[1] * s]);
            if len(ps) > 0 && ps[len(ps) - 1][0] >= pts[0][0] { ps + slice(pts, 1, len(pts)) } else { ps + pts }
        })}] };
        out + curve(h.slowings, 0) + curve(h.lates, len(h.slowings))
    });
    // A part entering, at its first note or after a breath, takes up the
    // ensemble's time: its own drift moves `ensemble.cue` (0.75) of the way to
    // the say-weighted mean of every part playing there (its own included),
    // and its own drift takes over again as a late entry is caught up.
    record(map(range(count), fn(j) => {
        let line = lines[j];
        let h = if count < 2 { null } else { heard[j] };
        let lates = if h == null { null } else { if h.chair == null || len(h.entries) == 0 { map(line.on, fn(t) => 0) } else {
            let entries = h.entries;
            let at = map(entries, fn(x) => x.at);
            let others = map(filter(range(count), fn(i) => i != j && heard[i].chair != null), fn(i) => {
                let c = heard[i].chair;
                [curve_value(heard[i].say, at), map(curve_value(c.curve, at), fn(v) => v * c.scale)]
            });
            let mine = curve_value(h.say, at);
            let cue_part = h.cue;
            let cue = map(range(len(entries)), fn(q) => {
                let sums = fold(others, [0, 0], fn(a, r) => { let s = r[0][q]; if s == 0 { a } else { [a[0] + s * r[1][q], a[1] + s] } });
                let c = entries[q].chair;
                if sums[1] == 0 { 0 } else { cue_part * ((sums[0] + mine[q] * c) / (sums[1] + mine[q]) - c) }
            });
            // Caught up as a late entry is (see `heard`).
            let ne = len(entries);
            let points = fold(range(ne), [], fn(ps, q) => {
                let c = cue[q];
                let e = at[q];
                if c == 0 { ps } else {
                    let to = if q + 1 < ne { min(e + 2, at[q + 1] - 0.002) } else { e + 2 };
                    ps + (if e < 0.001 { [] } else { [[(e - 0.001) * 1s, 0]] }) + [[e * 1s, c]]
                        + map(filter([[e + 0.25, c / 2], [e + 0.5, c / 4], [e + 1, c / 16]], fn(x) => x[0] < to), fn(x) => [x[0] * 1s, x[1]]) + [[to * 1s, 0]]
                }
            });
            if len(points) == 0 { map(line.on, fn(t) => 0) } else { curve_value({shape: "linear", points: points}, line.on) }
        } };
        let own = if h == null { null } else { h.own };
        let shared = if len(curves) == 0 { line.slowing } else {
            let sums = map(curves, fn(c) => curve_value(c, line.on));
            if len(sums) == 1 { sums[0] } else { if len(sums) == 2 { let s0 = sums[0]; let s1 = sums[1]; map(range(len(line.on)), fn(k) => s0[k] + s1[k]) } else {
                map(range(len(line.on)), fn(k) => fold(sums, 0, fn(a, s) => a + s[k])) } }
        };
        [names[j], line.finish(shared, lates, own)]
    }))
}

// The unplayable material `play` found in a part, as its records (see
// `unplayable_in`), accepted ones included: `unplayable(played)`.
fn unplayable(played) = fold(sort_by(played.notes, fn(n) => n.at), [], fn(out, n) =>
    out + merge({plan: {issues: []}}, n.data).plan.issues);
// A track check reporting what `play` (with `strict: false`) found unplayable
// and was not accepted: `track("fl", line, w.flute(), {checks: [w.playable()]})`.
// `level` "error" fails compilation.
fn playable(level = "warning") {
    fn playable(notes) = fold(sort_by(notes, fn(n) => n.at), [], fn(out, n) => {
        let found = filter(merge({plan: {issues: []}}, n.data).plan.issues, fn(x) => !x.accepted);
        out + map(found, fn(x) => {code: "woodwinds." + x.code, message: x.message, at: n.at, severity: level})
    });
    playable
}
