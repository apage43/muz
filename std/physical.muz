// Blown instruments as waveguides: a bore is a delay line, and the reed or air jet
// that drives it sits inside the loop. Everything here is an ordinary signal record
// built from std/signal, so a piece can copy a recipe and change any part of it.
//
// A model takes the mouth pressure and the sounding frequency and returns
//   {inside, radiated, feedback}
// `inside` is the pressure at the mouthpiece (dark), `radiated` what leaves the
// open end (bright), and `feedback` the list a voice_patch needs to close the
// loops: `voice_patch(name, {output: ..., feedback: model.feedback})`.
// Pressures are normalized: a reed closes near 1, and each model documents the
// range in which it speaks.
use "std/signal" as s;

let tau = 6.283185307179586;
fn sub(a, b) = s.add([a, s.mul([b, -1])]);
fn lag_point(x) = [x, atan(x) / tau];
let lag_points = map(range(64), fn(i) => lag_point(16 * pow(i / 63, 2)));
// atan(ratio) in cycles, for ratios 0..16: the phase of a one-pole filter.
fn lag(ratio) = s.shape(ratio, lag_points, "raw");
// Seconds by which `s.lowpass1(x, cutoff)` delays a partial at `frequency`. Take
// it off a loop's line so the loop still sounds at `frequency`.
fn lowpass1_delay(frequency, cutoff) = s.mul([
    s.period(frequency),
    lag(s.mul([frequency, s.period(cutoff)]))
]);
// Seconds by which `s.highpass1(x, cutoff)` advances a partial at `frequency`.
fn highpass1_advance(frequency, cutoff) = s.mul([
    s.period(frequency),
    lag(s.mul([cutoff, s.period(frequency)]))
]);
// `frequency` moved by `amount` cents.
fn cents(frequency, amount) = s.octaves(frequency, s.mul([amount, 1 / 1200]));

// A reed as a pressure-controlled valve. `mouth` is the breath pressure and `bore`
// the wave arriving from the bore; the result is the wave sent back into it.
// `aperture` is the reflection with no pressure across the reed (a tighter
// embouchure is higher), and `stiffness` how fast pressure closes it. At
// aperture + stiffness * mouth >= 1 the reed is held shut and the note chokes.
// An open, stiff reed (the default) speaks within a few periods of the breath
// arriving; a closed, soft one (0.7, 0.3) takes several times longer, and needs
// pressures of 0.7 to 1.
fn reed(mouth, bore, aperture = 0.4, stiffness = 0.95) {
    let across = sub(bore, mouth);
    let reflect = s.mapping(s.add([aperture, s.mul([across, -stiffness])]), "clamp", -1, 1);
    s.add([mouth, s.mul([across, reflect])])
};
// An air jet crossing an edge: displacement in, flow into the pipe out.
fn jet(x) = s.mapping(s.mul([x, s.add([s.mul([x, x]), -1])]), "clamp", -1, 1);

// A cylindrical bore closed by a reed: odd harmonics, sounding an octave below
// an open pipe of the same length (clarinet family). `tone` is the cutoff of the
// open end's reflection: below it the bore resonates, above it sound radiates.
// Speaks for mouth pressures of about 0.36 to 0.62; the highest notes need 0.44
// to 0.6.
fn cylinder(mouth, frequency, options = {}) {
    let o = merge({tone: 2500Hz, loss: 0.95, aperture: 0.4, stiffness: 0.95}, options);
    let bore = s.line(sub(s.mul([s.period(frequency), 0.5]), lowpass1_delay(frequency, o.tone)));
    let returned = s.mul([s.lowpass1(bore, o.tone), -o.loss]);
    {
        inside: s.add([bore, returned]),
        radiated: s.highpass1(bore, o.tone),
        feedback: [[bore, reed(mouth, returned, o.aperture, o.stiffness)]]
    }
};
// A conical bore closed by a reed: every harmonic (oboe, bassoon, saxophone
// families). The cone is a long open pipe and a short one, standing for the
// missing tip of the cone, joined at the reed. `apex` is the short pipe's share of
// the period: near 0.33 the fundamental is secure, smaller values favour the
// octave or twelfth, and at exactly 1/3 every third harmonic is missing. `tone` defaults to four times the sounding frequency, so
// every note keeps the same balance between its registers. Speaks for mouth
// pressures of about 0.36 to 0.62.
fn cone(mouth, frequency, options = {}) {
    let o = merge({
        tone: s.mul([frequency, 4]),
        loss: 0.95,
        apex: 0.33,
        apex_loss: 0.98,
        aperture: 0.4,
        stiffness: 0.95
    }, options);
    let period = s.period(frequency);
    let long = s.line(sub(s.mul([period, sub(1, o.apex)]), lowpass1_delay(frequency, o.tone)));
    let short = s.line(s.mul([period, o.apex]), {max_seconds: 25ms});
    let from_long = s.mul([s.lowpass1(long, o.tone), -o.loss]);
    let from_short = s.mul([short, -o.apex_loss]);
    let arriving = s.mul([s.add([from_long, from_short]), 0.5]);
    let inside = s.add([reed(mouth, arriving, o.aperture, o.stiffness), arriving]);
    {
        inside: inside,
        radiated: s.highpass1(long, o.tone),
        feedback: [[long, sub(inside, from_long)], [short, sub(inside, from_short)]]
    }
};
// An open pipe driven by an air jet (flute, recorder, pipe families). `jet` is the
// time the jet takes to cross to the edge, as a share of the period: 0.5 sounds
// the fundamental, 0.25 overblows the octave, and values between bend the pitch
// (about 8 cents per 0.01) as a player's lips do. `coupling` is how strongly the
// pipe moves the jet and `reflection` how much the pipe keeps. Speaks for mouth
// pressures of about 0.5 to 1.3; lower pressures give breath alone.
fn flue(mouth, frequency, options = {}) {
    let o = merge({tone: 3000Hz, jet: 0.5, coupling: 0.5, reflection: 0.5, dc: 8Hz}, options);
    let period = s.period(frequency);
    let bore = s.line(
        s.add([
            period,
            s.mul([lowpass1_delay(frequency, o.tone), -1]),
            highpass1_advance(frequency, o.dc)
        ])
    );
    let across = s.line(s.mul([period, o.jet]), {max_seconds: 25ms});
    let returned = s.highpass1(s.lowpass1(bore, o.tone), o.dc);
    {
        inside: bore,
        radiated: s.highpass1(bore, o.tone),
        feedback: [
            [across, sub(mouth, s.mul([returned, o.coupling]))],
            [bore, s.add([jet(across), s.mul([returned, o.reflection])])]
        ]
    }
};

// What a player does to one note, read from the note itself. `level` (0..1) is
// velocity plus the note's `pressure` curve, so a swell is `.express({pressure:
// [[0, 0], [1, 0.5]]})`; `brightness` opens or darkens `tone` by up to an octave;
// `vibrato` is the depth of a pitch and breath vibrato at `vibrato_hz`. Curves
// arrive on the 128-frame expression clock and are smoothed here.
fn player(options = {}) {
    let o = merge({vibrato_hz: 5.2Hz, vibrato_cents: 30, drift_cents: 3, smooth: 12ms}, options);
    let level = s.slew(
        s.mapping(s.add([s.velocity(), s.expression("pressure")]), "clamp", 0, 1),
        o.smooth,
        o.smooth
    );
    let depth = s.slew(s.expression("vibrato"), 60ms, 60ms);
    let wobble = s.mul([s.sine({hz: o.vibrato_hz}), depth]);
    {
        level: level,
        wobble: wobble,
        frequency: cents(
            s.frequency(),
            s.add([
                s.mul([wobble, o.vibrato_cents]),
                s.mul([s.drift(3Hz, 300ms), o.drift_cents])
            ])
        ),
        brightness: s.mul([
            s.add([s.slew(s.expression("brightness"), o.smooth, o.smooth), -0.5]),
            2
        ])
    }
};
// Mouth pressure: `envelope` (the tongue) times a pressure between `low` and
// `high` chosen by `level`, with turbulence `air` and the vibrato's breath pulse.
fn breath(envelope, level, low, high, air = 0.08, wobble = 0, pulse = 0.06) = s.mul([
    envelope,
    s.add([low, s.mul([level, high - low])]),
    s.add([1, s.mul([s.lowpass1(s.noise(), 6000Hz), air]), s.mul([wobble, pulse])])
]);
// A reed or jet saturates, so breath alone changes the level little. This is the
// rest of a dynamic: gain from `floor` (at level 0) to 1, and a lowpass that opens
// from harmonic `dark` of `frequency` to harmonic `bright`.
fn dynamics(input, frequency, level, floor = 0.25, dark = 2, bright = 20) = s.mul([
    s.lowpass1(
        input,
        s.mapping(
            s.mul([frequency, s.add([dark, s.mul([level, level, bright - dark])])]),
            "clamp",
            200Hz,
            18000Hz
        )
    ),
    s.add([floor, s.mul([level, 1 - floor])])
]);
// Fixed resonances of an instrument's body or bell: `formants` is a list of
// [frequency, q, gain] added to the dry signal.
fn body(input, formants) = s.add(
    [input] + map(formants, fn(f) => s.mul([s.filter(input, f[0], f[1], "bandpass"), f[2]]))
);

// B-flat clarinet, D3 to about G6. Odd harmonics in the low register, brightening
// with breath. `air` is breath noise and `tone` the bore's cutoff.
fn clarinet(options = {}) {
    let o = merge({tone: 2400Hz, air: 0.05, attack: 12ms, release: 70ms, gain_db: -8}, options);
    let p = player(o);
    let tongue = s.adsr(o.attack, 200ms, 0.92, o.release);
    let tone = s.octaves(
        s.mapping(s.mul([p.frequency, 3.2]), "clamp", o.tone, 12000Hz),
        p.brightness
    );
    let bore = cylinder(breath(tongue, p.level, 0.44, 0.57, o.air, p.wobble), p.frequency, {
        tone: tone
    });
    voice_patch("clarinet", {
        gain_db: o.gain_db,
        velocity_track: 0,
        output: dynamics(
            s.add([s.mul([bore.inside, 0.25]), s.mul([bore.radiated, 1.4])]),
            p.frequency,
            p.level
        ),
        feedback: bore.feedback,
        lifetime: {envelope: tongue, tail: 150ms}
    })
};
// Concert flute, C4 to about C7. `air` is the breath in the tone and `chiff` the
// burst of it at the start of a note. A note's `jet` control (0.5 at rest) is the
// lip: lower values sharpen and, near 0.25, overblow the octave.
fn flute(options = {}) {
    let o = merge({
        tone: 3200Hz,
        air: 0.12,
        chiff: 0.5,
        attack: 55ms,
        release: 110ms,
        gain_db: -14
    }, options);
    let p = player(o);
    let tongue = s.adsr(o.attack, 250ms, 0.9, o.release);
    let onset = s.adsr(2ms, 120ms, 0, 50ms, true);
    let tone = s.octaves(
        s.mapping(s.mul([p.frequency, 3]), "clamp", o.tone, 14000Hz),
        p.brightness
    );
    let pipe = flue(
        breath(tongue, p.level, 0.9, 1.3, s.add([o.air, s.mul([onset, o.chiff])]), p.wobble),
        p.frequency,
        {tone: tone, jet: s.slew(s.expression("jet"), 20ms, 20ms)}
    );
    voice_patch("flute", {
        note_controls: {jet: 0.5},
        gain_db: o.gain_db,
        velocity_track: 0,
        output: dynamics(
            s.add([s.mul([pipe.inside, 0.5]), s.mul([pipe.radiated, 1.2])]),
            p.frequency,
            p.level
        ),
        feedback: pipe.feedback,
        lifetime: {envelope: tongue, tail: 200ms}
    })
};
// Oboe, B-flat3 to about G6: a narrow cone and a stiff double reed, with the
// instrument's two fixed formants. Other conical reeds are the same model with
// their own `formants`, `apex` and range.
fn oboe(options = {}) {
    let o = merge({
        air: 0.03,
        attack: 10ms,
        release: 60ms,
        apex: 0.31,
        formants: [[1100Hz, 4, 0.9], [2900Hz, 5, 0.6]],
        gain_db: -14
    }, options);
    let p = player(o);
    let tongue = s.adsr(o.attack, 150ms, 0.94, o.release);
    let bore = cone(breath(tongue, p.level, 0.4, 0.56, o.air, p.wobble), p.frequency, {
        apex: o.apex,
        tone: s.octaves(s.mul([p.frequency, 4]), p.brightness)
    });
    voice_patch("oboe", {
        gain_db: o.gain_db,
        velocity_track: 0,
        output: dynamics(
            body(s.add([s.mul([bore.inside, 0.3]), bore.radiated]), o.formants),
            p.frequency,
            p.level
        ),
        feedback: bore.feedback,
        lifetime: {envelope: tongue, tail: 150ms}
    })
}
