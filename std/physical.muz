// Blown instruments as waveguides: a bore is a delay line, and the reed or air jet
// that drives it sits inside the loop. Everything here is an ordinary signal record
// built from std/signal, so a piece can copy a recipe and change any part of it.
//
// A model takes the mouth pressure and the sounding frequency and returns
//   {inside, radiated, feedback}
// `inside` is the pressure at the mouthpiece (dark), `radiated` what leaves the
// open end (bright), and `feedback` the list a voice_patch needs to close the
// loops: `voice_patch(name, {output: ..., feedback: model.feedback})`.
// Pressures are normalized: a reed closes near 1, and each model documents the
// range in which it speaks.
use "std/signal" as s;

let tau = 6.283185307179586;
fn sub(a, b) = s.add([a, s.mul([b, -1])]);
fn lag_point(x) = [x, atan(x) / tau];
let lag_points = map(range(64), fn(i) => lag_point(16 * pow(i / 63, 2)));
// atan(ratio) in cycles, for ratios 0..16: the phase of a one-pole filter.
fn lag(ratio) = s.shape(ratio, lag_points, "raw");
// Seconds by which `s.lowpass1(x, cutoff)` delays a partial at `frequency`. Take
// it off a loop's line so the loop still sounds at `frequency`.
fn lowpass1_delay(frequency, cutoff) = s.mul([
    s.period(frequency),
    lag(s.mul([frequency, s.period(cutoff)]))
]);
// Seconds by which `s.highpass1(x, cutoff)` advances a partial at `frequency`.
fn highpass1_advance(frequency, cutoff) = s.mul([
    s.period(frequency),
    lag(s.mul([cutoff, s.period(frequency)]))
]);
// `frequency` moved by `amount` cents.
fn cents(frequency, amount) = s.octaves(frequency, s.mul([amount, 1 / 1200]));

// A reed as a pressure-controlled valve. `mouth` is the breath pressure and `bore`
// the wave arriving from the bore; the result is the wave sent back into it.
// `aperture` is the reflection with no pressure across the reed (a tighter
// embouchure is higher), and `stiffness` how fast pressure closes it. At
// aperture + stiffness * mouth >= 1 the reed is held shut and the note chokes.
// An open, stiff reed (the default) speaks within a few periods of the breath
// arriving; a closed, soft one (0.7, 0.3) takes several times longer, and needs
// pressures of 0.7 to 1.
fn reed(mouth, bore, aperture = 0.4, stiffness = 0.95) {
    let across = sub(bore, mouth);
    let reflect = s.mapping(s.add([aperture, s.mul([across, -stiffness])]), "clamp", -1, 1);
    s.add([mouth, s.mul([across, reflect])])
};
// An air jet crossing an edge: displacement in, flow into the pipe out. A
// symmetric cubic; `flue` uses `edge`.
fn jet(x) = s.mapping(s.mul([x, s.add([s.mul([x, x]), -1])]), "clamp", -1, 1);
fn tanh_number(x) = 1 - 2 / (pow(2.718281828459045, 2 * x) + 1);
// The flow of a jet aimed `offset` off an edge, against its displacement `x`, as
// a curve: tanh(sharpness * (x + offset)) less its value at rest, scaled to a
// slope of 1 at rest. Its two sides saturate at different distances, so the
// flow pulse is lopsided and the pipe hears even harmonics.
fn edge_points(offset, sharpness) {
    let rest = tanh_number(sharpness * offset);
    let slope = sharpness * (1 - rest * rest);
    map(range(64), fn(i) => {
        let x = -3 + 6 * i / 63;
        [x, (tanh_number(sharpness * (x + offset)) - rest) / slope]
    })
};

// A pipe from a driving end (a reed) to an open end, as one round trip of
// `seconds`. `tone` is the cutoff of the open end's reflection and `loss` its
// level. The caller closes the loop: `feedback: [[pipe.entry, entering]] +
// pipe.feedback`, where `entering` is the wave the driver sends in; `back` is
// the wave arriving at the driver, `bell` the pressure at the open end and
// `radiated` what leaves it.
//
// `vent` (0..1, a signal) opens a side hole `at` of the way from the driver,
// such as a clarinet's register key or an oboe's octave key. Closed, the pipe is
// one line. With a vent the pipe is three: down to the hole, back up from it,
// and the rest of the bore and back, joined at the hole. The hole is a lossy
// inertance: its pressure release is a one-pole lowpass at `cutoff` of depth
// `depth`, so it passes the wave on (a highpass) and reflects an inverted,
// lowpassed share of it. A mode with a pressure node at the hole passes it
// untouched; the others lose energy there, so the driver moves to that mode.
// `depth` near 0.5 is the most loss (a narrow, resistive hole); at 1 the hole is
// lossless and only drags the lower modes sharp.
fn pipe(seconds, frequency, options = {}) {
    let o = merge({tone: 2500Hz, loss: 0.95, vent: 0, at: 1 / 3, depth: 0.5, cutoff: s.mul([frequency, 4])}, options);
    if o.vent == 0 {
        let line = s.line(sub(seconds, lowpass1_delay(frequency, o.tone)));
        let back = s.mul([s.lowpass1(line, o.tone), -o.loss]);
        {entry: line, back: back, bell: s.add([line, back]), radiated: s.highpass1(line, o.tone), feedback: []}
    } else {
        let half = s.mul([seconds, o.at, 0.5]);
        let down = s.line(half, {max_seconds: 25ms});
        let up = s.line(half, {max_seconds: 25ms});
        let low = s.line(sub(s.mul([seconds, sub(1, o.at)]), lowpass1_delay(frequency, o.tone)));
        let reflected = s.mul([s.lowpass1(low, o.tone), -o.loss]);
        let arriving = s.add([down, reflected]);
        let hole = sub(arriving, s.mul([s.lowpass1(arriving, o.cutoff), o.vent, o.depth]));
        {
            entry: down,
            back: up,
            bell: s.add([low, reflected]),
            radiated: s.highpass1(low, o.tone),
            feedback: [[up, sub(hole, down)], [low, sub(hole, reflected)]]
        }
    }
};
// A cylindrical bore closed by a reed: odd harmonics, sounding an octave below
// an open pipe of the same length (clarinet family). `tone` is the cutoff of the
// open end's reflection: below it the bore resonates, above it sound radiates.
// Speaks for mouth pressures of about 0.36 to 0.62; the highest notes need 0.44
// to 0.6. `vent` opens a register hole at `vent_at` (a third of the bore, the
// twelfth's pressure node): the bore then sounds its twelfth, three times
// `frequency`.
fn cylinder(mouth, frequency, options = {}) {
    let o = merge({tone: 2500Hz, loss: 0.95, aperture: 0.4, stiffness: 0.95, vent: 0, vent_at: 1 / 3, vent_depth: 0.5}, options);
    let bore = pipe(s.mul([s.period(frequency), 0.5]), frequency, {
        tone: o.tone, loss: o.loss, vent: o.vent, at: o.vent_at, depth: o.vent_depth
    });
    {
        inside: bore.bell,
        radiated: bore.radiated,
        feedback: [[bore.entry, reed(mouth, bore.back, o.aperture, o.stiffness)]] + bore.feedback
    }
};
// A conical bore closed by a reed: every harmonic (oboe, bassoon, saxophone
// families). The cone is a long open pipe and a short one, standing for the
// missing tip of the cone, joined at the reed. `apex` is the short pipe's share of
// the period: near 0.33 the fundamental is secure, smaller values favour the
// octave or twelfth, and at exactly 1/3 every third harmonic is missing. `tone` defaults to four times the sounding frequency, so
// every note keeps the same balance between its registers. Speaks for mouth
// pressures of about 0.36 to 0.62. `vent` opens an octave hole on the long pipe
// at the octave's pressure node (half the whole cone from its tip): the bore
// then sounds its octave. A double reed's level barely follows its breath: see
// `dynamics`.
fn cone(mouth, frequency, options = {}) {
    let o = merge({
        tone: s.mul([frequency, 4]),
        loss: 0.95,
        apex: 0.33,
        apex_loss: 0.98,
        aperture: 0.4,
        stiffness: 0.95,
        vent: 0,
        vent_depth: 0.5
    }, options);
    let period = s.period(frequency);
    let long = pipe(s.mul([period, sub(1, o.apex)]), frequency, {
        tone: o.tone, loss: o.loss, vent: o.vent, depth: o.vent_depth,
        at: s.mul([sub(0.5, o.apex), s.mapping(sub(1, o.apex), "reciprocal")])
    });
    let short = s.line(s.mul([period, o.apex]), {max_seconds: 25ms});
    let from_short = s.mul([short, -o.apex_loss]);
    let arriving = s.mul([s.add([long.back, from_short]), 0.5]);
    let inside = s.add([reed(mouth, arriving, o.aperture, o.stiffness), arriving]);
    {
        inside: inside,
        radiated: long.radiated,
        feedback: [[long.entry, sub(inside, long.back)], [short, sub(inside, from_short)]] + long.feedback
    }
};
// An open pipe driven by an air jet (flute, recorder, pipe families). `jet` is the
// time the jet takes to cross to the edge, as a share of the period: 0.5 sounds
// the fundamental, 0.25 overblows the octave, and values between bend the pitch
// as a player's lips do. Speaks for mouth pressures of about 0.5 to 1.3; lower
// pressures give breath alone.
//
// The jet follows the jet-drive model of a flue pipe. The pipe's flow at the
// mouth deflects the jet, so the jet's displacement is that flow integrated;
// the jet's flow past the edge (`edge`) drives the pipe by its rate of change.
// `offset` aims the jet off the edge, which makes its flow lopsided and gives
// the pipe its even harmonics: the second partial is about 8 to 12 dB under the
// fundamental at the defaults, and 0 removes it. `sharpness` is how quickly the
// jet's flow saturates across the edge and `drive` its gain. The pipe keeps
// `reflection` of each round trip, and loses more of it as it gets louder
// (`vortex`: the vortices shed at the mouth), which is what limits the level.
// Without that loss the jet saturates on both sides into a symmetric pulse and
// the even harmonics vanish. `coupling` is how strongly the pipe moves the jet.
fn flue(mouth, frequency, options = {}) {
    let o = merge({
        tone: 3000Hz,
        jet: 0.5,
        coupling: 0.12,
        reflection: 0.92,
        vortex: 0.4,
        offset: 0.5,
        sharpness: 2.5,
        drive: 3.5,
        dc: 8Hz
    }, options);
    let period = s.period(frequency);
    let bore = s.line(
        s.add([
            period,
            s.mul([lowpass1_delay(frequency, o.tone), -1]),
            highpass1_advance(frequency, o.dc)
        ])
    );
    let across = s.line(s.mul([period, o.jet]), {max_seconds: 25ms});
    let returned = s.highpass1(s.lowpass1(bore, o.tone), o.dc);
    // An integrator (a lowpass far below the sounding partial) and a
    // differentiator (a highpass far above it), each scaled to unity there; their
    // phases cancel at that partial, so `jet` keeps its meaning. The partial is
    // the one the jet selects: the fundamental at 0.5, the octave at 0.25.
    let unity = pow(65, 0.5);
    let selected = s.mul([frequency, 0.5, s.mapping(s.mapping(o.jet, "clamp", 0.1, 1), "reciprocal")]);
    let displacement = s.mul([s.lowpass1(sub(across, mouth), s.mul([selected, 1 / 8])), unity]);
    let flow = s.mul([
        s.highpass1(s.shape(displacement, edge_points(o.offset, o.sharpness), "raw"), s.mul([selected, 8])),
        unity,
        o.drive,
        mouth
    ]);
    let keep = s.mul([o.reflection, s.mapping(s.add([1, s.mul([s.mapping(returned, "abs"), o.vortex])]), "reciprocal")]);
    {
        inside: bore,
        radiated: s.highpass1(bore, o.tone),
        flow: flow,
        feedback: [
            [across, sub(mouth, s.mul([returned, o.coupling]))],
            [bore, s.add([flow, s.mul([returned, keep])])]
        ]
    }
};

// What a player does to one note, read from the note itself. `level` (0..1) is
// velocity plus the note's `pressure` curve, so a swell is `.express({pressure:
// [[0, 0], [1, 0.5]]})`; `brightness` opens or darkens `tone` by up to an octave;
// `vibrato` is the depth of a pitch and breath vibrato at `vibrato_hz`. Curves
// arrive on the 128-frame expression clock and are smoothed here.
fn player(options = {}) {
    let o = merge({vibrato_hz: 5.2Hz, vibrato_cents: 30, drift_cents: 3, smooth: 12ms}, options);
    let level = s.slew(
        s.mapping(s.add([s.velocity(), s.expression("pressure")]), "clamp", 0, 1),
        o.smooth,
        o.smooth
    );
    let depth = s.slew(s.expression("vibrato"), 60ms, 60ms);
    let wobble = s.mul([s.sine({hz: o.vibrato_hz}), depth]);
    {
        level: level,
        wobble: wobble,
        frequency: cents(
            s.frequency(),
            s.add([
                s.mul([wobble, o.vibrato_cents]),
                s.mul([s.drift(3Hz, 300ms), o.drift_cents])
            ])
        ),
        brightness: s.mul([
            s.add([s.slew(s.expression("brightness"), o.smooth, o.smooth), -0.5]),
            2
        ])
    }
};
// Mouth pressure: `envelope` (the tongue) times a pressure between `low` and
// `high` chosen by `level`, with turbulence `air` and the vibrato's breath pulse.
fn breath(envelope, level, low, high, air = 0.08, wobble = 0, pulse = 0.06) = s.mul([
    envelope,
    s.add([low, s.mul([level, high - low])]),
    s.add([1, s.mul([s.lowpass1(s.noise(), 6000Hz), air]), s.mul([wobble, pulse])])
]);
// A reed or jet saturates, so breath alone changes the level little. This is the
// rest of a dynamic: gain from `floor` (at level 0) to 1, and a lowpass that opens
// from harmonic `dark` of `frequency` to harmonic `bright`.
fn dynamics(input, frequency, level, floor = 0.25, dark = 2, bright = 20) = s.mul([
    s.lowpass1(
        input,
        s.mapping(
            s.mul([frequency, s.add([dark, s.mul([level, level, bright - dark])])]),
            "clamp",
            200Hz,
            18000Hz
        )
    ),
    s.add([floor, s.mul([level, 1 - floor])])
]);
// Fixed resonances of an instrument's body or bell: `formants` is a list of
// [frequency, q, gain] added to the dry signal.
fn body(input, formants) = s.add(
    [input] + map(formants, fn(f) => s.mul([s.filter(input, f[0], f[1], "bandpass"), f[2]]))
);

// Hz of a MIDI pitch, as a number.
fn pitch_hz(pitch) = 440 * pow(2, (pitch - 69) / 12);
// A register a fingering below the written note: 1 from `pitch` up (glides
// switch half a semitone below it), else 0. `vent` adds the note's `vent`
// control, so a note can also open the vent on its own fingering.
fn register(pitch) = s.mapping(s.mul([sub(s.frequency(), pitch_hz(pitch - 0.5)), 10000]), "clamp", 0, 1);
fn vent_control(upper) = s.mapping(s.add([s.slew(s.expression("vent"), 5ms, 5ms), upper]), "clamp", 0, 1);

// B-flat clarinet, D3 to about G6. Odd harmonics in the low register, brightening
// with breath. `air` is breath noise and `tone` the bore's cutoff. Notes from
// `clarion` up (A4, the break) are fingered a twelfth lower with the register
// vent open, so the clarion is the long tube's third mode. A note's `vent`
// control (0..1) opens the vent on any fingering: a slurred twelfth.
fn clarinet(options = {}) {
    let o = merge({
        tone: 2400Hz,
        air: 0.05,
        attack: 12ms,
        release: 70ms,
        gain_db: 2,
        clarion: 69,
        oversample: 1
    }, options);
    let p = player(o);
    let tongue = s.adsr(o.attack, 200ms, 0.92, o.release);
    let tone = s.octaves(
        s.mapping(s.mul([p.frequency, 3.2]), "clamp", o.tone, 12000Hz),
        p.brightness
    );
    let upper = register(o.clarion);
    let fingering = s.mul([p.frequency, sub(1, s.mul([upper, 2 / 3]))]);
    let bore = cylinder(breath(tongue, p.level, 0.44, 0.57, o.air, p.wobble), fingering, {
        tone: tone,
        vent: vent_control(upper)
    });
    voice_patch("clarinet", {
        note_controls: {vent: 0},
        gain_db: o.gain_db,
        velocity_track: 0,
        oversample: o.oversample,
        output: dynamics(
            s.add([s.mul([bore.inside, 0.25]), s.mul([bore.radiated, 1.4])]),
            p.frequency,
            p.level
        ),
        feedback: bore.feedback,
        lifetime: {envelope: tongue, tail: 150ms}
    })
};
// Concert flute, C4 to about C7. `air` is the breath in the tone and `chiff` the
// burst of it at the start of a note. A note's `jet` control (0.5 at rest) is the
// lip: lower values sharpen and, near 0.25, overblow the octave. `offset` is the
// jet's aim off the edge (see `flue`): more gives a reedier tone with a stronger
// second partial, 0 a hollow one with almost none.
fn flute(options = {}) {
    let o = merge({
        tone: 3200Hz,
        air: 0.12,
        chiff: 0.5,
        attack: 55ms,
        release: 110ms,
        offset: 0.5,
        gain_db: -10,
        oversample: 2
    }, options);
    let p = player(o);
    let tongue = s.adsr(o.attack, 250ms, 0.9, o.release);
    let onset = s.adsr(2ms, 120ms, 0, 50ms, true);
    let tone = s.octaves(
        s.mapping(s.mul([p.frequency, 6]), "clamp", o.tone, 14000Hz),
        p.brightness
    );
    let tube = flue(
        breath(tongue, p.level, 0.9, 1.3, s.add([o.air, s.mul([onset, o.chiff])]), p.wobble),
        p.frequency,
        {tone: tone, jet: s.slew(s.expression("jet"), 20ms, 20ms), offset: o.offset}
    );
    voice_patch("flute", {
        note_controls: {jet: 0.5},
        gain_db: o.gain_db,
        velocity_track: 0,
        oversample: o.oversample,
        // What leaves the pipe is its flow's rate of change, so the sound is
        // mostly `radiated`, with a little of the pressure inside for body.
        output: dynamics(
            s.add([s.mul([tube.inside, 0.1]), s.mul([tube.radiated, 2])]),
            p.frequency,
            p.level
        ),
        feedback: tube.feedback,
        lifetime: {envelope: tongue, tail: 200ms}
    })
};
// Oboe, B-flat3 to about G6: a narrow cone and a stiff double reed, with the
// instrument's two fixed formants. Other conical reeds are the same model with
// their own `formants`, `apex` and range. Notes from `octave_key` up (E5) are
// fingered an octave lower with the octave vent open; a note's `vent` control
// (0..1) opens it on any fingering.
fn oboe(options = {}) {
    let o = merge({
        air: 0.03,
        attack: 10ms,
        release: 60ms,
        apex: 0.31,
        formants: [[1100Hz, 4, 0.9], [2900Hz, 5, 0.6]],
        gain_db: -4.5,
        octave_key: 76,
        oversample: 1
    }, options);
    let p = player(o);
    let tongue = s.adsr(o.attack, 150ms, 0.94, o.release);
    let upper = register(o.octave_key);
    let fingering = s.mul([p.frequency, sub(1, s.mul([upper, 0.5]))]);
    let bore = cone(breath(tongue, p.level, 0.4, 0.56, o.air, p.wobble), fingering, {
        apex: o.apex,
        tone: s.octaves(s.mul([p.frequency, 4]), p.brightness),
        vent: vent_control(upper)
    });
    voice_patch("oboe", {
        note_controls: {vent: 0},
        gain_db: o.gain_db,
        velocity_track: 0,
        oversample: o.oversample,
        output: dynamics(
            body(s.add([s.mul([bore.inside, 0.3]), bore.radiated]), o.formants),
            p.frequency,
            p.level
        ),
        feedback: bore.feedback,
        lifetime: {envelope: tongue, tail: 150ms}
    })
}