// Blown instruments as waveguides: a bore is a delay line, and the reed or air jet
// that drives it sits inside the loop. Everything here is an ordinary signal record
// built from std/signal, so a piece can copy a part and change it. std/woodwinds
// builds its calibrated instruments, and their player, from these parts.
//
// A model takes the mouth pressure and the sounding frequency and returns
//   {inside, radiated, feedback}
// `inside` is the pressure at the mouthpiece (dark), `radiated` what leaves the
// open end (bright), and `feedback` the list a voice_patch needs to close the
// loops: `voice_patch(name, {output: ..., feedback: model.feedback})`.
// Pressures are normalized: a reed closes near 1, and each model documents the
// range in which it speaks.
use "std/signal" as s;

let tau = 6.283185307179586;
fn sub(a, b) = s.add([a, s.mul([b, -1])]);
fn lag_point(x) = [x, atan(x) / tau];
let lag_points = map(range(64), fn(i) => lag_point(16 * pow(i / 63, 2)));
// atan(ratio) in cycles, for ratios 0..16: the phase of a one-pole filter.
fn lag(ratio) = s.shape(ratio, lag_points, "raw");
// Seconds by which `s.lowpass1(x, cutoff)` delays a partial at `frequency`. Take
// it off a loop's line so the loop still sounds at `frequency`.
fn lowpass1_delay(frequency, cutoff) = s.mul([
    s.period(frequency),
    lag(s.mul([frequency, s.period(cutoff)]))
]);
// Seconds by which `s.highpass1(x, cutoff)` advances a partial at `frequency`.
fn highpass1_advance(frequency, cutoff) = s.mul([
    s.period(frequency),
    lag(s.mul([cutoff, s.period(frequency)]))
]);
// `frequency` moved by `amount` cents.
fn cents(frequency, amount) = s.octaves(frequency, s.mul([amount, 1 / 1200]));

// A reed as a pressure-controlled valve. `mouth` is the breath pressure and `bore`
// the wave arriving from the bore; the result is the wave sent back into it.
// `aperture` is the reflection with no pressure across the reed (a tighter
// embouchure is higher), and `stiffness` how fast pressure closes it. At
// aperture + stiffness * mouth >= 1 the reed is held shut and the note chokes.
// An open, stiff reed (the default) speaks within a few periods of the breath
// arriving; a closed, soft one (0.7, 0.3) takes several times longer, and needs
// pressures of 0.7 to 1.
fn reed(mouth, bore, aperture = 0.4, stiffness = 0.95) {
    let across = sub(bore, mouth);
    let reflect = s.mapping(s.add([aperture, s.mul([across, -stiffness])]), "clamp", -1, 1);
    s.add([mouth, s.mul([across, reflect])])
};
// An air jet crossing an edge: displacement in, flow into the pipe out. A
// symmetric cubic; `flue` uses `edge`.
fn jet(x) = s.mapping(s.mul([x, s.add([s.mul([x, x]), -1])]), "clamp", -1, 1);
fn tanh_number(x) = 1 - 2 / (pow(2.718281828459045, 2 * x) + 1);
// The flow of a jet aimed `offset` off an edge, against its displacement `x`, as
// a curve: tanh(sharpness * (x + offset)) less its value at rest, scaled to a
// slope of 1 at rest. Its two sides saturate at different distances, so the
// flow pulse is lopsided and the pipe hears even harmonics.
fn edge_points(offset, sharpness) {
    let rest = tanh_number(sharpness * offset);
    let slope = sharpness * (1 - rest * rest);
    map(range(64), fn(i) => {
        let x = -3 + 6 * i / 63;
        [x, (tanh_number(sharpness * (x + offset)) - rest) / slope]
    })
};

// The exact quasi-static reed. With x the pressure drop across the reed over the
// pressure that closes it, the flow through it is u = zeta (1 - x) sqrt(x): zero
// once x >= 1 (the reed is shut) and odd for flow backwards into the mouth.
// `zeta` is the reed's opening against the bore's impedance: a tight embouchure
// or a hard reed is low (0.2 to 0.35), a loose one high (0.5 to 0.7).
fn bernoulli_flow(x, zeta) = if x >= 1 { 0 } else {
    if x >= 0 { zeta * (1 - x) * pow(x, 0.5) } else { 0 - zeta * (1 - x) * pow(0 - x, 0.5) }
};
// In a waveguide the reed meets h = mouth pressure less the waves arriving at it,
// and x + u(x) = h. So the pairs [x + u(x), u(x)] are the map from h to u, and a
// `shape` interpolates it exactly: the threshold of oscillation, the beating
// reed and extinction are all in this one curve.
fn bernoulli_points(zeta) {
    let reverse = map(range(8), fn(k) => 0 - pow((8 - k) / 8, 2) * 1.5);
    let open = map(range(44), fn(k) => pow(k / 44, 2));
    map(reverse + open + [1, 4], fn(x) => [x + bernoulli_flow(x, zeta), bernoulli_flow(x, zeta)])
};
// The flow through a reed for the difference `h`, its embouchure crossfading
// from `tight` (0) to `loose` (1). `embouchure` is a signal: a dynamic that
// opens the lips, a note's `brightness`.
fn bernoulli(h, embouchure = 0.5, tight = 0.32, loose = 0.55) {
    let a = s.shape(h, bernoulli_points(tight), "raw");
    let b = s.shape(h, bernoulli_points(loose), "raw");
    s.add([a, s.mul([sub(b, a), embouchure])])
};

// The open end of a bore with tone holes: two one-pole lowpasses at `cutoff`
// stand for the wall losses and the tone-hole lattice, above whose cutoff the
// holes radiate instead of reflecting. `cutoff` follows the note at `track`
// times its frequency but never falls under `floor`, so the top of the range
// still has a tube to speak on. `delay` is the pair's phase delay at
// `frequency`: take it off the line and the loop stays in tune.
fn open_end(frequency, floor = 1800Hz, track = 2.2) {
    let cutoff = s.mapping(s.mul([frequency, track]), "clamp", floor, 20000Hz);
    {cutoff: cutoff, delay: s.mul([lowpass1_delay(frequency, cutoff), 2])}
};

// A pipe from a driving end (a reed) to an open end, as one round trip of
// `seconds`. `tone` is the cutoff of the open end's reflection, `poles` (1 or 2)
// how steeply it falls (see `open_end`), and `loss` its level. `frequency` is
// the note the loop sounds, at which the end's delay is taken off the line. The
// caller closes the loop: `feedback: [[pipe.entry, entering]] + pipe.feedback`,
// where `entering` is the wave the driver sends in; `back` is the wave arriving
// at the driver, `bell` the pressure at the open end (what radiates).
//
// `vent` (0..1, a signal) opens a side hole `at` of the way from the driver,
// such as a clarinet's register key or an oboe's octave key. Closed, the pipe is
// one line. With a vent the pipe is three: down to the hole, back up from it,
// and the rest of the bore and back, joined at the hole. The hole is a lossy
// inertance: its pressure release is a one-pole lowpass at `cutoff` of depth
// `depth`, so it passes the wave on (a highpass) and reflects an inverted,
// lowpassed share of it. A mode with a pressure node at the hole passes it
// untouched; the others lose energy there, so the driver moves to that mode.
// `depth` near 0.5 is the most loss (a narrow, resistive hole); at 1 the hole is
// lossless and only drags the lower modes sharp.
fn pipe(seconds, frequency, options = {}) {
    let o = merge({
        tone: 2500Hz, poles: 1, loss: 0.95, vent: 0, at: 1 / 3, depth: 0.5,
        cutoff: s.mul([frequency, 4]), max_seconds: 50ms
    }, options);
    let end_delay = s.mul([lowpass1_delay(frequency, o.tone), o.poles]);
    fn reflect(x) = s.mul([if o.poles == 2 { s.lowpass1(s.lowpass1(x, o.tone), o.tone) } else { s.lowpass1(x, o.tone) }, -o.loss]);
    if o.vent == 0 {
        let line = s.line(sub(seconds, end_delay), {max_seconds: o.max_seconds});
        let back = reflect(line);
        let bell = s.add([line, back]);
        {entry: line, back: back, bell: bell, radiated: if o.poles == 2 { bell } else { s.highpass1(line, o.tone) }, feedback: []}
    } else {
        let half = s.mul([seconds, o.at, 0.5]);
        let down = s.line(half, {max_seconds: 25ms});
        let up = s.line(half, {max_seconds: 25ms});
        let low = s.line(sub(s.mul([seconds, sub(1, o.at)]), end_delay), {max_seconds: o.max_seconds});
        let reflected = reflect(low);
        let arriving = s.add([down, reflected]);
        let hole = sub(arriving, s.mul([s.lowpass1(arriving, o.cutoff), o.vent, o.depth]));
        let bell = s.add([low, reflected]);
        {
            entry: down,
            back: up,
            bell: bell,
            radiated: if o.poles == 2 { bell } else { s.highpass1(low, o.tone) },
            feedback: [[up, sub(hole, down)], [low, sub(hole, reflected)]]
        }
    }
};
// A cylindrical bore closed by a single reed (clarinet family): odd harmonics,
// sounding an octave below an open pipe of the same length. `mouth` is the
// pressure in the player's mouth over the reed's closing pressure: the bore
// speaks from a threshold near 0.33 (rising with pitch, see std/woodwinds'
// calibration) and the reed is held shut near 1. `frequency` is the fingered
// tube's fundamental and `sounding` the note the loop plays (the same unless
// `vent` makes it overblow): the open end's delay is taken off at `sounding`.
//
// The reed is `bernoulli` between the `tight` and `loose` openings at
// `embouchure`; `turbulence` multiplies its flow (a signal around 1: see
// `turbulence`). The open end is `open_end`'s two poles at `tone` with `loss`.
// `vent` opens a register hole at `vent_at` (a third of the bore, the twelfth's
// pressure node): the bore then sounds its twelfth, three times `frequency`.
//
// Returns `inside` (the pressure in the mouthpiece), `radiated` (the pressure at
// the open end, which is what leaves it), `flow` and the `feedback` list.
fn cylinder(mouth, frequency, options = {}) {
    let o = merge({
        tone: 2500Hz, loss: 0.96, embouchure: 0.5, tight: 0.32, loose: 0.55, turbulence: 1,
        vent: 0, vent_at: 1 / 3, vent_depth: 0.5, vent_cutoff: s.mul([frequency, 4]),
        sounding: frequency, max_seconds: 50ms
    }, options);
    let bore = pipe(s.mul([s.period(frequency), 0.5]), o.sounding, {
        tone: o.tone, poles: 2, loss: o.loss, vent: o.vent, at: o.vent_at, depth: o.vent_depth,
        cutoff: o.vent_cutoff, max_seconds: o.max_seconds
    });
    let flow = s.mul([bernoulli(sub(mouth, s.mul([bore.back, 2])), o.embouchure, o.tight, o.loose), o.turbulence]);
    {
        inside: s.add([s.mul([bore.back, 2]), flow]),
        radiated: bore.radiated,
        flow: flow,
        feedback: [[bore.entry, s.add([bore.back, flow])]] + bore.feedback
    }
};
// A conical bore closed by a double reed (oboe, bassoon and saxophone families):
// every harmonic. The cone is a long open pipe and a short one standing for the
// missing tip of the cone, joined at the reed. `apex` is the short pipe's share
// of the period: near a third the fundamental is secure, smaller values favour
// the octave, and at exactly 1/3 every third harmonic is missing. A double
// reed is stiff: it speaks from a mouth pressure near 0.45 and saturates soon
// after, so its level barely follows the breath (see std/woodwinds). Other
// options are `cylinder`'s; `vent` opens an octave hole on the long pipe at the
// octave's pressure node (half the whole cone from its tip), and the bore then
// sounds its octave.
fn cone(mouth, frequency, options = {}) {
    let o = merge({
        tone: s.mul([frequency, 4]), loss: 0.95, apex: 0.27, apex_loss: 0.985,
        embouchure: 0.5, tight: 0.32, loose: 0.55, turbulence: 1,
        vent: 0, vent_depth: 0.5, vent_cutoff: s.mul([frequency, 4]), sounding: frequency, max_seconds: 50ms
    }, options);
    let period = s.period(frequency);
    let long = pipe(s.mul([period, sub(1, o.apex)]), o.sounding, {
        tone: o.tone, poles: 2, loss: o.loss, vent: o.vent, depth: o.vent_depth, cutoff: o.vent_cutoff,
        at: s.mul([sub(0.5, o.apex), s.mapping(sub(1, o.apex), "reciprocal")]), max_seconds: o.max_seconds
    });
    let short = s.line(s.mul([period, o.apex]), {max_seconds: o.max_seconds});
    let from_short = s.mul([short, -o.apex_loss]);
    let arriving = s.add([from_short, long.back]);
    let flow = s.mul([bernoulli(sub(mouth, arriving), o.embouchure, o.tight, o.loose), o.turbulence]);
    {
        inside: s.add([arriving, flow]),
        radiated: long.radiated,
        flow: flow,
        feedback: [[short, s.add([long.back, flow])], [long.entry, s.add([from_short, flow])]] + long.feedback
    }
};

// An open pipe driven by an air jet (flute, recorder, pipe families). `jet` is the
// time the jet takes to cross to the edge, as a share of the period: 0.5 sounds
// the fundamental, 0.25 overblows the octave, and values between bend the pitch
// as a player's lips do. Speaks for mouth pressures of about 0.5 to 1.3; lower
// pressures give breath alone.
//
// The jet follows the jet-drive model of a flue pipe. The pipe's flow at the
// mouth deflects the jet, so the jet's displacement is that flow integrated;
// the jet's flow past the edge (`edge`) drives the pipe by its rate of change.
// `offset` aims the jet off the edge, which makes its flow lopsided and gives
// the pipe its even harmonics: the second partial is about 8 to 12 dB under the
// fundamental at the defaults, and 0 removes it. `sharpness` is how quickly the
// jet's flow saturates across the edge and `drive` its gain. The pipe keeps
// `reflection` of each round trip, and loses more of it as it gets louder
// (`vortex`: the vortices shed at the mouth), which is what limits the level.
// Without that loss the jet saturates on both sides into a symmetric pulse and
// the even harmonics vanish. `coupling` is how strongly the pipe moves the jet.
//
// `offset` is clamped to -0.6..0.6: further off the edge the far side of the
// jet's flow is so strong that the jet's own loop takes over and the note sounds
// far below its pitch. 0 is hollow, 0.4 to 0.5 a flute's, 0.6 reedy. `aim` (a
// signal, 0 by default) moves the jet about `offset`, as a player's lips do.
//
// By default the jet is scaled to the note, so every register has the same
// colour. On an instrument it is not: the jet's deflection is the acoustic flow
// integrated, larger the lower the note, and its drive is a rate of change,
// larger the higher. `register` (0 to about 1.5) restores that, relative to
// `reference`: low notes then saturate against the edge and are rich, high ones
// are nearly sine and louder, as on a flute. `stiff` makes a harder-blown (faster)
// jet deflect less, as mouth^-stiff; `flux` is the jet's flow against the
// mouth pressure, as mouth^flux; and `bias` makes the vortex loss lopsided
// (more for flow out of the mouth than in), which keeps a little second
// partial in the top notes.
fn flue(mouth, frequency, options = {}) {
    let o = merge({
        tone: 3000Hz,
        jet: 0.5,
        coupling: 0.12,
        reflection: 0.92,
        vortex: 0.4,
        offset: 0.5,
        sharpness: 2.5,
        drive: 3.5,
        dc: 8Hz,
        register: 0,
        reference: 440Hz,
        stiff: 0,
        flux: 1,
        bias: 0,
        aim: 0
    }, options);
    let period = s.period(frequency);
    let bore = s.line(
        s.add([
            period,
            s.mul([lowpass1_delay(frequency, o.tone), -1]),
            highpass1_advance(frequency, o.dc)
        ])
    );
    let across = s.line(s.mul([period, o.jet]), {max_seconds: 25ms});
    let returned = s.highpass1(s.lowpass1(bore, o.tone), o.dc);
    // An integrator (a lowpass far below the sounding partial) and a
    // differentiator (a highpass far above it), each scaled to unity there; their
    // phases cancel at that partial, so `jet` keeps its meaning. The partial is
    // the one the jet selects: the fundamental at 0.5, the octave at 0.25.
    let unity = pow(65, 0.5);
    let selected = s.mul([frequency, 0.5, s.mapping(s.mapping(o.jet, "clamp", 0.1, 1), "reciprocal")]);
    let deflect = s.mapping(s.add([
        s.mul([s.mapping(s.mul([selected, 1Hz / o.reference]), "log2"), -o.register]),
        s.mul([s.mapping(s.mapping(mouth, "clamp", 0.05, 4), "log2"), -o.stiff])
    ]), "exp2");
    let displacement = s.add([s.mul([s.lowpass1(sub(across, mouth), s.mul([selected, 1 / 8])), unity, deflect]), o.aim]);
    let flow = s.mul([
        s.highpass1(s.shape(displacement, edge_points(min(max(o.offset, -0.6), 0.6), o.sharpness), "raw"), s.mul([selected, 8])),
        unity,
        o.drive,
        s.mapping(s.mul([s.mapping(s.mul([selected, 1Hz / o.reference]), "log2"), o.register]), "exp2"),
        if o.flux == 1 { mouth } else { s.mapping(s.mul([s.mapping(s.mapping(mouth, "clamp", 0.0001, 4), "log2"), o.flux]), "exp2") }
    ]);
    let keep = s.mul([o.reflection, s.mapping(s.add([1, s.mul([s.add([s.mapping(returned, "abs"), s.mul([returned, o.bias])]), o.vortex])]), "reciprocal")]);
    {
        inside: bore,
        radiated: s.highpass1(bore, o.tone),
        flow: flow,
        feedback: [
            [across, sub(mouth, s.mul([returned, o.coupling]))],
            [bore, s.add([flow, s.mul([returned, keep])])]
        ]
    }
};

// What a player does to one note, read from the note itself. `level` (0..1) is
// velocity plus the note's `pressure` curve, so a swell is `.express({pressure:
// [[0, 0], [1, 0.5]]})`; `brightness` opens or darkens `tone` by up to an octave;
// `vibrato` is the depth of a pitch and breath vibrato at `vibrato_hz`. Curves
// arrive on the 128-frame expression clock and are smoothed here.
fn player(options = {}) {
    let o = merge({vibrato_hz: 5.2Hz, vibrato_cents: 30, drift_cents: 3, smooth: 12ms}, options);
    let level = s.slew(
        s.mapping(s.add([s.velocity(), s.expression("pressure")]), "clamp", 0, 1),
        o.smooth,
        o.smooth
    );
    let depth = s.slew(s.expression("vibrato"), 60ms, 60ms);
    let wobble = s.mul([s.sine({hz: o.vibrato_hz}), depth]);
    {
        level: level,
        wobble: wobble,
        frequency: cents(
            s.frequency(),
            s.add([
                s.mul([wobble, o.vibrato_cents]),
                s.mul([s.drift(3Hz, 300ms), o.drift_cents])
            ])
        ),
        brightness: s.mul([
            s.add([s.slew(s.expression("brightness"), o.smooth, o.smooth), -0.5]),
            2
        ])
    }
};
// Mouth pressure: `envelope` (the tongue) times a pressure between `low` and
// `high` chosen by `level`, with turbulence `air` and the vibrato's breath pulse.
fn breath(envelope, level, low, high, air = 0.08, wobble = 0, pulse = 0.06) = s.mul([
    envelope,
    s.add([low, s.mul([level, high - low])]),
    s.add([1, s.mul([s.lowpass1(s.noise(), 6000Hz), air]), s.mul([wobble, pulse])])
]);
// A reed or jet saturates, so breath alone changes the level little. This is the
// rest of a dynamic: gain from `floor` (at level 0) to 1, and a lowpass that opens
// from harmonic `dark` of `frequency` to harmonic `bright`.
fn dynamics(input, frequency, level, floor = 0.25, dark = 2, bright = 20) = s.mul([
    s.lowpass1(
        input,
        s.mapping(
            s.mul([frequency, s.add([dark, s.mul([level, level, bright - dark])])]),
            "clamp",
            200Hz,
            18000Hz
        )
    ),
    s.add([floor, s.mul([level, 1 - floor])])
]);
// Fixed resonances of an instrument's body or bell: `formants` is a list of
// [frequency, q, gain] added to the dry signal.
fn body(input, formants) = s.add(
    [input] + map(formants, fn(f) => s.mul([s.filter(input, f[0], f[1], "bandpass"), f[2]]))
);

// A body's response as an impulse response for `fx("convolve", {ir: ...})`:
// `points` is [[hz, dB], ...] in rising frequency, straight between points in
// octaves and held past the ends; the result is `taps` (odd) taps at `rate` Hz,
// linear phase (it delays by (taps - 1) / 2 samples) under a Hann window.
fn response_ir(points, taps = 255, rate = 48000) {
    let m = (taps - 1) / 2;
    fn gain_at(hz) {
        let lf = ln(max(hz, 1)) / ln(2);
        let at = map(points, fn(p) => [ln(p[0]) / ln(2), p[1]]);
        let n = len(at);
        let db = if lf <= at[0][0] { at[0][1] } else { if lf >= at[n - 1][0] { at[n - 1][1] } else {
            let k = len(filter(at, fn(p) => p[0] <= lf)) - 1;
            at[k][1] + (at[k + 1][1] - at[k][1]) * (lf - at[k][0]) / (at[k + 1][0] - at[k][0])
        } };
        pow(10, db / 20)
    }
    let g = map(range(m + 1), fn(k) => gain_at(k * rate / taps));
    map(range(taps), fn(n) => {
        let t = n - m;
        let sum = fold(range(1, m + 1), g[0], fn(acc, k) => acc + 2 * g[k] * cos(2 * 3.141592653589793 * k * t / taps));
        sum / taps * (0.5 - 0.5 * cos(2 * 3.141592653589793 * (n + 1) / (taps + 1)))
    })
}

// Hz of a MIDI pitch, as a number.
fn pitch_hz(pitch) = 440 * pow(2, (pitch - 69) / 12);
// A register a fingering below the written note: 1 from `pitch` up (glides
// switch half a semitone below it), else 0. `vent` adds the note's `vent`
// control, so a note can also open the vent on its own fingering.
fn register(pitch) = s.mapping(s.mul([sub(s.frequency(), pitch_hz(pitch - 0.5)), 10000]), "clamp", 0, 1);
fn vent_control(upper) = s.mapping(s.add([s.slew(s.expression("vent"), 5ms, 5ms), upper]), "clamp", 0, 1);
// Breath turbulence, shaped as breath is. Turbulent air is not white: its eddies
// have a size, so its spectrum falls away above a corner, and the corner rises
// with the speed of the air (a Strouhal number). Here the corner is `cutoff` at
// `level` 0.5, moving `brighten` octaves from level 0 to 1, and `follow` octaves
// for each octave the note is above `reference` (a player blows a high note
// harder through a smaller opening). Above it the noise falls 6 dB per octave,
// and 12 from `slope` times the corner. Use it, never raw `s.noise()`, inside a
// loop: a loop folds a flat floor into every band of every note.
fn turbulence(level, frequency, options = {}) {
    let o = merge({cutoff: 3000Hz, brighten: 1, follow: 0.25, reference: 440Hz, slope: 4}, options);
    let octaves = s.add([
        s.mul([level, o.brighten]),
        -0.5 * o.brighten,
        s.mul([s.mapping(s.mul([frequency, 1Hz / o.reference]), "log2"), o.follow])
    ]);
    let corner = s.mapping(s.mul([o.cutoff, s.mapping(octaves, "exp2")]), "clamp", 200Hz, 16000Hz);
    s.lowpass1(s.lowpass1(s.noise(), corner), s.mapping(s.mul([corner, o.slope]), "clamp", 200Hz, 20000Hz))
};

// The player of a wind instrument: what a note asks of the breath, the tongue and
// the fingers, as signals a model reads. Every std/woodwinds instrument uses it,
// so an ensemble breathes alike.
//
//   envelope  the breath on and off (attack, then release when the note ends)
//   dynamic   how hard the note is blown, 0..1: the note's velocity (weighted by
//             its `velocity_breath` control) plus its `pressure` curve, chopped
//             by flutter-tonguing, with the tongue's burst and the vibrato's
//             breath pulse on top
//   noise     breath turbulence (`turbulence`, following the dynamic and the
//             register), scaled by the note's `noise` control (0.5 neutral) and
//             rising `noise_dynamic` octaves of amplitude from p to f
//   fingers   a few tens of milliseconds of extra turbulence each time the
//             sounding note changes, slurred or tongued (`note_age` restarts
//             when a legato voice passes to a new note)
//   cents     the pitch's slow wander (`drift_cents`) and its vibrato
//   controls  the note controls a patch using it must declare
//
// Note controls: `tongue` (0..1, the burst of pressure and air at a fresh
// voice; slurred notes continue the voice and get none), `noise`, `flutter`
// (0..1, flutter-tongue depth), `velocity_breath` (1: velocity is the dynamic;
// 0: the `pressure` curve alone is; `velocity_breath` sets its default). The
// standard `vibrato` expression is the
// vibrato's depth (0..1): a breath pulse of `vibrato_breath` and a pitch swing of
// `vibrato_cents` at `vibrato_hz`.
fn wind_player(options = {}) {
    let o = merge({
        attack: 1ms, release: 70ms, tongue_gain: 0.6, burst: 50ms, finger: 0.1,
        drift_cents: 2.5, drift_hz: 2.3Hz, flutter_hz: 24Hz, flutter_depth: 0.4,
        vibrato_hz: 5Hz, vibrato_breath: 0, vibrato_cents: 0, noise: {}, noise_dynamic: 0, velocity_breath: 1
    }, options);
    let envelope = s.adsr(o.attack, 50ms, 1, o.release);
    let written = s.slew(
        s.mapping(s.add([s.mul([s.velocity(), s.expression("velocity_breath")]), s.expression("pressure")]), "clamp", 0, 1),
        5ms,
        5ms
    );
    let drift = s.drift(o.drift_hz, 350ms);
    let depth = s.slew(s.expression("vibrato"), 60ms, 60ms);
    // A player's vibrato is not a clock: its rate wanders with the pitch's drift.
    let wobble = s.mul([s.sine({hz: s.mul([o.vibrato_hz, s.add([1, s.mul([drift, 0.06])])])}), depth]);
    let chopped = s.mul([
        written,
        s.add([1, s.mul([s.expression("flutter"), s.add([s.sine({hz: o.flutter_hz}), -1]), o.flutter_depth])])
    ]);
    let burst = s.mseg([{time: 2ms, to: 1}, {time: o.burst, to: 0, curve: "exp"}], [{time: 5ms, to: 0}], null, true);
    let dynamic = s.add([chopped, s.mul([s.expression("tongue"), burst, o.tongue_gain]), s.mul([wobble, o.vibrato_breath])]);
    {
        envelope: envelope,
        dynamic: dynamic,
        noise: s.mul([
            turbulence(dynamic, s.frequency(), o.noise),
            s.add([0.3, s.mul([s.expression("noise"), 1.4])]),
            s.mapping(s.mul([s.add([dynamic, -0.5]), o.noise_dynamic]), "exp2")
        ]),
        fingers: s.mul([s.mapping(s.mul([s.note_age(), -55]), "exp2"), o.finger]),
        drift: drift,
        wobble: wobble,
        cents: s.add([s.mul([drift, o.drift_cents]), s.mul([wobble, o.vibrato_cents])]),
        controls: {tongue: 0.4, noise: 0.5, flutter: 0, velocity_breath: o.velocity_breath}
    }
};
