use "std/signal" as s;
use "std/performance" as performance;
// Stable source-note variation uses its declared native note-control lane.
fn variation(pattern, seed = 0, stream = "variation") {
    let identity = performance.note_identity(pattern);
    pattern.map_notes(fn(n) => {
        let existing = merge({expression: {}}, n.data).expression;
        {
            data: merge(n.data, {
                expression: merge(existing, {
                    // Preserve pressure and other authored expression gestures.
                    variation:
                        (keyed_noise(identity(n), seed, stream) + 1)
                        / 2
                })
            })
        }
    })
};

// Last attack wins; earlier note-offs cannot release the continued voice.
// Accepts a voice patch or a `sample(...)` instrument.
fn mono(patch, glide = 0ms, retrigger = false) = merge(patch, {
    voice_mode: if retrigger { "retrigger" } else { "legato" },
    glide_ms: glide
});
// Slur each note carrying `tag` from the note before it, for a `mono`
// instrument: that earlier note is held to the tagged note's written start and
// released `overlap` after its performed attack, so the voice is continued
// rather than re-attacked. `slide` ramps the pitch from the earlier note over
// that time (0ms steps: hammer-on, pull-off); a note with its own tuning curve
// keeps it. One line at a time: notes are paired in order of `at`.
fn slur(pattern, tag = "slur", slide = 0ms, overlap = 10ms) {
    assert(overlap > 0ms && slide >= 0ms, "slur needs a positive overlap and a slide of 0ms or more");
    let ordered = sort_by(pattern.notes, fn(n) => n.at);
    let pairs = map(
        filter(range(len(ordered)), fn(i) => i > 0 && contains(ordered[i].tags, tag)),
        fn(i) => {from: ordered[i - 1], to: ordered[i]}
    );
    pattern.map_notes(fn(n) => {
        let leaving = filter(pairs, fn(p) => p.from.key == n.key);
        let arriving = filter(pairs, fn(p) => p.to.key == n.key);
        let held = if len(leaving) == 0 { {} } else {
            let next = leaving[0].to;
            {
                gate: max(n.gate, (next.at - n.at) / n.duration),
                release_offset: next.offset - n.offset + overlap
            }
        };
        let existing = merge({expression: {}}, n.data).expression;
        let bent = if len(arriving) == 0 || slide == 0ms || arriving[0].from.pitch == n.pitch { {} } else {
            {data: merge(n.data, {expression: merge(
                {tuning: [[0ms, arriving[0].from.pitch - n.pitch], [slide, 0]]},
                existing
            )})}
        };
        merge(held, bent)
    })
};

// Recording selection is inherited; envelope and output gain are explicit source policy.
fn ms_time(value) = if unit(value) == 1s { value } else { value * 1ms };
fn sampled(source, tone = 12000Hz, options = {}) {
    let p = merge({attack_ms: 2, release_ms: 35, gain_db: 0, velocity_track: 1}, source);
    let e = s.mseg(
        [{time: ms_time(p.attack_ms), to: 1}],
        [{time: ms_time(p.release_ms), to: 0}],
        sustain = 0
    );
    let pair = s.stereo(
        s.filter(s.reader(source, "left"), tone),
        s.filter(s.reader(source, "right"), tone)
    );
    voice_patch(
        "sampled",
        merge({
            gain_db: p.gain_db,
            velocity_track: p.velocity_track,
            output: s.stereo_mul(pair, e),
            lifetime: {envelope: e, tail: 0s}
        }, options)
    )
};
fn crossfade(a, b, control) = s.add([
    s.mul([a, s.add([1, s.mul([control, -1])])]),
    s.mul([b, control])
]);
// Build an independent release lane using performed ends, including release offsets.
fn releases(pattern, duration = 100ms, timing = {}) = stack(
    map(pattern.notes, fn(n) => {
        let at = seconds_at(n.at + n.duration * n.gate, timing) + n.offset + n.release_offset;
        note(n.pitch, 1b, velocity = n.velocity)
            .gate(1)
            .map_notes(fn(r) => {
                duration: 1b,
                offset: at,
                release_offset: duration - (seconds_at(1b, timing) - seconds_at(0b, timing))
            })
    })
);

// A source package keeps processing and macros with a reusable instrument.
fn sound(instrument, chain = [], range = [36, 84], macros = {}) = {
    instrument: instrument,
    chain: chain,
    range: range,
    macros: macros
};
fn play(id, material, sound, options = {}) = track(
    id,
    material,
    sound.instrument,
    merge({chain: sound.chain}, options)
);
// Each macro maps one normalized curve to one or more existing target lanes.
fn automate(id, sound, name, values) = map(
    sound.macros[name],
    fn(mapping) => automation(
        format("{}.{}", [id, mapping.target]),
        curve_map(values, fn(x) => mapping.offset + mapping.scale * x)
    )
);
