fn clean(lowcut = 100) = [fx("highpass", {cutoff_hz: lowcut, resonance: 0.707})];
fn space(decay = 2.5) = [fx("reverb", {decay_s: decay, mix: 1})];
fn master() = [fx("highpass", {cutoff_hz: 25, resonance: 0.707}), fx("compressor", {threshold_db: -16, ratio: 1.5, attack_ms: 30, release_ms: 180}), fx("limiter", {ceiling_db: -1.5, lookahead_ms: 5})];
