fn clean(lowcut = 100) = [fx("highpass", {cutoff_hz: lowcut, resonance: 0.707})];
fn space(decay = 2.5) = [fx("reverb", {decay_s: decay, mix: 1})];
// The rack's amount can be automated as TRACK.RACK_ID.mix.
fn parallel_compression(amount=0.25) = rack([[fx("compressor",{threshold_db:-25,ratio:6,attack_ms:15,release_ms:120}),fx("gain",{gain_db:8})]],{mix:amount});
fn tremolo(rate=2,depth=3) = rack([[fx("gain")]],{modulate:[{target:"0.0.gain_db",base:-depth,depth:depth,rate_hz:rate,min:-24,max:0}]});
fn auto_filter(base=400,sensitivity=5000) = rack([[fx("lowpass")]],{modulate:[{target:"0.0.cutoff_hz",base:base,follower:sensitivity,attack_ms:5,release_ms:150,min:30,max:18000}]});
fn master() = [fx("highpass", {cutoff_hz: 25, resonance: 0.707}), fx("compressor", {threshold_db: -16, ratio: 1.5, attack_ms: 30, release_ms: 180}), fx("limiter", {ceiling_db: -1.5, lookahead_ms: 5})];
