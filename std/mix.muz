fn clean(lowcut = 100) = [fx("highpass", {cutoff_hz: lowcut, resonance: 0.707})];
fn space(decay = 2.5) = [fx("reverb", {decay_s: decay, mix: 1})];
// The rack's amount can be automated as TRACK.RACK_ID.mix.
fn parallel_compression(amount = 0.25) = rack([
    [
        fx("compressor", {threshold_db: -25, ratio: 6, attack_ms: 15, release_ms: 120}),
        fx("gain", {gain_db: 8})
    ]
],
    {mix: amount});
fn tremolo(rate = 2, depth = 3) = rack([[fx("gain")]], {
    modulate: [
        {target: "0.0.gain_db", base: -depth, depth: depth, rate_hz: rate, min: -24, max: 0}
    ]
});
fn auto_filter(base = 400, sensitivity = 5000) = rack([[fx("lowpass")]], {
    modulate: [
        {
            target: "0.0.cutoff_hz",
            base: base,
            follower: sensitivity,
            attack_ms: 5,
            release_ms: 150,
            min: 30,
            max: 18000
        }
    ]
});
fn master() = [
    fx("highpass", {cutoff_hz: 25, resonance: 0.707}),
    fx("compressor", {threshold_db: -16, ratio: 1.5, attack_ms: 30, release_ms: 180}),
    fx("limiter", {ceiling_db: -1.5, lookahead_ms: 5})
];

// Timing and envelope policies below are ordinary source; projects can replace them.
fn note_start(n, timing = {}) = seconds_at(n.at, timing) + n.offset;
fn note_end(n, timing = {}) = seconds_at(n.at + n.duration * n.gate, timing) + n.offset + n.release_offset;

// Constant-level windows with union on overlap. Other overlap policies belong to
// the author: build points directly, or combine curves using curve_add/curve_mul.
fn window_step(s, w, level, base) = if s.active && w[0] <= s.end {
        merge(s, {end: if w[1] > s.end {w[1]} else {s.end}})
    } else {
    {
        points: s.points + if s.active {[[s.start, level], [s.end, base]]} else {[]},
        start: if w[0] < 0s {0s} else {w[0]},
        end: w[1],
        active: true
    }
};
fn gate_windows(windows, level = -12, base = -120, start = 0s) {
    let ordered = sort_by(
        map(filter(windows, fn(w) => w[1] > start && w[1] > w[0]), fn(w) => [
            max(start, w[0]),
            w[1]
        ]),
        fn(w) => w[0]);
    let initial = {points: [], start: 0s, end: 0s, active: false};
    let result = fold(ordered, initial, fn(s, w) => window_step(s, w, level, base));
    let points = result.points + if result.active {
            [[result.start, level], [result.end, base]]
        } else {[]};
    curve(if len(points) == 0 {[[start, base]]} else {
        if points[0][0] > start {[[start, base]] + points} else {points}
    },
        "step")
}

fn throws(material, selector, target, level = -12, tail = 120ms, timing = {},
    start = 0s) = automation(target,
    gate_windows(
        map(material.select(selector).notes, fn(n) => [
            note_start(n, timing),
            note_end(n, timing) + tail
        ]),
        level, start = start));
