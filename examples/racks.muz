use "std/mix" as mix;
fn tone(cutoff = 1400) = rack(
    [[fx("lowpass")]],
    {id: "tone", expose: {cutoff: "0.0.cutoff_hz"}, cutoff: cutoff}
);
let motion = lfo(2b, 8b, low = 450, high = 3200);
song({
    tracks: [
        track("pulse", phrase("[C4 E4 G4]:q r:q [D4 F4 A4]:q r:q").repeat(2), synth("pad"), {
            chain: [tone(), mix.parallel_compression(0.2)],
            sends: {room: {gain: -20, pre: false}}
        })
    ],
    buses: [bus("room", [fx("reverb", {mix: 1, decay_s: 1.3})])],
    automation: [automation("pulse.tone.cutoff", motion)],
    master: [fx("limiter", {ceiling_db: -3})],
    tail: 2
})
