// Probe the lattice clarinet at held fingerings, as the impedance reference
// was measured: no reed, no player. Each track's incident pulse is measured
// at the reed reference plane, before the first bore delay. Track names are
// the written note; `_alt` is the alternate fingering.
use "clarinet_bore.muz" as c;
use "std/signal" as s;

fn measure(id, written, variant = 0) {
    let impulse = s.shape(s.note_age(), [[0, 0.1], [0.021ms, 0], [1s, 0]], "raw");
    // Small-signal, as the reference was measured: no jet resistance.
    let bore = c.pipe({fingering: written, variant: variant, key_time: 0, nonlinear: 0});
    let patch = voice_patch("passive_clarinet", {
        oversample: 2,
        output: bore.radiated,
        feedback: [[bore.incident, impulse]] + bore.feedback,
        probes: {incident: impulse, reflected: bore.reflected, radiated: bore.radiated}
    });
    track(id, note(60, 1b).gate(1), patch)
}
song({tempo: 60, tracks: [
    measure("e3", 52), measure("g3", 55), measure("c4", 60), measure("e4", 64), measure("fs4", 66),
    measure("g4", 67), measure("as4", 70), measure("b4", 71), measure("d5", 74), measure("g5", 79),
    measure("c6", 84), measure("cs6", 85), measure("f6", 89),
    measure("ds4_alt", 63, 1), measure("as4_alt", 70, 1)
]})
