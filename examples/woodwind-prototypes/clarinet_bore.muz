// Experimental fixed-geometry B-flat clarinet, sounding MIDI 50-87 (written
// E3-F6), with a tone-hole lattice. Every hole is a shunt junction whose
// open path (inertance and resistance) and closed chimney (compliance) are
// lumped filters, interpolated continuously by its key's travel. The bore
// below an open hole stays attached, so the lattice has a cutoff and cross
// fingerings work. The effective geometry and the fingering chart are in
// clarinet_geometry.muz, generated by tools/clarinet-lattice.py, which fits
// them to measured clarinet impedance and documents the elements.
use "std/physical" as ph;
use "std/signal" as s;
use "clarinet_geometry.muz" as geo;

let tau = 6.283185307179586;
fn sub(a, b) = s.add([a, s.mul([b, -1])]);

// --- Fingerings --------------------------------------------------------------------
//
// A note selects its fingering by its written pitch: `target_frequency`, the
// destination note before glide and tuning, a major second up. Its `fingering`
// control (0 standard, 1 alternate) picks the alternate where one exists. The
// fingering index is the written pitch, plus `variant_offset` for an
// alternate. Between two semitones a hole that changes moves through a
// shaded travel: a quarter tone is a part-covered hole. Across the register
// break and into the altissimo the fingering changes just below the quarter
// tone instead, and the player bends the upper fingering down.
let variant_offset = 40;
// Index offsets above the lower note where a change of mode switches fingering.
let switch_at = [0.42, 0.45];
let fingerings = geo.fingerings;
let alternates = filter(fingerings, fn(e) => e.alternate != null);
fn holes_open(e, variant) = if variant == 1 && e.alternate != null { e.alternate } else { e.open };
fn state(e, variant, name) = if contains(holes_open(e, variant), name) { 1 } else { 0 };

// Key travel at which the open path carries the fraction g of its admittance
// (the inverse of `opening` below). A quarter tone shades the holes that
// change to the fraction `shade` of the upper fingering's entry (generated by
// tools/clarinet-lattice.py so that it sounds between the semitones).
fn travel_for(g, pad) = if pad == null { g } else { pad * g / (1 + pad - g) };

// The travel of hole `name` (0 shut, 1 open) against the fingering index.
fn travel_points(name, pad) {
    let n = len(fingerings);
    let standard = fold(range(n), [], fn(points, k) => {
        let e = fingerings[k];
        let v = state(e, 0, name);
        let start = if k == 0 { [[e.written - 0.5, v]] } else {
            let p = fingerings[k - 1];
            let u = state(p, 0, name);
            if u == v { [] } else { if p.mode != e.mode {
                [[p.written + switch_at[0], u], [p.written + switch_at[1], v]]
            } else {
                [[p.written + 0.2, u], [p.written + 0.5, travel_for(if v == 1 { e.shade } else { 1 - e.shade }, pad)], [p.written + 0.8, v]]
            } }
        };
        let end = if k == n - 1 { [[e.written + 0.5, v]] } else { [] };
        points + start + end
    });
    standard + fold(alternates, [], fn(points, e) => points + [
        [e.written + variant_offset - 0.3, state(e, 1, name)],
        [e.written + variant_offset + 0.3, state(e, 1, name)]
    ])
}

// Written notes with an alternate fingering: 1, else 0.
let alternate_points = fold(alternates, [[fingerings[0].written - 1, 0]], fn(points, e) => points + [
    [e.written - 0.6, 0], [e.written - 0.4, 1], [e.written + 0.4, 1], [e.written + 0.6, 0]
]) + [[fingerings[len(fingerings) - 1].written + 1, 0]];

// A curve of one value per fingering against the fingering index, from
// `value(entry, variant)`.
fn by_fingering(value) = map(fingerings, fn(e) => [e.written, value(e, 0)]) +
    map(alternates, fn(e) => [e.written + variant_offset, value(e, 1)]);

// Across a change of mode (the break, the altissimo) the fingering changes
// just below the quarter tone, so a quarter tone there takes the upper
// fingering bent down. `by_index` is `by_fingering` with that step: on either
// side of it the value stays the neighbouring fingering's, plus `cents` per
// semitone of distance from it (1 for a pitch in cents of the index).
fn by_index(value, cents) = fold(range(len(fingerings)), [], fn(points, k) => {
    let e = fingerings[k];
    let step = if k == 0 { [] } else {
        let p = fingerings[k - 1];
        if p.mode == e.mode { [] } else {
            [[p.written + switch_at[0], value(p, 0) - cents * 100 * switch_at[0]],
             [p.written + switch_at[1], value(e, 0) + cents * 100 * (1 - switch_at[1])]]
        }
    };
    points + step + [[e.written, value(e, 0)]]
}) + map(alternates, fn(e) => [e.written + variant_offset, value(e, 1)]);

// The fingering index of written-pitch `written` and `variant`.
fn fingering_index(written, variant) = s.add([
    written,
    s.mul([variant, s.shape(written, alternate_points, "raw"), variant_offset])
]);

// The written pitch of a frequency on a B-flat instrument.
fn written_of(frequency) = s.add([s.mul([s.mapping(frequency, "log2"), 12]), 71 - 12 * ln(440) / ln(2)]);

// --- Holes ---------------------------------------------------------------------------
//
// A hole's open path is an inertance with resistance: as a shunt between two
// equal bore segments its pressure release is a one-pole lowpass of the
// pressure there, of corner rho + g alpha / 2 and depth g alpha / (2 rho +
// g alpha), where g is the open path's admittance at the key's travel. The
// closed chimney is a compliance: a highpass of gain kappa at `closed_hz`.
// The series inertance is a length correction on the segments.
fn opening(x, pad) = if pad == null { x } else { (1 + pad) * x / (x + pad) };
let travels = [0, 0.004, 0.01, 0.02, 0.035, 0.05, 0.075, 0.1, 0.14, 0.2, 0.28, 0.38, 0.5, 0.65, 0.8, 1];
fn corner_points(hole) = map(travels, fn(x) => [x, hole.alpha_hz * (hole.resistance + opening(x, hole.pad) / 2)]);
fn depth_points(hole) = map(travels, fn(x) => {
    let g = opening(x, hole.pad);
    [x, 0 - g / (2 * hole.resistance + g)]
});

// The scattering at one hole for waves `a` (arriving from above) and `b`
// (from below) with key travel `x`. `flow` is the open path's volume flow out
// of the hole (normalized), which radiates.
fn junction(hole, a, b, x, nonlinear_scale) {
    let w = s.add([a, b]);
    let nonlinear = hole.nonlinear * nonlinear_scale;
    // A narrow hole's flow separates into a jet at high velocity: a
    // resistance growing with |velocity| (Atig, Dalmont & Gilbert 2004). It
    // follows the hole's flow one sample late.
    let late = if nonlinear > 0 { s.line(0s, {interpolation: "linear", max_seconds: 1ms}) } else { null };
    let open = if nonlinear == 0 {
        s.mul([s.lowpass1(w, s.shape(x, corner_points(hole), "raw")), s.shape(x, depth_points(hole), "raw")])
    } else {
        let r = s.add([hole.resistance, s.mul([s.mapping(late, "abs"), nonlinear])]);
        let g = s.shape(x, map(travels, fn(t) => [t, opening(t, hole.pad)]), "raw");
        let corner = s.mul([s.add([r, s.mul([g, 0.5])]), hole.alpha_hz]);
        let depth = s.mul([g, s.mapping(s.add([s.mul([r, 2]), g, 0.000001]), "reciprocal"), -1]);
        s.mul([s.lowpass1(w, corner), depth])
    };
    let released = s.add([w, open]);
    let leak = s.add([open, s.mul([s.highpass1(released, hole.closed_hz * 1Hz), 0 - hole.kappa])]);
    {up: s.add([b, leak]), down: s.add([a, leak]), flow: open,
     feedback: if nonlinear > 0 { [[late, open]] } else { [] }}
}

// --- Keys --------------------------------------------------------------------------
//
// A finger or pad travels from its stop to its seat and back: it leaves the
// stop at rest, moves, and lands on the seat or the stop at speed, so the
// motion ends at a definite moment. The travel is a slew toward a target
// `overshoot` past either end, clamped to 0..1: the clamp is the seat and the
// stop. A finger moves a key one way and its spring the other, and a spring
// is slower (Almeida, Chow, Smith & Wolfe 2009 measured about 10 ms for a
// finger and 16 ms for a spring on the flute); `key_travel` is the time from
// stop to seat, counted from the note's change, so a player's anticipation is
// already in it. Most of a hole's acoustic change happens in the last part of
// its travel, near the seat, where the pad or finger curtain sets the open
// path (`pad`; a finger over its hole is a curtain too, `finger_pad`).
//
// Fingers move in a fixed order in a change of fingering: the thumb and
// register key first, then the left hand, the right hand and the little
// fingers, `stagger` times the note's `key_time` control (0..1, default 0.4)
// apart: 0 moves every key together, 1 spreads a change over 18 ms. A hole
// that does not change does not move, so only the fingers that change show
// the stagger.
let key_groups = {
    reg: 0, t: 0, tr: 2, a: 1, gs: 1, v: 1, l1: 1, sl: 1, l2: 1, eb: 2, l3: 1, cs: 3,
    r1: 2, r2: 2, bb: 2, r3: 2, gsds: 3, fscs: 3, fc: 3, eb_low: 3
};
// Which mover opens and which closes each kind of hole: a finger hole is
// lifted and pressed by its finger; a closed-standing key is opened by its
// lever and shut by its spring; an open-standing key or a ring vent is shut
// by its finger and reopened by its spring.
fn key_drives(hole) = if hole.kind == "finger" { ["finger", "finger"] } else {
    if hole.kind == "open" { ["spring", "finger"] } else { if hole.kind == "register" { ["register", "spring"] } else { ["finger", "spring"] } }
};

// --- The bore --------------------------------------------------------------------------
//
// For a passive probe add [pipe.incident, wave] to pipe.feedback.
// `fingering`: a written pitch (number or signal) instead of the note's;
// `variant` likewise for its `fingering` control. `lip` is a signal of extra
// mouthpiece round-trip seconds: the player's embouchure. `scale` stretches
// every delay (the played instrument's air against the measured one's) and
// `reed_mm` lengthens the mouthpiece by the reed's equivalent volume; the
// passive probes leave both at their measured values.
fn pipe(options = {}) {
    let o = merge({
        index: null, fingering: null, variant: null, lip: 0, scale: 1, reed_mm: 0, max_lip: 0.2ms,
        key_time: null, stagger: 6ms, key_speed: 1, radiation_hz: 20000Hz, nonlinear: 1, key_groups: key_groups,
        overshoot: 0.5, key_travel: {finger: 5ms, spring: 8ms, register: 5ms}, finger_pad: 0.15
    }, options);
    let index = if o.index != null { o.index } else {
        let written = if o.fingering == null { written_of(s.target_frequency()) } else { o.fingering };
        fingering_index(written, if o.variant == null { s.expression("fingering") } else { o.variant })
    };
    let key_time = if o.key_time == null { s.expression("key_time") } else { o.key_time };
    // The slew time constant of each group's finger and spring moves: a later
    // finger in the order arrives `stagger` times key_time later.
    let per_travel = 1 / o.key_speed / ln((1 + 2 * o.overshoot) / o.overshoot);
    let slews = map(range(4), fn(g) => {
        let late = s.mul([key_time, o.stagger * g]);
        {finger: s.mul([s.add([late, o.key_travel.finger]), per_travel]),
         spring: s.mul([s.add([late, o.key_travel.spring]), per_travel]),
         register: s.mul([s.add([late, o.key_travel.register]), per_travel])}
    });

    let holes = map(geo.holes, fn(h) => if h.pad == null { merge(h, {pad: o.finger_pad}) } else { h });
    let n = len(holes);
    // At least 88.2 kHz internal rate keeps every cubic segment above two samples.
    let seconds = map(range(n), fn(k) => holes[k].seconds * o.scale) + [geo.bell_seconds * o.scale];
    assert(len(filter(seconds, fn(t) => t < 2 / 88200)) == 0, "clarinet bore segment is shorter than two samples at 88.2 kHz");
    fn line(t) = s.line(t * 1s, {max_seconds: (t + 0.0001) * 1s});
    let top = seconds[0] + o.reed_mm / 1000 / geo.speed;
    let down = [s.line(s.add([top * 1s, o.lip]), {max_seconds: top * 1s + o.max_lip + 0.1ms})] +
        map(slice(seconds, 1, n + 1), line);
    let up = [line(top)] + map(slice(seconds, 1, n + 1), line);
    // Each segment's round-trip wall loss, on its returning wave (lumped onto
    // the top segment of each run of five; the others carry gain 1).
    let gains = geo.segment_gain;
    let shelf = geo.loss.shelf;
    let mouthpiece = s.mul([s.add([s.mul([up[0], 1 - shelf]), s.mul([s.lowpass1(up[0], geo.loss.shelf_hz * 1Hz), shelf])]), gains[0]]);
    let returning = map(range(1, n + 1), fn(k) => if gains[k] == 1 { up[k] } else { s.mul([up[k], gains[k]]) });
    let travel = map(range(n), fn(k) => {
        let hole = holes[k];
        let a = o.overshoot;
        let times = map(key_drives(hole), fn(d) => slews[o.key_groups[hole.name]][d]);
        let points = map(travel_points(hole.name, hole.pad), fn(p) => [p[0],
            if p[1] == 0 { 0 - a } else { if p[1] == 1 { 1 + a } else { p[1] } }]);
        let target = s.shape(index, points, "raw");
        // Every reader of the travel is a curve that holds its end values,
        // so the seat and the stop need no clamp of their own.
        s.slew(target, times[0], times[1])
    });
    let junctions = map(range(n), fn(k) => junction(holes[k], down[k], returning[k], travel[k], o.nonlinear));
    let last = down[n];
    let bell = s.mul([s.lowpass1(s.lowpass1(last, geo.loss.bell_hz * 1Hz), geo.loss.bell_hz * 1Hz), 0 - geo.loss.bell]);
    // Radiation. Each opening radiates as a monopole, whose far-field pressure
    // is the rate of change of its volume flow. An open hole's flow is twice
    // its pressure release (`flow`, minus half the hole's admittance times
    // the junction pressure); the bell's is its incident less its reflected
    // wave. The openings are summed as one source: their spacing (under half
    // a metre) and the bell's directivity are left out. A highpass far above
    // the audio band is the time derivative, scaled by 1 / (2 pi radiation_hz).
    let released = map(junctions, fn(j) => j.flow);
    let holes_flow = s.add([s.add(slice(released, 0, 9)), s.add(slice(released, 9, n))]);
    let flow = s.add([s.mul([holes_flow, -2]), last, s.mul([bell, -1])]);
    {
        incident: down[0], reflected: mouthpiece,
        radiated: s.highpass1(flow, o.radiation_hz),
        travel: record(map(range(n), fn(k) => [holes[k].name, travel[k]])),
        flows: record(map(range(n), fn(k) => [holes[k].name, junctions[k].flow])),
        index: index,
        feedback: [[up[n], bell]] + fold(range(n), [], fn(links, k) =>
            links + [[up[k], junctions[k].up], [down[k + 1], junctions[k].down]] + junctions[k].feedback)
    }
}

// An optional exciter(mouth, returning) returns {flow, feedback}.
// `turbulence` is a noise flow added at the reed channel: the jet's
// turbulence enters the bore and radiates through it.
fn model(mouth, options = {}) {
    let o = merge({
        exciter: null, embouchure: 0.12, tight: 0.32, loose: 0.55,
        turbulence: 0
    }, options);
    let b = pipe(o);
    let returning = b.reflected;
    let reed = if o.exciter == null {
        {flow: ph.bernoulli(sub(mouth, s.mul([returning, 2])), o.embouchure, o.tight, o.loose), feedback: []}
    } else {o.exciter(mouth, returning)};
    let flow = if o.turbulence == 0 { reed.flow } else { s.add([reed.flow, o.turbulence]) };
    {
        flow: flow,
        inside: s.add([s.mul([returning, 2]), flow]),
        radiated: b.radiated, travel: b.travel, flows: b.flows, index: b.index,
        feedback: [[b.incident, s.add([returning, flow])]] + b.feedback + reed.feedback
    }
}
