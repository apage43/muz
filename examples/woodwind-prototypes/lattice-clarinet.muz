// Experimental fixed-bore B-flat clarinet, played by std/woodwinds' player.
// One reed and every bore segment stay live across a slur; the destination
// note's fingering moves the keys, each at its own speed. The player keeps
// the note in tune with a small change of the mouthpiece's effective length
// (the embouchure), from the tuned frequency against the fingering's own
// pitch. See README.md for the model's current limits.
use "std/signal" as s;
use "std/instrument" as i;
use "std/woodwinds" as w;
use "clarinet_bore.muz" as cb;
use "clarinet_tuning.muz" as tuning;
use "reed_dynamics.muz" as rd;
use "clarinet_geometry.muz" as geo;

fn sub(a, b) = s.add([a, s.mul([b, -1])]);

// The fingering's own pitch, in cents from the written note, at dynamic
// `reference` + x is n0 + n1 x + n2 x^2 (tuning.natural, measured by
// tools/clarinet-lattice.py tune).
fn natural_points(k) = cb.by_index(fn(e, variant) => {
    let found = filter(tuning.natural, fn(t) => t.written == e.written && t.variant == variant);
    if len(found) == 0 { 0 } else { found[0].cents[k] }
}, if k == 0 { 1 } else { 0 });
// Seconds of mouthpiece round trip per cent per second of period: a length
// change moves the sounding mode by its share of the tube's quarter waves.
let per_cent = cb.by_index(fn(e, variant) => (2 * e.mode - 1) / 2 * ln(2) / 1200, 0);

// `lattice` options (defaults below) set the player: the lip force and the
// reed it loads, the breath in kPa, the vocal tract, and the tuning
// embouchure.
// `tuned: false` leaves the mouthpiece length still (the fingering's own
// pitch).
fn patch(overrides = {}) {
    let o = merge(w.specs.clarinet, {lattice: {}}, overrides);
    assert(o.oversample >= 2, "the lattice clarinet requires at least 2x oversampling");
    let settings = merge({
        // The player's lip force in newtons and blowing pressure in kPa per
        // sounding mode (chalumeau and throat, clarion, altissimo): the
        // force at dynamic 0.5 (`lip_newtons`), the pressure at dynamic 0
        // and 1 on the register's lowest note (`breath_kpa`), and how the
        // force falls per kPa as the player gets louder (`lip_slope`), along
        // the contours of equal pitch. Almeida, George, Smith & Wolfe (2013)
        // played G3 and G4 with a lip at the middle of the reed at 1.4 N and
        // G5 at 0.4-0.9 N (here 0.65), with contours of equal pitch falling
        // 0.3 N per kPa (G5's were flatter on their reed; on this one they
        // fall 0.28 N per kPa). Fuks & Sundberg (1999) measured players at
        // 2.3-3.0 kPa pp and 4.3-6.4 kPa ff, falling little with pitch at pp
        // and 15-25% per octave at ff within a register, highest on the
        // lowest clarion notes: `pressure_octave` (per end of the dynamic)
        // and `overblow`. The altissimo's force and pressures are
        // estimated. `lip_time` slews the force between notes (0: the lip
        // moves with the fingers).
        lip_newtons: [1.4, 0.65, 1.4], lip_slope: -0.3, lip_time: 0ms,
        breath_kpa: [[1.9, 6.8], [2.9, 5.7], [2.2, 5.0]],
        pressure_octave: [[-0.03, -0.15], [-0.08, -0.25], [-0.18, -0.18]], overblow: 0.15, overblow_to: 76,
        // Overrides of the reed under the lip (reed_dynamics.lip_reed, whose
        // defaults are this reed): its static closing pressure, falling with
        // the lip's force along Almeida et al.'s extinction line, its tip
        // opening and width, and its resonance and damping under the lip.
        reed: {},
        // The vocal tract: one resonance at `tract_hz` whose peak impedance
        // is `tract_peak` bore characteristic impedances, as Fritz & Wolfe
        // (2005) measured in normal playing (1.0-1.4 kHz, 1.3-4 Zc), the same
        // for most of the range. Playing loud in the upper clarion (from
        // written `upper_from`), the player strengthens it to `upper_peak`
        // (the top of Fritz & Wolfe's range, its resonance kept) as the
        // breath rises from `upper_kpa[0]` to `upper_kpa[1]` kPa, as players
        // voice high notes played loud (Chen, Smith & Wolfe 2009;
        // Pamies-Vila et al. 2020), so A#5-C6 hold their register to the
        // loud end of the player's breath instead of falling to the first
        // impedance peak, a twelfth below (tuned onto the note or above it
        // instead, the tract holds them less far). In the altissimo the
        // player tunes it
        // `altissimo_offset` Hz above the note at `altissimo_peak` (Chen,
        // Smith & Wolfe 2009; estimated), and voices a slur or a tongued
        // attack into it `ascent_peak` stronger for `ascent_time`.
        // The player's `voicing` and `tract` note controls
        // (std/physical.wind_player, 0.5 neutral) scale the strength (twice
        // for every 0.125) and the resonance (two octaves either way) of the
        // tract so set.
        tract_hz: 1300, tract_peak: 1.5, tract_q: 8,
        upper_from: 82, upper_peak: 4, upper_kpa: [3, 4.5],
        altissimo_offset: 120, altissimo_peak: 10,
        ascent_peak: 10, ascent_time: 40ms, ascent_offset: 20,
        // Breath turbulence: a noise flow at the reed channel, in units of
        // the player's noise times the blowing pressure in units of
        // `unit_kpa`. That is the model's pressure unit, which the register
        // hole's jet resistance in clarinet_geometry.muz shares
        // (tools/clarinet-lattice.py's P_CLOSE).
        turbulence: 0.0025, unit_kpa: 5,
        tuned: true, lip_cents: [-70, 50], scale: tuning.scale, reed_mm: tuning.reed_mm, key_speed: 1,
        trim_db: 13
    }, o.lattice);
    let pl = w.player_of(o);
    let d = pl.dynamic;
    // The dynamic the player plans: the note's velocity and pressure curve,
    // as std/physical.wind_player reads them, without the tongue's burst,
    // flutter or the breath's vibrato, which the breath carries (`d`). The
    // embouchure (the lip's force and the tuning that rides on it) and the
    // voicing follow the plan, as a player sets them for a dynamic rather
    // than for each pulse of the tongue; it changes only at the player's
    // events, so the reed's and the tract's coefficients rest between them.
    let planned = s.slew(s.mapping(s.add([s.mul([s.velocity(), s.expression("velocity_breath")]),
        s.expression("pressure")]), "clamp", 0, 1), 5ms, 5ms);
    let target = s.target_frequency();
    let index = cb.fingering_index(cb.written_of(target), s.expression("fingering"));
    fn per_mode(values) = s.shape(index, cb.by_fingering(fn(e, v) => values[e.mode - 1]), "raw");

    // The breath in kPa: the register's pressure at this dynamic, shaped
    // along the register. `swell` is its span per unit of dynamic.
    fn overblow(e) = if e.written >= 71 && e.written <= settings.overblow_to { settings.overblow } else { 0 };
    let bottom = map([1, 2, 3], fn(m) => fold(cb.fingerings, 200, fn(b, e) => if e.mode == m { min(b, e.written) } else { b }));
    // The pressure at dynamic `end` (0 or 1) of fingering `e`.
    fn breath_at(e, end) = settings.breath_kpa[e.mode - 1][end] *
        (1 + settings.pressure_octave[e.mode - 1][end] * (e.written - bottom[e.mode - 1]) / 12 + overblow(e));
    let low = s.shape(index, cb.by_fingering(fn(e, v) => breath_at(e, 0)), "raw");
    let swell = s.shape(index, cb.by_fingering(fn(e, v) => breath_at(e, 1) - breath_at(e, 0)), "raw");
    // The tongue's back stop holds the breath out of the mouthpiece until
    // the mouth fills (`pl.fill`); its tip on the reed holds the channel
    // shut (`pl.opening`, below).
    let kpa = s.mul([pl.envelope, s.add([low, s.mul([d, swell])])]);
    let gamma = s.mul([kpa, pl.fill, 1 / settings.unit_kpa]);

    // The lip force follows the register and, along a crescendo, falls
    // `lip_slope` newtons per kPa from its force at dynamic 0.5.
    let slope = s.shape(index, cb.by_fingering(fn(e, v) =>
        settings.lip_slope * (breath_at(e, 1) - breath_at(e, 0))), "raw");
    let held = s.add([per_mode(settings.lip_newtons), s.mul([s.add([planned, -0.5]), slope])]);
    let force = if settings.lip_time == 0 { held } else { s.slew(held, settings.lip_time, settings.lip_time) };
    let reed = rd.lip_reed(force, merge(settings.reed, {unit_kpa: settings.unit_kpa, radius: geo.bore_radius, speed: geo.speed}));

    // The vocal tract's resonance and strength: steady, stronger as the
    // breath rises in the upper clarion, and in the altissimo tuned above
    // the note. On a slur up into the altissimo, and
    // on a tongued attack there, the player voices the new note: for
    // `ascent_time` the resonance moves onto it, `ascent_peak` stronger
    // (Pamies-Vila et al. 2020: a stronger tract shortens those attacks; a
    // tract peak this strong draws the reed to it, Chen et al. 2009). `rise`
    // is 1 at the change and falls to 0.
    let altissimo = per_mode([0, 0, 1]);
    let upper = s.shape(index, cb.by_fingering(fn(e, v) => if e.mode == 2 && e.written >= settings.upper_from { 1 } else { 0 }), "raw");
    let planned_kpa = s.add([low, s.mul([planned, swell])]);
    let lean = s.mul([upper, s.mapping(s.mul([s.add([planned_kpa, 0 - settings.upper_kpa[0]]),
        1 / (settings.upper_kpa[1] - settings.upper_kpa[0])]), "clamp", 0, 1)]);
    let rise = if settings.ascent_peak == 0 { 0 } else {
        let attack = s.mul([s.add([pl.envelope, s.mul([s.slew(pl.envelope, settings.ascent_time, 0ms), -1])]), altissimo]);
        s.mapping(s.add([altissimo, s.mul([s.slew(altissimo, settings.ascent_time, 0ms), -1]), attack]), "clamp", 0, 1) };
    let peak = s.add([settings.tract_peak, s.mul([altissimo, settings.altissimo_peak - settings.tract_peak]),
        s.mul([lean, settings.upper_peak - settings.tract_peak])]);
    // The player's voicing and tract controls, as std/physical.wind_player reads them.
    let voiced = s.mapping(s.mul([s.add([s.slew(s.expression("voicing"), 12ms, 12ms), -0.5]), 8]), "exp2");
    let moved = s.mapping(s.mul([s.add([s.slew(s.expression("tract"), 12ms, 12ms), -0.5]), 4]), "exp2");
    let voicing = s.slew(s.mul([s.add([peak, s.mul([rise, settings.ascent_peak])]), voiced, 1 / settings.tract_q]), 8ms, 8ms);
    let resting_tract = s.add([settings.tract_hz,
        s.mul([altissimo, s.add([target, settings.altissimo_offset - settings.tract_hz])])]);
    let own_tract = if settings.ascent_peak == 0 { resting_tract } else {
        s.add([resting_tract, s.mul([rise, s.add([target, settings.ascent_offset, s.mul([resting_tract, -1])])])]) };
    let tract_hz = s.mul([own_tract, moved]);
    fn exciter(mouth, returning) = rd.dynamic(mouth, returning, {
        embouchure: s.mul([reed.embouchure, cb.mouthpiece_impedance, pl.opening]), tight: 0, loose: 1,
        compliance: reed.compliance, reed_hz: reed.reed_hz, reed_q: reed.reed_q,
        voicing: voicing, tract_hz: tract_hz, tract_gain: 1 / cb.mouthpiece_impedance, tract_q: settings.tract_q
    });
    // The player's pitch against the fingered note: tuning and glide
    // (frequency over target), drift and vibrato, less the fingering's own
    // pitch at this dynamic.
    let x = s.add([planned, 0 - tuning.reference]);
    let natural = s.add([
        s.shape(index, natural_points(0), "raw"),
        s.mul([x, s.shape(index, natural_points(1), "raw")]),
        s.mul([x, x, s.shape(index, natural_points(2), "raw")])
    ]);
    let wanted = s.add([
        s.mul([s.mapping(s.mul([s.frequency(), s.period(target)]), "log2"), 1200]),
        pl.cents, s.mul([natural, -1])
    ]);
    let lip = if settings.tuned {
        s.mul([s.mapping(wanted, "clamp", settings.lip_cents[0], settings.lip_cents[1]),
               s.shape(index, per_cent, "raw"), s.period(target), -1])
    } else { 0 };
    let bore = cb.model(gamma, merge(settings, {
        exciter: exciter, index: index, lip: lip, max_lip: 0.25ms, key_speed: settings.key_speed,
        vent: s.expression("vent"),
        turbulence: s.mul([pl.noise, gamma, settings.turbulence])
    }));
    voice_patch(o.name, {
        note_controls: merge(pl.controls, {fingering: 0, key_time: 0.6, vent: 0}),
        velocity_track: 0, oversample: o.oversample, gain_db: o.gain_db + settings.trim_db,
        output: s.mul([bore.radiated, w.level_of(o, planned)]),
        feedback: bore.feedback,
        probes: {inside: bore.inside, mouth: gamma, flow: bore.flow, dynamic: d, lip: lip, force: force, register: bore.flows.reg},
        lifetime: {envelope: pl.envelope, tail: 150ms}
    })
}

fn clarinet(overrides = {}) = i.mono(patch(overrides), 0ms);

// Leading with the register key on an ascent across the break: over the
// last `vent_lead` milliseconds before the change (at `change_ms` into the
// note) the player lifts the register key `vent_crack` of its travel (the
// `vent` expression, 0..1). Clarinet teachers have the thumb lead the
// fingers across the break. The geometry gives the lift and lead it was
// played with (from its JSON's "player").
let vent_lead = geo.vent_lead;
let vent_crack = geo.vent_crack;
fn vent_curve(change_ms) = [[0ms, 0], [(change_ms - vent_lead) * 1ms, 0], [change_ms * 1ms, vent_crack]];
// A note rule for `w.perform` or `w.play` (`rule:`) around `rule`: a note
// slurred into a clarion or altissimo note from below the break leads with
// the register key. Sounding MIDI 68 is the written throat B-flat.
fn vented(rule) = fn(n, c) => {
    let r = rule(n, c);
    let next = c.next;
    let up = next != null && next.at == n.at + n.duration && c.has(next, "slur") && n.pitch <= 68 && next.pitch >= 69;
    if !up { r } else {
        let data = merge({data: {}}, r).data;
        let expression = merge({expression: {}}, data).expression;
        merge(r, {data: merge(data, {expression: merge(expression, {vent: vent_curve(c.seconds * 1000)})})})
    }
};

// The player profile to perform the lattice clarinet with (`w.perform` or
// `w.play`): std/woodwinds' clarinet, with its resting tract at the
// lattice's (1.3 kHz), so the `tract` it writes to tune a slur up across the
// break lands where it means, and no altissimo tuning of its own: in the
// altissimo the lattice's player tunes the tract itself, and the std
// player's `high` would tune it twice.
let spec = merge(w.specs.clarinet, {tract: 1300Hz, player: merge(w.specs.clarinet.player, {altissimo: 0})});
