// Small engine example; complete pieces belong in muz-projects.
use "std/synthesis" as synths;
use "std/instrument" as instrument;
let pad = instrument.sound(
    synths.pad(),
    [fx("chorus", {mix: 0.1})],
    macros = {brightness: [{target: "instrument.tone", offset: 200, scale: 4000}]}
);
let notes = phrase("C3:q E3:q G3:q B3:q");
song({
    tempo: 120,
    tracks: [
        instrument.play("pad", phrase("[C3 E3 G3]:w"), pad),
        track("lead", instrument.variation(notes.gate(1.1), 3), synths.lead()),
        track("body", notes.at(4b), synths.struck(500ms)),
        track("pluck", notes.at(8b), synths.pluck()),
        track("texture", note("C4", 4b, at = 12b), synths.texture())
    ],
    automation: instrument.automate("pad", pad, "brightness", curve([[0b, 0], [4b, 1]])),
    tail: 4
})
