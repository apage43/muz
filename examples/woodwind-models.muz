// Woodwinds from parts. std/woodwinds' instruments are specs over std/physical's
// parts, so a new instrument is either a changed spec or a few lines of parts.
use "std/woodwinds" as w;
use "std/physical" as p;
use "std/signal" as s;

let timing = {tempo: 72};
let tune = phrase("D4:q F4:e@slur A4:e@slur G4:h@niente").gain(0.55);

// A derived instrument: an English horn is an oboe a fifth lower, with a bulb
// that darkens it. Recalibrate a derived spec before relying on its tuning
// (tools/woodwinds.py calibrate english_horn --spec ...); the oboe's tables hold
// roughly when the bore keeps its shape.
let english_horn = w.derive(w.specs.oboe, {
    name: "english_horn",
    range: [52, 84],
    octave_key: 69,
    key_top: 0,
    track_curve: null,
    formants: [[1000Hz, 1.6, 3.5], [2400Hz, 3, 1]]
});

// A new instrument from parts: a stopped pipe, a cylinder blown through a soft,
// open reed, with more air in it. `wind_player` is the breath, tongue and
// fingers every std woodwind uses; `turbulence` is its shaped breath noise.
fn stopped_pipe() {
    let player = p.wind_player({attack: 40ms, release: 120ms, finger: 0.05, noise: {cutoff: 2000Hz}});
    let f = s.frequency();
    let mouth = s.mul([player.envelope, s.add([0.3, s.mul([player.dynamic, 0.25])])]);
    let end = p.open_end(f, 1400Hz, 2);
    let bore = p.cylinder(mouth, p.cents(f, player.cents), {
        tone: end.cutoff,
        tight: 0.5,
        loose: 0.7,
        turbulence: s.add([1, s.mul([player.noise, 0.15])])
    });
    voice_patch("stopped-pipe", {
        gain_db: -2,
        velocity_track: 0,
        note_controls: player.controls,
        output: s.add([bore.radiated, s.mul([bore.inside, 0.3])]),
        feedback: bore.feedback,
        lifetime: {envelope: player.envelope, tail: 200ms}
    })
};

song({
    tempo: timing.tempo,
    tracks: [
        track("english-horn", w.perform(tune.transpose(-5), english_horn, {timing: timing}), w.instrument(english_horn)),
        track("pipe", phrase("D3:w D3:w").gain(0.5).at(4b), stopped_pipe())
    ],
    master: [fx("reverb", {decay_s: 1.6, mix: 0.22})],
    tail: 2
})
