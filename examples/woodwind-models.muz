// Blown instruments from std/physical: a reed or an air jet inside a bore's loop.
// Each recipe reads its breath from the note: velocity and a `pressure` curve set
// how hard it is blown, which changes the tone as well as the level.
use "std/physical" as p;
use "std/signal" as s;
use "std/instrument" as i;

// One slurred phrase per instrument. `i.mono` keeps the bore sounding through a
// slur, so the new pitch grows out of the old note instead of being tongued.
let swell = {pressure: [[0, 0], [0.6, 0.35], [1, 0.1]], vibrato: [[0, 0], [0.5, 0], [1, 0.6]]};
let tune = i.slur(phrase("D4:q F4:e@slur A4:e@slur G4:h").gain(0.55), "slur");
let clarinet = track("clarinet", tune.transpose(-12).express(swell), i.mono(p.clarinet(), 25ms));
let oboe = track("oboe", tune.at(4b).express(swell), i.mono(p.oboe(), 20ms));
// The flute's `jet` control is the player's lip: 0.25 overblows the last note an
// octave from the same fingering.
let flute = track(
    "flute",
    stack([
        tune.transpose(12).at(8b).express(swell),
        phrase("G5:h").gain(0.6).at(12b).express({jet: 0.25})
    ]),
    p.flute({air: 0.16})
);

// The parts are ordinary signals, so a new instrument is a few lines: a stopped
// pipe is a cylinder driven by breath through a soft reed, with more air in it.
fn pipe() {
    let tongue = s.adsr(60ms, 200ms, 0.9, 120ms);
    let player = p.player({vibrato_cents: 12});
    let bore = p.cylinder(
        p.breath(tongue, player.level, 0.75, 0.95, 0.3),
        player.frequency,
        {tone: 1400Hz, aperture: 0.62, stiffness: 0.34}
    );
    voice_patch("stopped-pipe", {
        gain_db: 4,
        velocity_track: 0,
        output: p.dynamics(bore.inside, player.frequency, player.level),
        feedback: bore.feedback,
        lifetime: {envelope: tongue, tail: 200ms}
    })
};
let drone = track("pipe", phrase("D3:w D3:w A2:w D3:w").gain(0.4), pipe());

song({
    tempo: 72,
    tracks: [clarinet, oboe, flute, drone],
    master: [fx("reverb", {decay_s: 1.6, mix: 0.22})],
    tail: 2
})
