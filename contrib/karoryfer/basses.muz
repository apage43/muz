// Builder: a function body evaluates in its defining module, so this call stamps
// this pack's directory as the asset root. Calling sample() from a piece instead
// would resolve the zone paths against that piece's directory.
fn bass(options = {}) = sample(bass_zones, options);
// Build an adjusted zone table (transposed roots, different layers) while
// keeping this pack as the asset root.
fn instrument(zones, options = {}) = sample(zones, options);
