// Source metadata is structured so take selection needs no filename parsing.
let electric_roots = [
    [37, "db2", 33, 38],
    [40, "e2", 39, 40],
    [42, "gb2", 41, 43],
    [45, "a2", 44, 46],
    [48, "c3", 47, 49],
    [51, "eb3", 50, 52],
    [54, "gb3", 53, 55],
    [57, "a3", 56, 58],
    [60, "c4", 59, 61],
    [63, "eb4", 62, 64],
    [66, "gb4", 65, 67],
    [69, "a4", 68, 70],
    [72, "c5", 71, 73],
    [75, "eb5", 74, 76],
    [78, "gb5", 77, 79],
    [81, "a5", 80, 82],
    [84, "c6", 83, 91]
];
fn electric_takes(takes) = electric_roots
    .map(
        fn(z) => range(3)
            .map(
                fn(v) => takes.map(fn(take) => {
                    path: format("assets/guitar/Samples/electric/{}_vl{}_rr{}_2.wav", [
                        z[1],
                        v + 2,
                        take
                    ]),
                    root: z[0],
                    keys: [z[2], z[3]],
                    velocity: [[0, 64.5 / 127], [64.5 / 127, 96.5 / 127], [96.5 / 127, 1]][v]
                })
            )
            .fold([], fn(a, b) => a + b)
    )
    .fold([], fn(a, b) => a + b);
let electric_left_zones = electric_takes([1, 3]);
let electric_right_zones = electric_takes([2, 4]);
let electric_release_zones = electric_roots
    .map(
        fn(z) => [1, 2].map(fn(take) => {
            path: format("assets/guitar/Samples/electric/{}_release_rr{}_2.wav", [z[1], take]),
            root: z[0],
            keys: [z[2], z[3]]
        })
    )
    .fold([], fn(a, b) => a + b);

// Builders: a function body evaluates in its defining module, so these calls
// stamp this pack's directory as the asset root. Calling sample() from a piece
// instead would resolve the zone paths against that piece's directory.
fn acoustic(options = {}) = sample(acoustic_zones, options);
fn electric(options = {}) = sample(electric_zones, options);
fn electric_left(options = {}) = sample(electric_left_zones, options);
fn electric_right(options = {}) = sample(electric_right_zones, options);
fn electric_release(options = {}) = sample(electric_release_zones, options);
// Build an adjusted zone table (a different take selection or register) while
// keeping this pack as the asset root.
fn instrument(zones, options = {}) = sample(zones, options);
