// Unreal Instruments Standard Guitar: 25 chromatic roots E2-E4, eight recorded
// takes per root, `sustain`/`mute` articulations. Zone order is musically
// significant: the sampler picks round robins by index, so takes are emitted in
// recording order and must not be reordered.
//
// Only the map ships here. The publisher permits commercial music without
// credit but prohibits redistribution, so the recordings stay out of git;
// `install.py` restores them from the publisher archive into
// `assets/standard-guitar/` relative to this file.
//
// Sustain and mute honor written note-offs; their release envelopes finish the tail.
// Use voice(art, {one_shot: true}) explicitly for uninterrupted recordings.
//
// Original Standard Guitar FLAC recordings remain unmodified in assets/.
// Chromatic E2–E4 coverage, eight recorded takes per root and articulation.
// Outer key bounds retain the preceding map's range; played roots/takes stay unchanged.
let roots = [
    [40, "e2", 35, 40],
    [41, "f2", 41, 41],
    [42, "f#2", 42, 42],
    [43, "g2", 43, 43],
    [44, "g#2", 44, 44],
    [45, "a2", 45, 45],
    [46, "a#2", 46, 46],
    [47, "b2", 47, 47],
    [48, "c3", 48, 48],
    [49, "c#3", 49, 49],
    [50, "d3", 50, 50],
    [51, "d#3", 51, 51],
    [52, "e3", 52, 52],
    [53, "f3", 53, 53],
    [54, "f#3", 54, 54],
    [55, "g3", 55, 55],
    [56, "g#3", 56, 56],
    [57, "a3", 57, 57],
    [58, "a#3", 58, 58],
    [59, "b3", 59, 59],
    [60, "c4", 60, 60],
    [61, "c#4", 61, 61],
    [62, "d4", 62, 62],
    [63, "d#4", 63, 63],
    [64, "e4", 64, 65]
];
fn zones(art) = fold(
    roots,
    [],
    fn(a, r) =>
        a
        + map(range(8), fn(i) => {
            path: format("assets/standard-guitar/UI_Standard_Guitar/Samples/{}/{}_{}{}.flac", [
                art,
                r[1],
                art,
                i + 1
            ]),
            root: r[0],
            keys: [r[2], r[3]]
        })
);
// Callers that need a voice with different options must build it here rather
// than calling `sample()` on these zones themselves: `sample()` stamps the
// directory of the module that evaluates the call, so a caller-side call would
// resolve the recordings next to the caller instead of this pack.
// `voice("Sus_Down", {one_shot: false})` gives the mapped sustain with written
// note releases; options are passed through unchanged.
fn voice(art, options = {}) = sample(zones(art), options);
let instrument = kit("standard-guitar", {
    sustain: sample(zones("Sus_Down"), {
        one_shot: false,
        attack_ms: 1.5,
        release_ms: 95,
        velocity_track: 0.6,
        gain_db: 2
    }),
    mute: sample(zones("Mute_Down"), {
        one_shot: false,
        attack_ms: 1,
        release_ms: 55,
        velocity_track: 0.6,
        gain_db: 8
    })
});
