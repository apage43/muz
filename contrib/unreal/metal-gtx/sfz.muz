// Original SFZ programs. Install sfz-complete assets before use.
// Catalog IDs and paths are recorded in sfz-catalog.json.
fn program(path, options = {}) {
    let linked = merge({embed_assets: false}, options);
    assert(!linked.embed_assets, "Unreal publisher recordings cannot be embedded for redistribution; use linked assets");
    sfz(path, linked)
}

fn program_01_metal_gtx_full(options = {}) = program("assets/metal-gtx/UI_METAL-GTX/Programs/01-METAL-GTX Full.sfz", merge({sample_budget_frames: 479199232}, options));
