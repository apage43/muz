use "std/mix" as mix;
let theme = phrase("C5:e E5:e G5:q E5:q D5:q | C5:h r:h").tag("last", "echo");
let timing = {tempo: 120};
let lead = theme.repeat(2);
song({
    title: "Untitled",
    tempo: timing.tempo,
    sections: [section("opening", 4bars)],
    tracks: [track("lead", lead, synth("glass-lead"), {sends: {echo: -120}})],
    buses: [bus("echo", [fx("delay", {mix: 1, time_beats: 0.75, feedback: 0.3})])],
    automation: [mix.throws(lead, "echo", "lead.send.echo", -12, timing = timing)],
    master: mix.master(),
    tail: 3
})
